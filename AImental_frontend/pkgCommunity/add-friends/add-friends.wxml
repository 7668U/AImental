<view class="page">
  <view class="history-btn" bindtap="goToHistory">
    <image class="history-btn__icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/request-history.png" mode="aspectFit" />
    <view class="history-btn__text">历史申请</view>
  </view>
  
  <view class="main-content-wrapper">

    <block wx:if="{{!isEmpty}}">
      <swiper class="card-swiper" bindchange="onSwiperChange" current="{{currentIndex}}">
        <block wx:for="{{aiList}}" wx:key="id">
          <swiper-item class="card-swiper-item">
            
            <block wx:if="{{!item.isLocked}}">
              <view class="ai-card {{item.animationClass}}">
                <view class="ai-card__hero">
                  <image class="ai-card__avatar" src="{{serverUrl + item.avatar_url}}" mode="aspectFill" />
                  <view class="ai-card__intro">
                    <view class="ai-card__name">{{item.name}}</view>
                    <view class="ai-card__motto">“{{item.profile.personality_traits.philosophy}}”</view>
                  </view>
                </view>

                <view class="ai-card__body">
                  <view class="ai-card__tags">
                    <text class="tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
                  </view>
                  <view class="ai-card__info-block">
                    <view class="info-item">
                      <image class="info-item__icon-img" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/community-profile-mbti.png" mode="aspectFit"></image>
                      <text class="info-item__label">MBTI</text>
                      <text class="info-item__value">{{item.profile.personality_traits.mbti}}</text>
                    </view>
                    <view class="info-item">
                      <view class="info-item__icon info-item__icon--job"></view>
                      <text class="info-item__label">职业</text>
                      <text class="info-item__value">{{item.profile.identity_core.occupation}}</text>
                    </view>
                    <view class="info-item">
                      <view class="info-item__icon info-item__icon--home"></view>
                      <text class="info-item__label">家乡</text>
                      <text class="info-item__value">{{item.profile.background_story.hometown}}</text>
                    </view>
                  </view>
                </view>

                <view class="ai-card__footer">
                  <view class="add-btn-circular" bindtap="showVerificationModal" data-id="{{item.id}}" data-index="{{index}}" data-name="{{item.name}}">
                    <view class="add-btn__plus"></view>
                  </view>
                </view>
              </view>
            </block>
            
            <block wx:else>
              <view class="locked-card">
                <image class="locked-card__icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/lock-icon.png" mode="aspectFit" />
                <view class="locked-card__title">发现新伙伴</view>
                <view class="locked-card__text">分享给一位微信好友</view>
                <view class="locked-card__text">即可解锁全部新角色</view>
                <button class="locked-card__btn" open-type="share">
                  <image class="locked-card__btn-icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/wechat-share-icon.png" mode="aspectFit" />
                  <text>分享解锁</text>
                </button>
              </view>
            </block>
            
          </swiper-item>
        </block>
      </swiper>
    </block>
    
    <view class="bottom-hint-text">{{hintText}}</view>

  </view> <view class="modal-overlay {{isModalVisible ? 'visible' : ''}}" bindtap="onModalCancel">
    <view class="modal-content" catchtap> 
      <view class="modal-title">添加 {{modalCharacterName}} 为好友</view>
      <input 
        class="modal-input" 
        placeholder="发送一句问候吧~"
        value="{{verificationMessage}}"
        bindinput="onVerificationInput"
      />
      <view class="modal-actions">
        <button class="modal-button cancel" bindtap="onModalCancel">取消</button>
        <button class="modal-button confirm" bindtap="onModalConfirm">发送</button>
      </view>
    </view>
  </view>
</view>
