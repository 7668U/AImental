<view class="chat-page" style="padding-top: calc({{statusBarHeight}}px + 70rpx);">

<view class="custom-nav-bar">
  <image class="back-icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/left.png" bindtap="navigateBack"></image>
  <view class="nav-title-container">
    <view class="nav-title-line">
      <image class="nav-avatar" src="{{aiAvatar}}" mode="aspectFill" bindtap="showProfileCard"></image>
      <view class="nav-title">{{aiName}}</view>
    </view>
    <view class="nav-status typing-status" wx:if="{{isAiTyping}}">
      <text>对方正在输入</text>
      <text class="typing-dot dot-1">.</text>
      <text class="typing-dot dot-2">.</text>
      <text class="typing-dot dot-3">.</text>
    </view>
    <view class="nav-status" wx:elif="{{aiCurrentStatus}}">{{aiCurrentStatus}}</view>
  </view>
  <view class="nav-affinity" wx:if="{{hasAffinityContext}}">
    <image class="nav-affinity__heart" src="{{affinityHeartSrc}}" mode="aspectFit"></image>
    <text class="nav-affinity__score">{{affinityScoreText}}</text>
  </view>
</view>

<scroll-view 
  class="message-list" 
  scroll-y="true" 
  scroll-into-view="{{scrollToView}}"
  scroll-with-animation="true"
  enhanced="true" 
  show-scrollbar="false"
>
    <view class="message-item" wx:for="{{messageList}}" wx:key="id" id="msg-{{item.id}}">
    <view class="message-row ai" wx:if="{{item.role === 'ai'}}">
      <image class="avatar" src="{{aiAvatar}}" bindtap="showProfileCard"></image>
      <view class="bubble-wrapper">
        <view class="bubble">{{item.content}}</view>
        <view class="message-time-ai">{{item.time}}</view>
      </view>
    </view>
    
    <view class="message-row user" wx:if="{{item.role === 'user'}}">
      <view class="bubble-wrapper">
        <view class="bubble">{{item.content}}</view>
        <view class="message-time-user">{{item.time}}</view>
      </view>
      <image class="avatar" src="{{userAvatar}}"></image>
    </view>
  </view>
</scroll-view>

<view class="input-bar-wrapper">
  <view class="input-bar">
  <input 
    class="input-field" 
    value="{{inputValue}}" 
    bindinput="onInput" 
    placeholder="{{isMessageLimitReached ? '今天已经聊得够多啦~' : ''}}"
    disabled="{{isMessageLimitReached}}"
    maxlength="200"  ></input>
  
  <view 
    class="send-btn {{isSendDisabled ? 'disabled' : ''}}" 
    bindtap="sendMessage"
  >发送</view>
</view>
</view>

<view class="profile-overlay" wx:if="{{isProfileCardVisible}}" bindtap="hideProfileCard">
  <view class="profile-card" catchtap="noop">
    <view class="profile-card__hero">
      <image class="profile-card__avatar" src="{{aiAvatar}}" mode="aspectFill"></image>
      <view class="profile-card__intro">
        <view class="profile-card__name">{{aiName}}</view>
        <view class="profile-card__motto" wx:if="{{profileMotto}}">“{{profileMotto}}”</view>
      </view>
      <view class="profile-card__close" bindtap="hideProfileCard">×</view>
    </view>

    <view class="profile-card__tags" wx:if="{{profileTags.length}}">
      <text class="profile-card__tag" wx:for="{{profileTags}}" wx:key="*this">{{item}}</text>
    </view>

    <scroll-view class="profile-card__body" scroll-y="true">
      <view class="profile-card__row" wx:for="{{profileSections}}" wx:key="label">
        <view class="profile-card__label-wrap">
          <image wx:if="{{item.iconSrc}}" class="profile-card__icon-img" src="{{item.iconSrc}}" mode="aspectFit"></image>
          <view wx:else class="profile-card__icon profile-card__icon--{{item.iconKey}}"></view>
          <text class="profile-card__label">{{item.label}}</text>
        </view>
        <view class="profile-card__value">{{item.value}}</view>
      </view>
    </scroll-view>
  </view>
</view>

<custom-modal 
  show="{{showCustomModal}}" 
  title="{{modalTitle}}"
  content="{{modalContent}}"
  bind:confirm="onModalConfirm"
></custom-modal>

</view>
