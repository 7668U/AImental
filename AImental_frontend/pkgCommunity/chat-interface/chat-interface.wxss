/* pages/ai-community/chat-interface/chat-interface.wxss (终极修复版) */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F9F7F3; 
  box-sizing: border-box; 
}

.custom-nav-bar { flex-shrink: 0; display: flex; align-items: center; padding: 10rpx 20rpx; background-color: #F9F7F3; border-bottom: 1rpx solid #e0e0e0; }
.back-icon { width: 48rpx; height: 48rpx; padding: 10rpx; }
.nav-title-container { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.nav-title-line { display: flex; align-items: center; max-width: 100%; }
.nav-avatar { width: 44rpx; height: 44rpx; margin-right: 12rpx; border-radius: 8rpx; flex-shrink: 0; background-color: #eee; }
.nav-title { font-size: 34rpx; font-weight: 500; color: #000; }
.nav-status { font-size: 24rpx; color: #888; }
.nav-affinity {
  width: 124rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
}
.nav-affinity__heart {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 4rpx 8rpx rgba(199, 100, 94, 0.14));
}
.nav-affinity__score {
  min-width: 48rpx;
  margin-left: 6rpx;
  color: #b35d56;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  text-align: left;
  transform: translateY(6rpx);
}
.typing-status { display: flex; align-items: center; min-height: 34rpx; color: #9b7a4a; }
.typing-dot { display: inline-block; animation: typingDotPulse 1.2s ease-in-out infinite; }
.dot-2 { animation-delay: 0.16s; }
.dot-3 { animation-delay: 0.32s; }
.message-list { flex: 1; overflow-y: auto; box-sizing: border-box; padding: 0 0 0 0; }
.message-item { padding: 0 20rpx; margin-top: 30rpx; }
.message-row { display: flex; width: 100%; align-items: flex-start; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 10rpx; flex-shrink: 0; }
.bubble-wrapper { display: flex; flex-direction: column; }
.bubble { max-width: calc(100vw - 220rpx); padding: 20rpx; border-radius: 10rpx; font-size: 32rpx; line-height: 1.5; word-wrap: break-word; }
.message-time-ai, .message-time-user { font-size: 22rpx; color: #aaa; margin-top: 8rpx; }
.message-row.ai { justify-content: flex-start; }
.message-row.ai .avatar { margin-right: 20rpx; }
.message-row.ai .bubble { background-color: #ffffff; animation: aiBubbleIn 320ms cubic-bezier(0.2, 0.8, 0.2, 1); transform-origin: left bottom; }
.message-row.ai .message-time-ai { align-self: flex-start; }
.message-row.user { justify-content: flex-end; }
.message-row.user .avatar { margin-left: 20rpx; }
.message-row.user .bubble { background-color: #FFB643; animation: userBubbleIn 240ms ease-out; transform-origin: right bottom; }
.message-row.user .message-time-user { align-self: flex-end; }

@keyframes aiBubbleIn {
  from {
    opacity: 0;
    transform: translate3d(-16rpx, 14rpx, 0) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

@keyframes userBubbleIn {
  from {
    opacity: 0;
    transform: translate3d(12rpx, 10rpx, 0) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

@keyframes typingDotPulse {
  0%, 60%, 100% {
    opacity: 0.28;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(-2rpx);
  }
}


/* --- 【核心修改区域】底部输入栏 --- */
.input-bar-wrapper {
  flex-shrink: 0;
  background-color: #F1EEE9; 
  padding: 20rpx 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #ddd;
}
.input-bar { 
  display: flex; 
  align-items: center; 
  width: 100%; 
}
.input-field {
  flex: 1;
  background-color: #ffffff;
  height: 72rpx; 
  line-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
}
/* 【新增】输入框禁用时的样式 */
.input-field[disabled] {
  background-color: #f0f0f0; /* 变灰 */
  color: #a0a0a0;
}
/* 【核心修改】针对 <view> 标签的按钮样式 */
.send-btn {
  /* 在这里自由修改为您想要的宽度，现在它一定会生效 */
  width: 100rpx; 
  height: 72rpx;
  margin-left: 20rpx;
  background-color: #FFB643;
  color: white;
  font-size: 28rpx;
  border-radius: 10rpx;

  /* 新增：让文字在 view 中水平垂直居中 */
  display: flex;
  justify-content: center;
  align-items: center;
  
  /* 新增：防止内容被意外压缩 */
  flex-shrink: 0; 
}

/* 【核心修改】将 [disabled] 属性选择器改为 .disabled 类选择器 */
.send-btn.disabled { 
  background-color: #FFDDAA;
  color: #fff; 
}

.profile-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background-color: rgba(22, 21, 19, 0.54);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
  box-sizing: border-box;
}

.profile-card {
  width: 100%;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  padding: 44rpx 32rpx 34rpx;
  border-radius: 22rpx;
  background: #fffdf9;
  box-shadow: 0 26rpx 90rpx rgba(38, 33, 25, 0.28);
  box-sizing: border-box;
  border: 1rpx solid rgba(174, 145, 105, 0.12);
}

.profile-card__hero {
  position: relative;
  display: flex;
  align-items: flex-start;
  min-height: 178rpx;
  padding-right: 56rpx;
}

.profile-card__avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background-color: #eee;
  box-shadow: 0 8rpx 22rpx rgba(65, 54, 42, 0.12);
}

.profile-card__intro {
  flex: 1;
  min-width: 0;
  margin-left: 30rpx;
  padding-top: 20rpx;
}

.profile-card__name {
  font-family: "STKaiti", "KaiTi", "Songti SC", "SimSun", serif;
  font-size: 44rpx;
  font-weight: 700;
  color: #242424;
  line-height: 1.1;
  letter-spacing: 0;
}

.profile-card__close {
  position: absolute;
  right: 0;
  top: 0;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #555;
  font-size: 54rpx;
  font-weight: 300;
  line-height: 1;
}

.profile-card__motto {
  margin-top: 28rpx;
  color: #4d4d4d;
  font-family: "Times New Roman", "STKaiti", "KaiTi", "FangSong", "Songti SC", serif;
  font-size: 31rpx;
  line-height: 1.85;
  letter-spacing: 0;
}

.profile-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 12rpx;
  margin-top: 34rpx;
}

.profile-card__tag {
  min-height: 52rpx;
  padding: 10rpx 22rpx;
  border-radius: 14rpx;
  background-color: #eaf3ff;
  color: #3e4a55;
  font-family: "STKaiti", "KaiTi", "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.15;
  box-sizing: border-box;
}

.profile-card__tag:nth-child(2n) {
  background-color: #f1e9fb;
}

.profile-card__tag:nth-child(3n) {
  background-color: #fde7e0;
}

.profile-card__tag:nth-child(4n) {
  background-color: #fff1dc;
}

.profile-card__tag:nth-child(5n) {
  background-color: #e7f0df;
}

.profile-card__body {
  max-height: 48vh;
  margin-top: 30rpx;
}

.profile-card__row {
  display: flex;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(99, 80, 56, 0.13);
}

.profile-card__label-wrap {
  width: 188rpx;
  display: flex;
  align-items: flex-start;
  flex-shrink: 0;
  padding-right: 22rpx;
  box-sizing: border-box;
}

.profile-card__icon {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  margin-right: 18rpx;
  color: #a98e67;
  font-family: "Times New Roman", "Songti SC", serif;
  line-height: 1;
  text-align: center;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-card__icon-img {
  width: 56rpx;
  height: 56rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.profile-card__icon::before {
  display: block;
}

.profile-card__icon--speech::before {
  content: "";
  width: 36rpx;
  height: 28rpx;
  border: 4rpx solid #a98e67;
  border-radius: 50%;
  box-sizing: border-box;
}

.profile-card__icon--speech::after {
  content: "";
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  width: 11rpx;
  height: 11rpx;
  border-left: 4rpx solid #a98e67;
  border-bottom: 4rpx solid #a98e67;
  background-color: #fffdf9;
  transform: rotate(-18deg);
  box-sizing: border-box;
}

.profile-card__icon--home::before {
  content: "⌂";
  font-size: 48rpx;
  transform: translateY(-3rpx);
}

.profile-card__icon--book::before {
  content: "☷";
  font-size: 39rpx;
}

.profile-card__icon--like::before {
  content: "♡";
  font-size: 52rpx;
  transform: translateY(-4rpx);
}

.profile-card__icon--dislike::before {
  content: "⊘";
  font-size: 42rpx;
}

.profile-card__label {
  flex: 1;
  color: #222;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.profile-card__value {
  flex: 1;
  min-width: 0;
  color: #333;
  font-family: "Times New Roman", "STKaiti", "KaiTi", "FangSong", "Songti SC", serif;
  font-size: 29rpx;
  line-height: 1.72;
  word-break: break-word;
}

/* (不再需要 .send-btn::after 的修复代码，因为 view 没有这个伪元素) */
