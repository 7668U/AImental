/* pages/ai-community/chat-interface/chat-interface.wxss (终极修复版) */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F9F7F3; 
  box-sizing: border-box; 
}

.custom-nav-bar { flex-shrink: 0; display: flex; align-items: center; padding: 10rpx 20rpx; background-color: #F9F7F3; border-bottom: 1rpx solid #e0e0e0; }
.back-icon { width: 48rpx; height: 48rpx; padding: 10rpx; }
.nav-title-container { flex: 1; display: flex; flex-direction: column; align-items: center; margin-right: 68rpx; }
.nav-title-line { display: flex; align-items: center; max-width: 100%; }
.nav-avatar { width: 44rpx; height: 44rpx; margin-right: 12rpx; border-radius: 8rpx; flex-shrink: 0; background-color: #eee; }
.nav-title { font-size: 34rpx; font-weight: 500; color: #000; }
.nav-status { font-size: 24rpx; color: #888; }
.typing-status { display: flex; align-items: center; min-height: 34rpx; color: #9b7a4a; }
.typing-dot { display: inline-block; animation: typingDotPulse 1.2s ease-in-out infinite; }
.dot-2 { animation-delay: 0.16s; }
.dot-3 { animation-delay: 0.32s; }
.message-list { flex: 1; overflow-y: auto; box-sizing: border-box; padding: 0 0 0 0; }
.message-item { padding: 0 20rpx; margin-top: 30rpx; }
.message-row { display: flex; width: 100%; align-items: flex-start; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 10rpx; flex-shrink: 0; }
.bubble-wrapper { display: flex; flex-direction: column; }
.bubble { max-width: calc(100vw - 220rpx); padding: 20rpx; border-radius: 10rpx; font-size: 32rpx; line-height: 1.5; word-wrap: break-word; }
.message-time-ai, .message-time-user { font-size: 22rpx; color: #aaa; margin-top: 8rpx; }
.message-row.ai { justify-content: flex-start; }
.message-row.ai .avatar { margin-right: 20rpx; }
.message-row.ai .bubble { background-color: #ffffff; animation: aiBubbleIn 320ms cubic-bezier(0.2, 0.8, 0.2, 1); transform-origin: left bottom; }
.message-row.ai .message-time-ai { align-self: flex-start; }
.message-row.user { justify-content: flex-end; }
.message-row.user .avatar { margin-left: 20rpx; }
.message-row.user .bubble { background-color: #FFB643; animation: userBubbleIn 240ms ease-out; transform-origin: right bottom; }
.message-row.user .message-time-user { align-self: flex-end; }

@keyframes aiBubbleIn {
  from {
    opacity: 0;
    transform: translate3d(-16rpx, 14rpx, 0) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

@keyframes userBubbleIn {
  from {
    opacity: 0;
    transform: translate3d(12rpx, 10rpx, 0) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

@keyframes typingDotPulse {
  0%, 60%, 100% {
    opacity: 0.28;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(-2rpx);
  }
}


/* --- 【核心修改区域】底部输入栏 --- */
.input-bar-wrapper {
  flex-shrink: 0;
  background-color: #F1EEE9; 
  padding: 20rpx 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #ddd;
}
.input-bar { 
  display: flex; 
  align-items: center; 
  width: 100%; 
}
.input-field {
  flex: 1;
  background-color: #ffffff;
  height: 72rpx; 
  line-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
}
/* 【新增】输入框禁用时的样式 */
.input-field[disabled] {
  background-color: #f0f0f0; /* 变灰 */
  color: #a0a0a0;
}
/* 【核心修改】针对 <view> 标签的按钮样式 */
.send-btn {
  /* 在这里自由修改为您想要的宽度，现在它一定会生效 */
  width: 100rpx; 
  height: 72rpx;
  margin-left: 20rpx;
  background-color: #FFB643;
  color: white;
  font-size: 28rpx;
  border-radius: 10rpx;

  /* 新增：让文字在 view 中水平垂直居中 */
  display: flex;
  justify-content: center;
  align-items: center;
  
  /* 新增：防止内容被意外压缩 */
  flex-shrink: 0; 
}

/* 【核心修改】将 [disabled] 属性选择器改为 .disabled 类选择器 */
.send-btn.disabled { 
  background-color: #FFDDAA;
  color: #fff; 
}

.profile-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background-color: rgba(0, 0, 0, 0.36);
  box-sizing: border-box;
}

.profile-card {
  width: 100%;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  padding: 32rpx;
  border-radius: 16rpx;
  background-color: #fffaf2;
  box-shadow: 0 24rpx 80rpx rgba(60, 46, 20, 0.22);
  box-sizing: border-box;
}

.profile-card__header {
  display: flex;
  align-items: center;
  min-height: 112rpx;
}

.profile-card__avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background-color: #eee;
}

.profile-card__title-group {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.profile-card__name {
  font-size: 36rpx;
  font-weight: 600;
  color: #2f2415;
}

.profile-card__close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #7a6956;
  font-size: 42rpx;
  line-height: 1;
}

.profile-card__motto {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 12rpx;
  background-color: #f5ecd7;
  color: #5a4935;
  font-size: 28rpx;
  line-height: 1.55;
}

.profile-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.profile-card__tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background-color: #ffe4b5;
  color: #7a4f10;
  font-size: 24rpx;
}

.profile-card__body {
  max-height: 48vh;
  margin-top: 24rpx;
}

.profile-card__row {
  display: flex;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(122, 105, 86, 0.14);
}

.profile-card__label {
  width: 132rpx;
  flex-shrink: 0;
  color: #9b7a4a;
  font-size: 26rpx;
  line-height: 1.5;
}

.profile-card__value {
  flex: 1;
  min-width: 0;
  color: #35281b;
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-word;
}

/* (不再需要 .send-btn::after 的修复代码，因为 view 没有这个伪元素) */
