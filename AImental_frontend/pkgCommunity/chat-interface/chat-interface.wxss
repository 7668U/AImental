page {
  --chat-orange: #ff6b16;
  --chat-orange-deep: #e95b0c;
  --chat-peach: #ffd4a6;
  --chat-cream: #fff7ef;
  --chat-paper: #fffdfa;
  --chat-ink: #352d28;
  --chat-copy: #736963;
  --chat-muted: #a49b95;
  --chat-sage: #78906f;
  height: 100%;
  overflow: hidden;
  background: #fff7ef;
  color: var(--chat-ink);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.chat-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: linear-gradient(180deg, #fff4e9 0%, #faf7f2 48%, #f6f3ee 100%);
  box-sizing: border-box;
}

.custom-nav-bar {
  position: relative;
  z-index: 30;
  width: 100%;
  height: 96rpx;
  padding: 0 22rpx;
  flex-shrink: 0;
  border-bottom: 1rpx solid rgba(189, 139, 101, 0.12);
  background: rgba(255, 251, 247, 0.94);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.nav-action {
  width: 68rpx;
  height: 68rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-action:active {
  opacity: 0.62;
}

.back-icon {
  width: 42rpx;
  height: 42rpx;
}

.nav-person {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-avatar-wrap {
  position: relative;
  width: 66rpx;
  height: 66rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.nav-avatar {
  display: block;
  width: 66rpx;
  height: 66rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: #eee9e5;
  box-shadow: 0 6rpx 16rpx rgba(90, 59, 38, 0.11);
  box-sizing: border-box;
}

.nav-presence-dot {
  position: absolute;
  right: -1rpx;
  bottom: 2rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: #87a57d;
  box-sizing: border-box;
}

.nav-title-container {
  min-width: 0;
  max-width: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.nav-title {
  max-width: 100%;
  color: #3a302a;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.15;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0;
}

.nav-status {
  max-width: 100%;
  margin-top: 7rpx;
  color: #8e837c;
  font-size: 20rpx;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nav-typing-status {
  display: flex;
  align-items: center;
}

.nav-typing-dots {
  width: 30rpx;
  height: 12rpx;
  margin-left: 7rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.nav-typing-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #8e837c;
  animation: navTypingPulse 1.1s ease-in-out infinite;
}

.nav-typing-dot--2 {
  animation-delay: 140ms;
}

.nav-typing-dot--3 {
  animation-delay: 280ms;
}

.nav-affinity {
  width: 112rpx;
  height: 68rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.nav-affinity-heart {
  width: 50rpx;
  height: 50rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 5rpx 9rpx rgba(190, 91, 78, 0.14));
}

.nav-affinity-copy {
  min-width: 44rpx;
  margin-left: 2rpx;
  display: flex;
  align-items: baseline;
}

.nav-affinity-score {
  color: #a9534e;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.nav-affinity-unit {
  margin-left: 2rpx;
  color: #c37b74;
  font-size: 18rpx;
  font-weight: 700;
}

.message-area {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
  width: 100%;
  overflow: hidden;
  box-sizing: border-box;
}

.chat-center-bg {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 0;
  width: 560rpx;
  height: 560rpx;
  opacity: 0.7;
  pointer-events: none;
  transform: translate(-50%, -50%);
}

.message-list {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.message-list-inner {
  min-height: 100%;
  padding: 32rpx 24rpx 42rpx;
  box-sizing: border-box;
}

.message-item {
  width: 100%;
  margin-bottom: 30rpx;
}

.message-item-fade-in {
  animation: messageFadeIn 420ms ease-out both;
}

.message-row {
  width: 100%;
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
}

.message-row.ai {
  justify-content: flex-start;
}

.message-row.user {
  justify-content: flex-end;
}

.avatar {
  width: 70rpx;
  height: 70rpx;
  flex-shrink: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  background: #eee9e4;
  box-shadow: 0 6rpx 16rpx rgba(83, 59, 42, 0.08);
  box-sizing: border-box;
}

.message-row.ai .avatar {
  margin-right: 16rpx;
}

.message-row.user .avatar {
  margin-left: 16rpx;
}

.bubble-wrapper {
  min-width: 0;
  max-width: calc(100vw - 210rpx);
  display: flex;
  flex-direction: column;
}

.bubble {
  position: relative;
  max-width: 100%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  color: #39312c;
  font-size: 29rpx;
  line-height: 1.58;
  word-break: break-word;
  box-sizing: border-box;
}

.ai-bubble {
  border: 1rpx solid rgba(219, 195, 177, 0.42);
  border-top-left-radius: 7rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 26rpx rgba(87, 62, 44, 0.07);
}

.typing-bubble {
  width: 104rpx;
  height: 64rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(219, 195, 177, 0.42);
  border-radius: 20rpx;
  border-top-left-radius: 7rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 26rpx rgba(87, 62, 44, 0.07);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #a88f80;
  animation: typingPulse 1.1s ease-in-out infinite;
}

.typing-dot--2 {
  animation-delay: 140ms;
}

.typing-dot--3 {
  animation-delay: 280ms;
}

.user-bubble {
  border: 1rpx solid rgba(239, 170, 106, 0.55);
  border-top-right-radius: 7rpx;
  background: #ffd3a4;
  box-shadow: 0 10rpx 24rpx rgba(193, 112, 47, 0.1);
}

.message-meta {
  margin-top: 8rpx;
  color: #aaa19b;
  font-size: 20rpx;
  line-height: 1;
}

.message-meta-ai {
  align-self: flex-start;
  margin-left: 4rpx;
}

.message-meta-user {
  align-self: flex-end;
  margin-right: 4rpx;
}

.message-status-failed {
  color: #c65f57;
}

.message-send-failed {
  width: 36rpx;
  height: 36rpx;
  margin-top: 18rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #d8665e;
  box-shadow: 0 6rpx 14rpx rgba(196, 81, 72, 0.22);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 36rpx;
  text-align: center;
}

.message-send-failed:active {
  transform: scale(0.94);
}

.history-state,
.history-empty {
  min-height: 520rpx;
  padding: 90rpx 52rpx;
  color: #8e837c;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.history-loader {
  width: 54rpx;
  height: 54rpx;
  border: 5rpx solid rgba(255, 107, 22, 0.14);
  border-top-color: var(--chat-orange);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.history-state-title {
  margin-top: 24rpx;
  color: #4d4038;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
}

.history-state-text {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.history-error-mark {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: #fbe9e7;
  color: #c46159;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 82rpx;
}

.history-retry {
  min-width: 184rpx;
  height: 68rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--chat-orange);
  box-shadow: 0 10rpx 22rpx rgba(255, 107, 22, 0.2);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 68rpx;
  box-sizing: border-box;
}

.history-empty-illustration {
  width: 330rpx;
  height: 238rpx;
}

.history-empty-title {
  margin-top: 28rpx;
  color: #4b3d35;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.history-empty-note {
  max-width: 500rpx;
  margin-top: 14rpx;
  color: #978a82;
  font-size: 24rpx;
  line-height: 1.55;
}

.input-bar-wrapper {
  position: relative;
  z-index: 40;
  width: 100%;
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
  border-top: 1rpx solid rgba(193, 151, 119, 0.13);
  background: rgba(255, 252, 248, 0.96);
  box-shadow: 0 -10rpx 28rpx rgba(83, 58, 40, 0.05);
  box-sizing: border-box;
}

.input-bar {
  width: 100%;
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}

.emoji-toggle {
  width: 68rpx;
  height: 74rpx;
  flex-shrink: 0;
  border: 1rpx solid rgba(230, 198, 174, 0.72);
  border-radius: 50%;
  background: #fff7f0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.emoji-toggle-disabled {
  opacity: 0.42;
}

.emoji-face {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  border: 3rpx solid var(--chat-orange);
  border-radius: 50%;
  box-sizing: border-box;
}

.emoji-eye {
  position: absolute;
  top: 11rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: var(--chat-orange);
}

.emoji-eye-left {
  left: 9rpx;
}

.emoji-eye-right {
  right: 9rpx;
}

.emoji-mouth {
  position: absolute;
  left: 9rpx;
  top: 18rpx;
  width: 15rpx;
  height: 8rpx;
  border-bottom: 3rpx solid var(--chat-orange);
  border-radius: 0 0 15rpx 15rpx;
  box-sizing: border-box;
}

.input-shell {
  min-width: 0;
  min-height: 74rpx;
  max-height: 154rpx;
  padding: 14rpx 22rpx;
  flex: 1;
  border: 1rpx solid rgba(220, 196, 179, 0.84);
  border-radius: 28rpx;
  background: #ffffff;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
}

.input-shell-disabled {
  background: #f3f0ed;
}

.input-field {
  width: 100%;
  min-height: 44rpx;
  max-height: 126rpx;
  padding: 0;
  color: #36302c;
  font-size: 27rpx;
  line-height: 42rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.send-btn {
  width: 106rpx;
  height: 74rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: var(--chat-orange);
  box-shadow: 0 10rpx 22rpx rgba(255, 107, 22, 0.22);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 74rpx;
  text-align: center;
}

.send-btn.disabled {
  background: #edc5a8;
  box-shadow: none;
  color: rgba(255, 255, 255, 0.9);
}

.emoji-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(118rpx + env(safe-area-inset-bottom));
  z-index: 60;
  padding: 18rpx;
  border: 1rpx solid rgba(228, 199, 177, 0.78);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 18rpx 46rpx rgba(78, 52, 32, 0.13);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  row-gap: 12rpx;
  box-sizing: border-box;
}

.emoji-option {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  background: #fff7f0;
  font-size: 33rpx;
  line-height: 60rpx;
  text-align: center;
}

.emoji-option:active {
  background: #ffe8d5;
}

.profile-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  padding: 34rpx;
  background: rgba(36, 31, 27, 0.56);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.profile-card {
  width: 100%;
  max-height: 88vh;
  overflow: hidden;
  border: 1rpx solid rgba(255, 227, 207, 0.9);
  border-radius: 16rpx;
  background: #fffdfa;
  box-shadow: 0 30rpx 90rpx rgba(37, 28, 21, 0.28);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.profile-card-topbar {
  min-height: 96rpx;
  padding: 24rpx 28rpx 20rpx 34rpx;
  flex-shrink: 0;
  border-bottom: 1rpx solid rgba(183, 139, 104, 0.12);
  background: #fff4e9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.profile-card-kicker {
  color: #c07c4d;
  font-size: 17rpx;
  font-weight: 700;
  line-height: 1;
}

.profile-card-title {
  margin-top: 8rpx;
  color: #4a382e;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1;
}

.profile-card-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  color: #6e5e54;
  font-size: 46rpx;
  font-weight: 300;
  line-height: 54rpx;
  text-align: center;
}

.profile-card-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.profile-card-hero {
  min-height: 190rpx;
  padding: 32rpx 2rpx 26rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.profile-card-avatar-wrap {
  width: 154rpx;
  height: 154rpx;
  padding: 7rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: linear-gradient(145deg, #ffc493, #f2a480, #a9bda0);
  box-sizing: border-box;
}

.profile-card-avatar {
  display: block;
  width: 100%;
  height: 100%;
  border: 5rpx solid #fffdfa;
  border-radius: 50%;
  background: #eee9e5;
  box-sizing: border-box;
}

.profile-card-intro {
  min-width: 0;
  margin-left: 28rpx;
  flex: 1;
}

.profile-card-name {
  max-width: 100%;
  color: #342a24;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.15;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0;
}

.profile-card-identity {
  margin-top: 10rpx;
  color: #9a7660;
  font-size: 23rpx;
  line-height: 1.3;
}

.profile-card-motto {
  margin-top: 14rpx;
  color: #75655b;
  font-family: "STKaiti", "KaiTi", "Songti SC", serif;
  font-size: 25rpx;
  line-height: 1.52;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  word-break: break-word;
}

.profile-affinity {
  min-height: 138rpx;
  margin: 0 -32rpx;
  padding: 22rpx 34rpx;
  border-top: 1rpx solid rgba(226, 181, 149, 0.34);
  border-bottom: 1rpx solid rgba(174, 184, 164, 0.28);
  background: linear-gradient(135deg, #fff5eb 0%, #fffafb 60%, #f2f6ef 100%);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.profile-affinity-heart {
  width: 76rpx;
  height: 76rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 7rpx 12rpx rgba(185, 93, 80, 0.13));
}

.profile-affinity-main {
  min-width: 0;
  flex: 1;
}

.profile-affinity-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.profile-affinity-stage {
  color: #5d4b40;
  font-size: 27rpx;
  font-weight: 800;
}

.profile-affinity-score {
  color: #a9534e;
  font-size: 27rpx;
  font-weight: 800;
}

.profile-affinity-track {
  width: 100%;
  height: 7rpx;
  margin-top: 13rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(186, 157, 137, 0.2);
}

.profile-affinity-progress {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #f19b65, #dd7a70, #92a888);
}

.profile-affinity-note {
  margin-top: 12rpx;
  color: #81736a;
  font-size: 21rpx;
  line-height: 1.45;
}

.profile-card-tags {
  margin-top: 26rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.profile-card-tag {
  min-height: 48rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eaf3ff;
  color: #536271;
  font-size: 23rpx;
  line-height: 1.2;
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
}

.profile-card-tag:nth-child(2n) {
  background: #f1e9fb;
  color: #675b71;
}

.profile-card-tag:nth-child(3n) {
  background: #fde9e3;
  color: #775a53;
}

.profile-card-tag:nth-child(4n) {
  background: #edf4e9;
  color: #5c6d56;
}

.profile-card-tag:nth-child(5n) {
  background: #fff0dc;
  color: #785f45;
}

.profile-section-heading {
  margin-top: 34rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(155, 116, 87, 0.14);
  color: #4b3c33;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.2;
}

.profile-card-body {
  width: 100%;
}

.profile-card-row {
  min-height: 112rpx;
  padding: 23rpx 0;
  border-bottom: 1rpx solid rgba(155, 116, 87, 0.11);
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
}

.profile-card-icon-cell {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: #fff1e5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-card-icon {
  color: #b46b3d;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}

.profile-card-icon-img {
  width: 54rpx;
  height: 54rpx;
}

.profile-card-copy {
  min-width: 0;
  flex: 1;
}

.profile-card-label {
  color: #5a4b42;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.3;
}

.profile-card-value {
  margin-top: 8rpx;
  color: #766b64;
  font-size: 24rpx;
  line-height: 1.65;
  word-break: break-word;
}

.profile-card-empty {
  padding: 52rpx 20rpx 70rpx;
  color: #9b9089;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.profile-card-footer {
  padding: 20rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
  border-top: 1rpx solid rgba(174, 132, 101, 0.13);
  background: #fffdfa;
  box-sizing: border-box;
}

.profile-card-rewind-button {
  width: 100%;
  height: 76rpx;
  border: 1rpx solid rgba(198, 89, 78, 0.32);
  border-radius: 14rpx;
  background: #fff6f4;
  color: #bd5e55;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.profile-card-rewind-button:active {
  background: #fbe9e6;
}

.profile-card-rewind-button-disabled {
  opacity: 0.52;
}

.rewind-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-right: 13rpx;
  border: 3rpx solid #bd5e55;
  border-left-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
}

.rewind-icon::before {
  content: "";
  position: absolute;
  left: -5rpx;
  top: -2rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 3rpx solid #bd5e55;
  border-top: 3rpx solid #bd5e55;
  transform: rotate(-28deg);
  box-sizing: border-box;
}

.profile-card-rewind-note {
  margin-top: 10rpx;
  color: #a39187;
  font-size: 19rpx;
  line-height: 1.35;
  text-align: center;
}

@keyframes messageFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes typingPulse {
  0%,
  60%,
  100% {
    opacity: 0.38;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(-5rpx);
  }
}

@keyframes navTypingPulse {
  0%,
  60%,
  100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(-3rpx);
  }
}

/* Restore the user's original compact character profile card. */
.profile-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background-color: rgba(22, 21, 19, 0.54);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
  box-sizing: border-box;
}

.profile-card {
  width: 100%;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  padding: 44rpx 32rpx 34rpx;
  border: 1rpx solid rgba(174, 145, 105, 0.12);
  border-radius: 22rpx;
  background: #fffdf9;
  box-shadow: 0 26rpx 90rpx rgba(38, 33, 25, 0.28);
  box-sizing: border-box;
}

.profile-card__hero {
  position: relative;
  min-height: 160rpx;
  padding-right: 56rpx;
  display: flex;
  align-items: center;
}

.profile-card__avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background-color: #eee;
  box-shadow: 0 8rpx 22rpx rgba(65, 54, 42, 0.12);
}

.profile-card__intro {
  min-width: 0;
  min-height: 160rpx;
  margin-left: 30rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.profile-card__name {
  color: #242424;
  font-family: "STKaiti", "KaiTi", "Songti SC", "SimSun", serif;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: 0;
}

.profile-card__close {
  position: absolute;
  right: 0;
  top: 0;
  width: 60rpx;
  height: 60rpx;
  color: #555;
  font-size: 54rpx;
  font-weight: 300;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-card__motto {
  margin-top: 16rpx;
  color: #4d4d4d;
  font-family: "Times New Roman", "STKaiti", "KaiTi", "FangSong", "Songti SC", serif;
  font-size: 26rpx;
  line-height: 1.5;
  letter-spacing: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word;
}

.profile-card__tags {
  margin-top: 34rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 14rpx 12rpx;
}

.profile-card__tag {
  min-height: 52rpx;
  padding: 10rpx 22rpx;
  border-radius: 14rpx;
  background-color: #eaf3ff;
  color: #3e4a55;
  font-family: "STKaiti", "KaiTi", "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.15;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.profile-card__tag:nth-child(2n) {
  background-color: #f1e9fb;
}

.profile-card__tag:nth-child(3n) {
  background-color: #fde7e0;
}

.profile-card__tag:nth-child(4n) {
  background-color: #fff1dc;
}

.profile-card__tag:nth-child(5n) {
  background-color: #e7f0df;
}

.profile-card__body {
  flex: 1;
  min-height: 0;
  max-height: 48vh;
  margin-top: 30rpx;
  padding-right: 18rpx;
  font-family: "SimHei", "Heiti SC", "Microsoft YaHei", "PingFang SC", sans-serif;
  box-sizing: border-box;
}

.profile-card__row {
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(99, 80, 56, 0.13);
  display: grid;
  grid-template-columns: 66rpx 140rpx minmax(0, 1fr);
  column-gap: 14rpx;
  align-items: start;
}

.profile-card__row--mbti {
  align-items: center;
}

.profile-card__row--mbti .profile-card__label {
  padding-top: 0;
}

.profile-card__row--mbti .profile-card__value {
  min-height: 66rpx;
  line-height: 1.2;
  display: flex;
  align-items: center;
}

.profile-card__icon-cell {
  width: 66rpx;
  min-height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.profile-card__icon {
  position: relative;
  width: 50rpx;
  height: 50rpx;
  color: #a98e67;
  font-family: "Times New Roman", "Songti SC", serif;
  line-height: 1;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-card__icon-img {
  width: 66rpx;
  height: 66rpx;
  display: block;
}

.profile-card__icon::before {
  display: block;
}

.profile-card__icon--home::before {
  content: "⌂";
  font-size: 48rpx;
  transform: translateY(-3rpx);
}

.profile-card__icon--book::before {
  content: "☷";
  font-size: 39rpx;
}

.profile-card__icon--like::before {
  content: "♡";
  font-size: 52rpx;
  transform: translateY(-4rpx);
}

.profile-card__label {
  padding-top: 2rpx;
  color: #222;
  font-family: "SimHei", "Heiti SC", "Microsoft YaHei", "PingFang SC", sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  text-align: left;
  white-space: nowrap;
}

.profile-card__value {
  min-width: 0;
  color: #333;
  font-family: "SimHei", "Heiti SC", "Microsoft YaHei", "PingFang SC", sans-serif;
  font-size: 29rpx;
  line-height: 1.72;
  text-align: left;
  word-break: break-word;
}

.profile-card__rewind-button {
  min-height: 78rpx;
  margin-top: 26rpx;
  border: 1rpx solid rgba(201, 79, 69, 0.34);
  border-radius: 16rpx;
  background-color: #fff7f5;
  color: #c94f45;
  font-family: "SimHei", "Heiti SC", "Microsoft YaHei", "PingFang SC", sans-serif;
  font-size: 29rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.profile-card__rewind-button:active {
  background-color: #fbe9e6;
}

.profile-card__rewind-button--disabled {
  opacity: 0.56;
}
