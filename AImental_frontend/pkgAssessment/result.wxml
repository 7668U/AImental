<view class="container">
  <image class="result-bg" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/pkgAssessment/images/result/result-bg.png" mode="aspectFill"></image>
  <view class="result-bg-soften"></view>

  <view wx:if="{{isLoading}}" class="loading-container">
    <text>正在生成您的专属报告...</text>
  </view>

  <block wx:else>

    <block wx:if="{{isSoulDrinkResult}}">
      <view class="soul-drink-result-shell">
        <image
          wx:if="{{soulDrinkResultCardUrl}}"
          class="soul-drink-result-image"
          src="{{soulDrinkResultCardUrl}}"
          mode="widthFix"
          show-menu-by-longpress="{{true}}"
        />
        <view wx:else class="result-card ai-empty-card">
          <view class="card-title">
            <image class="card-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/icons/icon-report.png"></image>
            <text>结果图加载失败</text>
          </view>
          <view class="card-content">本次结果已生成，但暂时没有找到对应的结果图。</view>
        </view>
      </view>
    </block>

    <block wx:elif="{{result.scale_details.assessment_type === 'scoring'}}">
      <view class="result-card summary-card">
        <view class="score-display">
          <text class="score-value">{{result.final_score}}</text>
          <text class="score-total">/ {{totalScore}}</text>
        </view>
        <view class="result-level">{{result.result_level}}</view>
      </view>

      <view class="score-bar-wrapper">
        <view class="score-bar-container">
          <view class="score-bar-segments"></view>
          
          <view class="score-pointer" style="left: {{pointerPosition}}%;">
            <view class="pointer-label align-{{pointerLabelAlign}}">您的位置</view>
            <view class="pointer-dot"></view>
          </view>
          
          <view class="score-markers-container">
            <view wx:for="{{scoreMarkers}}" wx:key="score" class="score-marker-wrapper" style="left: {{item.position}}%;">
              <view class="score-marker">
                <view class="marker-line"></view>
                <text class="marker-text">{{item.score}}</text>
              </view>
            </view>
          </view>
        </view>
        
        <view class="segment-labels-container">
  <view wx:for="{{scoreSegments}}" wx:key="level" class="label-wrapper" style="left: {{item.left}}%; width: {{item.width}}%;">
    <text class="label-text">{{item.level}}</text>
  </view>
</view>
      </view>
    </block>

    <block wx:elif="{{result.scale_details.assessment_type === 'categorical'}}">
      <view class="result-card personality-card" wx:if="{{!fortuneReport}}">
        <view class="personality-image-container" wx:if="{{result.result_details.image_url}}">
          <image class="personality-image" src="{{result.result_details.image_url}}" mode="aspectFit" />
        </view>
        <view class="personality-major">{{result.result_level}}</view>
        
        <view class="personality-college" wx:if="{{result.result_details.college}}">
          {{result.result_details.college}}
        </view>
        
        <view class="personality-motto" wx:if="{{result.result_details.college_motto}}">
          “{{result.result_details.college_motto}}”
        </view>

        <view class="career-teaser" wx:if="{{result.result_details.career_teaser}}">
          {{result.result_details.career_teaser}}
        </view>
      </view>

      <block wx:if="{{talentRadarReport}}">
        <view class="result-card talent-hero-card">
          <view class="talent-badge">显性天赋</view>
          <view class="talent-hero-title">{{talentRadarReport.primaryTitle}}</view>
          <view class="talent-hero-tagline" wx:if="{{talentRadarReport.primaryTagline}}">{{talentRadarReport.primaryTagline}}</view>
          <view class="talent-hero-text" wx:if="{{talentRadarReport.primarySummary}}">{{talentRadarReport.primarySummary}}</view>
        </view>

        <view class="result-card detail-card" wx:if="{{talentRadarReport.radarSummary || talentRadarReport.pairSummary || talentRadarReport.primaryBestScene || talentRadarReport.primaryGrowthFocus}}">
          <view class="card-title">
            <image class="card-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/icons/icon-report.png"></image>
            <text>你的雷达主线</text>
          </view>
          <view class="analysis-list">
            <view class="analysis-list-item" wx:if="{{talentRadarReport.radarSummary}}">
              <text class="list-dot"></text>
              <text class="list-text">{{talentRadarReport.radarSummary}}</text>
            </view>
            <view class="analysis-list-item" wx:if="{{talentRadarReport.pairSummary}}">
              <text class="list-dot"></text>
              <text class="list-text">{{talentRadarReport.pairSummary}}</text>
            </view>
            <view class="analysis-list-item" wx:if="{{talentRadarReport.primaryBestScene}}">
              <text class="list-dot"></text>
              <text class="list-text">容易发光的场景：{{talentRadarReport.primaryBestScene}}</text>
            </view>
            <view class="analysis-list-item" wx:if="{{talentRadarReport.primaryGrowthFocus}}">
              <text class="list-dot"></text>
              <text class="list-text">接下来可以练：{{talentRadarReport.primaryGrowthFocus}}</text>
            </view>
          </view>
        </view>

        <view class="result-card dual-talent-card" wx:if="{{talentRadarReport.secondaryTitle || talentRadarReport.latentTitle}}">
          <view class="dual-talent-grid">
            <view class="dual-talent-panel" wx:if="{{talentRadarReport.secondaryTitle}}">
              <view class="dual-talent-badge">辅助天赋</view>
              <view class="dual-talent-title">{{talentRadarReport.secondaryTitle}}</view>
              <view class="dual-talent-tagline" wx:if="{{talentRadarReport.secondaryTagline}}">{{talentRadarReport.secondaryTagline}}</view>
              <view class="dual-talent-text" wx:if="{{talentRadarReport.secondaryDescription}}">{{talentRadarReport.secondaryDescription}}</view>
            </view>

            <view class="dual-talent-panel" wx:if="{{talentRadarReport.latentTitle}}">
              <view class="dual-talent-badge latent-badge">潜伏潜能</view>
              <view class="dual-talent-title">{{talentRadarReport.latentTitle}}</view>
              <view class="dual-talent-tagline" wx:if="{{talentRadarReport.latentTagline}}">{{talentRadarReport.latentTagline}}</view>
              <view class="dual-talent-text" wx:if="{{talentRadarReport.latentBridge}}">{{talentRadarReport.latentBridge}}</view>
              <view class="dual-talent-text" wx:if="{{talentRadarReport.latentSummary}}">{{talentRadarReport.latentSummary}}</view>
              <view class="dual-talent-text" wx:if="{{talentRadarReport.latentDescription}}">{{talentRadarReport.latentDescription}}</view>
            </view>
          </view>
        </view>

        <view class="result-card detail-card" wx:if="{{talentRadarReport.stressTitle || talentRadarReport.stressSummary}}">
          <view class="card-title">
            <image class="card-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/icons/icon-report.png"></image>
            <text>压力下的底牌</text>
          </view>
          <view class="analysis-list">
            <view class="analysis-list-item" wx:if="{{talentRadarReport.stressTitle}}">
              <text class="list-dot"></text>
              <text class="list-text">你最容易本能启动的是：{{talentRadarReport.stressTitle}}</text>
            </view>
            <view class="analysis-list-item" wx:if="{{talentRadarReport.stressSummary}}">
              <text class="list-dot"></text>
              <text class="list-text">{{talentRadarReport.stressSummary}}</text>
            </view>
          </view>
        </view>

        <view class="result-card detail-card" wx:if="{{talentRadarReport.scoreItems.length > 0}}">
          <view class="card-title">
            <image class="card-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/icons/icon-report.png"></image>
            <text>八维天赋分布</text>
          </view>
          <view class="detail-pair-list">
            <view class="detail-pair-item" wx:for="{{talentRadarReport.scoreItems}}" wx:key="label">
              <text class="detail-pair-label">{{item.label}}</text>
              <text class="detail-pair-value">{{item.value}} 题 · {{item.ratio}}%</text>
            </view>
          </view>
        </view>
      </block>

      <block wx:if="{{fortuneReport}}">
        <view class="result-card fortune-hero-card">
          <view class="fortune-orbit">
            <view class="fortune-orbit-inner"></view>
          </view>
          <view class="fortune-kicker">近期好运签</view>
          <view class="fortune-title">{{fortuneReport.title}}</view>
          <view class="fortune-keyword" wx:if="{{fortuneReport.keyword}}">关键词：{{fortuneReport.keyword}}</view>
          <view class="fortune-anchor" wx:if="{{fortuneReport.emotionalAnchor}}">{{fortuneReport.emotionalAnchor}}</view>
        </view>

        <view class="result-card fortune-note-card" wx:if="{{fortuneReport.interpretation}}">
          <view class="fortune-note-title">这张签在说</view>
          <view class="fortune-note-text">{{fortuneReport.interpretation}}</view>
        </view>

        <view class="result-card fortune-grid-card">
          <view class="fortune-grid">
            <view class="fortune-grid-item" wx:if="{{fortuneReport.window}}">
              <view class="fortune-grid-label">好运窗口</view>
              <view class="fortune-grid-value">{{fortuneReport.window}}</view>
            </view>
            <view class="fortune-grid-item" wx:if="{{fortuneReport.luckyColor}}">
              <view class="fortune-grid-label">幸运色</view>
              <view class="fortune-grid-value">{{fortuneReport.luckyColor}}</view>
            </view>
            <view class="fortune-grid-item" wx:if="{{fortuneReport.luckyAction}}">
              <view class="fortune-grid-label">开运小事</view>
              <view class="fortune-grid-value">{{fortuneReport.luckyAction}}</view>
            </view>
            <view class="fortune-grid-item" wx:if="{{fortuneReport.luckyPhrase}}">
              <view class="fortune-grid-label">今日暗号</view>
              <view class="fortune-grid-value">{{fortuneReport.luckyPhrase}}</view>
            </view>
          </view>
        </view>

        <view class="result-card detail-card" wx:if="{{fortuneReport.recommendation || fortuneReport.relationship || fortuneReport.stress || fortuneReport.change}}">
          <view class="card-title">
            <image class="card-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/icons/icon-report.png"></image>
            <text>接住这波好运</text>
          </view>
          <view class="analysis-list">
            <view class="analysis-list-item" wx:if="{{fortuneReport.recommendation}}">
              <text class="list-dot"></text>
              <text class="list-text">{{fortuneReport.recommendation}}</text>
            </view>
            <view class="analysis-list-item" wx:if="{{fortuneReport.relationship}}">
              <text class="list-dot"></text>
              <text class="list-text">关系里：{{fortuneReport.relationship}}</text>
            </view>
            <view class="analysis-list-item" wx:if="{{fortuneReport.stress}}">
              <text class="list-dot"></text>
              <text class="list-text">压力时：{{fortuneReport.stress}}</text>
            </view>
            <view class="analysis-list-item" wx:if="{{fortuneReport.change}}">
              <text class="list-dot"></text>
              <text class="list-text">变化前：{{fortuneReport.change}}</text>
            </view>
          </view>
        </view>
      </block>

      <view class="result-card sub-profile-card" wx:if="{{secondaryProfile && !talentRadarReport && !fortuneReport}}">
        <view class="sub-profile-badge">副潜意识原型</view>
        <view class="sub-profile-title">{{secondaryProfile.title}}</view>
        <view class="sub-profile-text" wx:if="{{secondaryProfile.description}}">{{secondaryProfile.description}}</view>
      </view>

      <view class="result-card detail-card" wx:if="{{!talentRadarReport && !fortuneReport && (result.result_details.in_relationships || result.result_details.under_stress || result.result_details.facing_change)}}">
        <view class="card-title">
          <image class="card-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/icons/icon-report.png"></image>
          <text>你的潜意识画像</text>
        </view>
        <view class="analysis-list">
          <view class="analysis-list-item" wx:if="{{result.result_details.in_relationships}}">
            <text class="list-dot"></text>
            <text class="list-text">关系中：{{result.result_details.in_relationships}}</text>
          </view>
          <view class="analysis-list-item" wx:if="{{result.result_details.under_stress}}">
            <text class="list-dot"></text>
            <text class="list-text">压力下：{{result.result_details.under_stress}}</text>
          </view>
          <view class="analysis-list-item" wx:if="{{result.result_details.facing_change}}">
            <text class="list-dot"></text>
            <text class="list-text">面对变化时：{{result.result_details.facing_change}}</text>
          </view>
        </view>
      </view>

      <view class="result-card detail-card" wx:if="{{secondaryProfile && !talentRadarReport && !fortuneReport && (secondaryProfile.inRelationships || secondaryProfile.underStress || secondaryProfile.facingChange)}}">
        <view class="card-title">
          <image class="card-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/icons/icon-report.png"></image>
          <text>副原型会在哪出现</text>
        </view>
        <view class="analysis-list">
          <view class="analysis-list-item" wx:if="{{secondaryProfile.inRelationships}}">
            <text class="list-dot"></text>
            <text class="list-text">关系里：{{secondaryProfile.inRelationships}}</text>
          </view>
          <view class="analysis-list-item" wx:if="{{secondaryProfile.underStress}}">
            <text class="list-dot"></text>
            <text class="list-text">压力时：{{secondaryProfile.underStress}}</text>
          </view>
          <view class="analysis-list-item" wx:if="{{secondaryProfile.facingChange}}">
            <text class="list-dot"></text>
            <text class="list-text">变化前：{{secondaryProfile.facingChange}}</text>
          </view>
        </view>
      </view>

      <view class="result-card career-hero-card" wx:if="{{primaryCareer && !talentRadarReport && !fortuneReport}}">
        <view class="career-hero-badge">职业盲盒主线</view>
        <view class="career-hero-title">{{primaryCareer.title}}</view>
        <view class="career-hero-en" wx:if="{{primaryCareer.title_en}}">{{primaryCareer.title_en}}</view>
        <view class="career-hero-tag" wx:if="{{primaryCareer.fun_tag}}">{{primaryCareer.fun_tag}}</view>
        <view class="career-hero-text" wx:if="{{primaryCareer.why_match}}">{{primaryCareer.why_match}}</view>
      </view>

      <view class="result-card career-list-card" wx:if="{{recommendedCareers.length > 0 && !talentRadarReport && !fortuneReport}}">
        <view class="card-title">
          <image class="card-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/icons/icon-report.png"></image>
          <text>更多适合你的职业</text>
        </view>
        <view class="career-list">
          <view class="career-item" wx:for="{{recommendedCareers}}" wx:key="title">
            <view class="career-item-head">
              <text class="career-item-title">{{item.title}}</text>
              <text class="career-item-tag" wx:if="{{item.fun_tag}}">{{item.fun_tag}}</text>
            </view>
            <view class="career-item-en" wx:if="{{item.title_en}}">{{item.title_en}}</view>
            <view class="career-item-text" wx:if="{{item.why_match}}">{{item.why_match}}</view>
          </view>
        </view>
      </view>
    </block>

    <block wx:for="{{analysisBlocks}}" wx:for-item="analysisBlock" wx:key="key">
      <view class="result-card ai-card" wx:if="{{!isSoulDrinkResult && analysisBlock.sections.length > 0}}">
        <view class="card-title">
          <image class="card-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/icons/icon-report.png"></image>
          <text>{{analysisBlock.title}}</text>
        </view>

        <view
          class="ai-section {{section.type === 'risk' ? 'risk-section' : ''}} {{section.bgIcon ? 'has-section-icon' : ''}}"
          wx:for="{{analysisBlock.sections}}"
          wx:for-item="section"
          wx:key="key"
        >
          <image wx:if="{{section.bgIcon}}" class="section-bg-icon section-bg-{{section.key}}" src="{{section.bgIcon}}" mode="aspectFit"></image>
          <view class="ai-section-body">
            <view class="ai-section-title">{{section.title}}</view>

            <view wx:if="{{section.type === 'text' || section.type === 'risk' || section.type === 'support' || section.type === 'recording'}}" class="ai-section-text">
              {{section.text}}
            </view>

            <view wx:if="{{section.type === 'recording' && section.focusText}}" class="focus-line">
              重点观察：{{section.focusText}}
            </view>

            <view wx:if="{{section.type === 'dimensions'}}" class="dimension-list">
              <view class="dimension-item" wx:for="{{section.dimensions}}" wx:for-item="dimension" wx:key="key">
                <view class="dimension-heading">
                  <text class="dimension-label">{{dimension.label}}</text>
                  <text class="dimension-level">{{dimension.level}}</text>
                </view>
                <view class="dimension-summary">{{dimension.summary}}</view>
                <view class="dimension-evidence" wx:if="{{dimension.evidenceText}}">
                  相关表现：{{dimension.evidenceText}}
                </view>
              </view>
            </view>

            <view wx:if="{{section.type === 'details' && section.detailItems.length > 0}}" class="detail-pair-list">
              <view class="detail-pair-item" wx:for="{{section.detailItems}}" wx:for-item="detail" wx:key="label">
                <text class="detail-pair-label">{{detail.label}}</text>
                <text class="detail-pair-value">{{detail.value}}</text>
              </view>
            </view>

            <view wx:if="{{section.type === 'list'}}" class="analysis-list">
              <view class="analysis-list-item" wx:for="{{section.list}}" wx:for-item="line" wx:key="*this">
                <text class="list-dot"></text>
                <text class="list-text">{{line}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="ai-analysis-entry" wx:if="{{!isSoulDrinkResult && canGenerateAiAnalysis && !aiAnalysisLoaded}}">
      <button
        class="confirm-btn ai-analysis-btn"
        bindtap="handleGenerateAiAnalysis"
        loading="{{isAiAnalysisLoading}}"
        disabled="{{isAiAnalysisLoading}}"
      >
        <image
          wx:if="{{!isAiAnalysisLoading}}"
          class="ai-analysis-btn-icon"
          src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/pkgDailyCheckin/images/analysis/robot.png"
          mode="aspectFit"
        ></image>
        <text>AI深度分析</text>
      </button>
    </view>

    <button class="confirm-btn" bindtap="handleConfirm">我知道了</button>

  </block>
</view>
