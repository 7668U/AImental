}

.detail-pair-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #5f5147;
}

.detail-pair-value {
  flex-shrink: 0;
  min-width: 72rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 700;
  color: #F97316;
}

/* --- 底部确认按钮 --- */
.confirm-btn {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 96rpx;
  background-color: #F97316; /* 主题橙色 */
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  margin-top: 20rpx;
  border: none;
  box-shadow: 0 8rpx 16rpx rgba(249, 115, 22, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
}
.confirm-btn:active {
  background-color: #DD6B20; /* 按下时的深橙色 */
}
