/* ✅ 请添加这些新的样式 */
.score-bar-container {
  position: relative;
  width: 100%;
  height: 40rpx;
  /* 调整外边距，给下方的刻度尺和文字留出呼吸空间 */
  margin-bottom: 10rpx; 
}

/* 文字标签的总容器 */
.segment-labels-container {
  margin-top: 45rpx; /* 这个值确保标签容器被推到刻度尺的下方，避免重叠 */
  position: relative; /* 关键！为内部的标签提供定位的基准 */
  width: 100%;
  min-height: 50rpx; /* 防止容器高度塌陷 */
}

/* 每个标签的“包装盒” */
.label-wrapper {
  position: absolute; /* 关键！让每个标签都可以被精确定位 */
  top: 0;
  display: flex; /* 使用 Flex 布局来让内部的文字居中 */
  justify-content: center;
  padding: 0 4rpx; /* 防止文字紧贴边缘 */
  box-sizing: border-box;
}

/* 最终的文字样式 */
.label-text {
  font-size: 22rpx;
  color: #666;
  text-align: center;   /* 文字本身居中对齐 */
  white-space: normal;  /* 允许文字换行 */
  word-break: break-all;/* 超长单词强制换行 */
  line-height: 1.3;     /* 调整行高，让换行后的文字更美观 */
}
