/* ✅ 请添加这些新的样式 */
.score-bar-container {
  position: relative;
  width: 100%;
  height: 40rpx;
  /* 调整外边距，给下方的刻度尺和文字留出呼吸空间 */
  margin-bottom: 10rpx; 
}

/* 文字标签的总容器 */
.segment-labels-container {
  margin-top: 45rpx; /* 这个值确保标签容器被推到刻度尺的下方，避免重叠 */
  position: relative; /* 关键！为内部的标签提供定位的基准 */
  width: 100%;
  min-height: 50rpx; /* 防止容器高度塌陷 */
}

/* 每个标签的“包装盒” */
.label-wrapper {
  position: absolute; /* 关键！让每个标签都可以被精确定位 */
  top: 0;
  display: flex; /* 使用 Flex 布局来让内部的文字居中 */
  justify-content: center;
  padding: 0 4rpx; /* 防止文字紧贴边缘 */
  box-sizing: border-box;
}

/* 最终的文字样式 */
.label-text {
  font-size: 22rpx;
  color: #666;
  text-align: center;   /* 文字本身居中对齐 */
  white-space: normal;  /* 允许文字换行 */
  word-break: break-all;/* 超长单词强制换行 */
  line-height: 1.3;     /* 调整行高，让换行后的文字更美观 */
}
/* --- 2. 分类测试专属样式 --- */
.personality-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.personality-image-container {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.1);
  background-color: #eee;
}
.personality-image {
  width: 100%;
  height: 100%;
}
.personality-major {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}
.personality-college {
  font-size: 30rpx;
  color: #666;
  margin-top: 10rpx;
}
.personality-motto {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
  font-style: italic;
}

/* --- 3. 通用详情卡片 --- */
.detail-card {
  padding: 30rpx 40rpx;
}
.card-title {
  display: flex;
  align-items: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eeeeee;
  margin-bottom: 30rpx;
}
.card-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}
.card-content {
  font-size: 30rpx;
  line-height: 1.8;
  color: #555555;
  white-space: pre-wrap;
}

/* --- 底部确认按钮 --- */
.confirm-btn {
  width: 100%;
  height: 96rpx;
  background-color: #F97316; /* 主题橙色 */
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  margin-top: 20rpx;
  border: none;
  box-shadow: 0 8rpx 16rpx rgba(249, 115, 22, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
}
.confirm-btn:active {
  background-color: #DD6B20; /* 按下时的深橙色 */
}