/* pages/assessment/result/result.wxss (最终版) */
page {
  min-height: 100%;
  background-color: #fff7ed;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  height: auto;
  min-height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

.soul-drink-result-shell {
  position: relative;
  z-index: 1;
  width: 100%;
  margin-bottom: 28rpx;
}

.soul-drink-result-image {
  display: block;
  width: 100%;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 44rpx rgba(199, 132, 76, 0.12);
}

.result-bg {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  pointer-events: none;
}

.result-bg-soften {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  pointer-events: none;
  background: rgba(255, 250, 244, 0.18);
}

.loading-container {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
  color: #9a7d66;
}

/* --- 通用卡片样式 --- */
.result-card {
  position: relative;
  z-index: 1;
  background-color: rgba(255, 255, 255, 0.88);
  border-radius: 24rpx;
  width: 100%;
  border: 1rpx solid rgba(255, 224, 197, 0.78);
  box-shadow: 0 18rpx 44rpx rgba(199, 132, 76, 0.1);
  margin-bottom: 40rpx;
  padding: 40rpx;
  box-sizing: border-box;
  backdrop-filter: blur(8rpx);
}

/* --- 1. 打分测试专属样式 --- */
.summary-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #333;
}
.score-display {
  display: flex;
  align-items: baseline;
  color: #F97316; /* 主题橙色 */
}
.score-value {
  font-size: 100rpx;
  font-weight: bold;
  line-height: 1;
}
.score-total {
  font-size: 36rpx;
  font-weight: 500;
  color: #999;
  margin-left: 10rpx;
}
.result-level {
  font-size: 44rpx;
  font-weight: bold;
  margin-top: 20rpx;
  color: #333333;
}

.score-bar-wrapper {
  position: relative;
  z-index: 1;
  width: 100%;
  margin-bottom: 40rpx;
}
.score-bar-container {
  position: relative;
  width: 100%;
  height: 40rpx;
  /* 增加底部外边距，为两行文字留足空间 */
  margin-bottom: 60rpx; 
}
.score-bar-segments {
  display: flex;
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(to right, #FFF7ED, #FDBA74, #F97316);
}

.score-pointer {
  position: absolute;
  top: 50%;
  width: 1px;
  height: 100%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
}
.pointer-dot {
  width: 24rpx;
  height: 24rpx;
  background-color: #fff;
  border: 6rpx solid #F97316;
  border-radius: 50%;
  box-shadow: 0 0 10rpx rgba(0,0,0,0.2);
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.pointer-label {
  position: absolute;
  top: -60rpx;
  background-color: #333;
  color: #fff;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}
.pointer-label.align-center {
  left: 50%;
  transform: translateX(-50%);
}
.pointer-label.align-left {
  right: 15rpx;
  transform: none;
}
.pointer-label.align-right {
  left: 15rpx;
  transform: none;
}

/* ✅ 【分两行显示的核心样式】 */
.score-markers-container {
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  height: 40rpx;
}

.score-marker-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: absolute;
  transform: translateX(-50%);
}

.score-marker {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.marker-line {
  width: 2rpx;
  height: 10rpx;
  background-color: #cccccc;
  margin-bottom: 4rpx; /* 标记线和文字之间增加一些间距 */
}
.marker-text {
  font-size: 22rpx;
  color: #999999;
  white-space: nowrap; /* 确保文字不换行 */
}

