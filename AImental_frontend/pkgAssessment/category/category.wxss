page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 85% 8%, rgba(255, 214, 165, 0.45) 0, rgba(255, 214, 165, 0) 280rpx),
    linear-gradient(180deg, #fff7ee 0%, #fffaf5 34%, #f8f5ef 100%);
  color: #25282d;
}

.category-page {
  min-height: 100vh;
  padding: 22rpx 46rpx 56rpx;
  box-sizing: border-box;
}

.nav-row {
  height: 78rpx;
  display: flex;
  align-items: center;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
}

.category-interest .back-button {
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 8rpx 22rpx rgba(143, 101, 59, 0.1);
}

.back-symbol {
  margin-top: -6rpx;
  font-size: 70rpx;
  line-height: 1;
  color: #111318;
  font-weight: 300;
}

.hero-section {
  position: relative;
  min-height: 314rpx;
  margin-top: 10rpx;
  margin-bottom: 34rpx;
  overflow: visible;
}

.hero-art {
  position: absolute;
  right: -34rpx;
  bottom: -8rpx;
  width: 444rpx;
  height: 258rpx;
}

.category-relationship .hero-art {
  right: -24rpx;
  width: 474rpx;
  height: 282rpx;
}

.category-interest .hero-art {
  right: -24rpx;
  width: 424rpx;
  height: 282rpx;
}

.hero-copy {
  position: relative;
  z-index: 1;
  padding-top: 100rpx;
  max-width: 430rpx;
}

.category-interest .hero-copy {
  padding-top: 100rpx;
  max-width: 430rpx;
}

.hero-title {
  font-size: 64rpx;
  line-height: 1.14;
  font-weight: 900;
  color: #22262b;
}

.category-interest .hero-title {
  font-size: 64rpx;
  color: #4a2b1c;
}

.hero-subtitle {
  display: block;
  margin-top: 28rpx;
  font-size: 30rpx;
  line-height: 1.32;
  color: #7f858f;
  white-space: pre-line;
}

.category-interest .hero-subtitle {
  margin-top: 28rpx;
  font-size: 30rpx;
  color: #987c67;
}

.scale-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.scale-card {
  display: flex;
  align-items: center;
  min-height: 146rpx;
  padding: 28rpx 30rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 44rpx rgba(151, 113, 74, 0.1);
}

.scale-card:active {
  transform: scale(0.988);
}

.scale-icon {
  flex: 0 0 auto;
  width: 108rpx;
  height: 108rpx;
  margin-right: 34rpx;
  border-radius: 26rpx;
  background: #fff3ea;
}

.scale-content {
  flex: 1;
  min-width: 0;
}

.scale-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.scale-title {
  max-width: 100%;
  font-size: 36rpx;
  line-height: 1.24;
  font-weight: 900;
  color: #22262b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scale-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.34;
  color: #848a94;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.test-action {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 170rpx;
  height: 66rpx;
  margin-left: 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffbd7c 0%, #ff8b3d 100%);
  box-shadow: 0 10rpx 22rpx rgba(255, 132, 56, 0.26);
  color: #ffffff;
  font-weight: 900;
  box-sizing: border-box;
}

.action-label {
  font-size: 27rpx;
  line-height: 1;
  color: #ffffff;
}

.action-chevron {
  width: 14rpx;
  height: 14rpx;
  border-top: 4rpx solid #ffffff;
  border-right: 4rpx solid #ffffff;
  transform: rotate(45deg);
}

.scale-subnote {
  display: block;
  margin-top: 22rpx;
  font-size: 24rpx;
  line-height: 1.25;
  color: #a5958a;
}

.feedback-container {
  width: 100%;
  padding: 120rpx 0;
  text-align: center;
  color: #999;
  font-size: 27rpx;
}
