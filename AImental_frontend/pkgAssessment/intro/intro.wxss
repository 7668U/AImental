page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 18% 10%, rgba(255, 226, 188, 0.64) 0, rgba(255, 226, 188, 0) 260rpx),
    radial-gradient(circle at 84% 46%, rgba(255, 207, 148, 0.32) 0, rgba(255, 207, 148, 0) 280rpx),
    linear-gradient(180deg, #fffaf4 0%, #fff8ef 100%);
  color: #352111;
}

.container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}

.hero-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: 80rpx;
  bottom: 0;
  padding: 74rpx 40rpx 168rpx;
  box-sizing: border-box;
  border-radius: 82rpx 82rpx 0 0;
  background: rgba(255, 255, 255, 0.64);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.85);
}

.state-panel {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
  box-sizing: border-box;
  color: #9a8d82;
  font-size: 28rpx;
  text-align: center;
}

.title-zone {
  position: relative;
  z-index: 1;
  min-height: 122rpx;
  margin-bottom: 20rpx;
}

.intro-kicker {
  margin-bottom: 12rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.4;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  color: #b56b2b;
  font-weight: 700;
}

.intro-title {
  width: 100%;
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  font-size: 50rpx;
  line-height: 1.12;
  font-weight: 900;
  color: #352111;
  text-align: center;
  word-break: keep-all;
  overflow-wrap: break-word;
}

.intro-icon {
  position: relative;
  z-index: 1;
  display: block;
  width: 342rpx;
  height: 342rpx;
  margin: 0 auto 30rpx;
  border-radius: 58rpx;
}

.card-zone {
  position: relative;
  z-index: 1;
  height: 380rpx;
}

.info-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  width: 100%;
  height: 176rpx;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 12rpx 28rpx rgba(158, 119, 76, 0.08);
}

.primary-card {
  margin-bottom: 26rpx;
}

.mini-icon-wrap {
  flex: 0 0 auto;
  width: 124rpx;
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #fff1e8, #fff8f1);
  overflow: hidden;
}

.mini-icon {
  width: 124rpx;
  height: 124rpx;
}

.card-copy {
  flex: 1;
  min-width: 0;
  text-align: left;
  word-break: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.strong-copy {
  -webkit-line-clamp: 3;
  font-size: 30rpx;
  line-height: 1.48;
  font-weight: 800;
  color: #3c2b1f;
}

.muted-copy {
  -webkit-line-clamp: 3;
  font-size: 29rpx;
  line-height: 1.48;
  font-weight: 500;
  color: #85817d;
}

.sparkle {
  position: absolute;
  z-index: 0;
  color: #f6bf73;
  line-height: 1;
  opacity: 0.72;
}

.sparkle-a {
  top: 108rpx;
  left: 94rpx;
  font-size: 26rpx;
}

.sparkle-b {
  top: 124rpx;
  right: 94rpx;
  font-size: 32rpx;
}

.sparkle-c {
  top: 402rpx;
  right: 106rpx;
  font-size: 28rpx;
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 80rpx;
  z-index: 5;
  padding: 18rpx 142rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(255, 250, 246, 0), rgba(255, 250, 246, 0.96) 32%);
}

.start-test-button {
  position: relative;
  width: 100%;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb833 0%, #ff9f18 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow: 0 16rpx 30rpx rgba(255, 162, 31, 0.28);
}

.start-test-button::after {
  border: none;
}

.start-test-button:active {
  transform: scale(0.985);
  background: linear-gradient(135deg, #ffaa22 0%, #f39013 100%);
}

.button-sparkle {
  position: absolute;
  left: 42rpx;
  top: 22rpx;
  font-size: 22rpx;
  opacity: 0.86;
}

.button-sparkle.right {
  left: auto;
  right: 42rpx;
  top: 34rpx;
}
