/* --- 全局容器设定 --- */
.container {
  /* 设定为相对定位，作为所有绝对定位元素的父容器 */
  position: relative; 
  height: 100vh; /* 必须占满整个屏幕高度 */
  width: 100vw;
  background-color: #f8f8f8;
  overflow: hidden; /* 防止意外溢出 */
  box-sizing: border-box;
}

/* --- 标题：固定在顶部 10% 处 --- */
.intro-title {
  position: absolute; 
  top: 10%; 
  left: 50%; 
  transform: translate(-50%, -50%); 
  width: 90%; 
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
}

/* --- 中间滚动内容区域 --- */
.content-area {
  position: absolute;
  top: calc(10% + 80rpx);

  /* --- 修正：根据按钮最新的 25% 位置重新计算 --- */
  bottom: calc(25% + 100rpx); /* 原为 calc(15% + 120rpx) */

  left: 40rpx;
  right: 40rpx;
  
  display: flex;
  flex-direction: column;
  align-items: center;
  
  justify-content: flex-start;

  overflow-y: auto; 
}

/* --- 中间内容元素的样式 --- */
.intro-icon {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
  
  /* --- 调整2：增大图片与描述的间距 --- */
  margin-bottom: 60rpx; /* 原为 40rpx */
}

.intro-description {
  font-size: 36rpx;
  color: #000;
  
  /* --- 调整1：字体加粗 --- */
  font-weight: bold;

  line-height: 1.6;
  text-align: left;
  
  /* --- 调整2：增大描述与指导语的间距 --- */
  margin-bottom: 60rpx; /* 原为 30rpx */
}

.intro-instructions {
  /* --- 调整3：增大指导语的字号 --- */
  font-size: 32rpx; /* 原为 26rpx */
  
  color: #888888;
  line-height: 1.5;
  text-align: left;
}


/* --- 按钮：固定在距离底部 25% 处 --- */
.start-test-button {
  position: absolute; 
  bottom: 25%; /* 这是你最新调整的位置 */
  left: 50%; 
  transform: translateX(-50%); 
  
  width: 80%;
  padding: 20rpx;
  background-color: #FFA500;
  color: white;
  font-size: 36rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  transition: background-color 0.3s ease;
}

.start-test-button:active {
  background-color: #FF8C00;
}