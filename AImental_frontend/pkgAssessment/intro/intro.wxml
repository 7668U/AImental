<view class="container">
  <view class="state-panel" wx:if="{{isLoading}}">
    <text>正在加载问卷介绍...</text>
  </view>

  <view class="state-panel" wx:elif="{{isError}}">
    <text>问卷介绍加载失败，请返回后重试</text>
  </view>

  <view class="hero-panel" wx:else>
    <view class="sparkle sparkle-a">✦</view>
    <view class="sparkle sparkle-b">✧</view>
    <view class="sparkle sparkle-c">✦</view>

    <view class="title-zone">
      <view class="intro-title">{{scale.displayName || scale.name}}</view>
    </view>

    <image
      class="intro-icon"
      src="{{scale.iconPath}}"
      mode="aspectFit"
      binderror="handleIconError"
    />

    <view class="card-zone">
      <view class="info-card primary-card">
        <view class="mini-icon-wrap">
          <image class="mini-icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/pkgAssessment/images/intro/intro-heart.png" mode="aspectFit" />
        </view>
        <view class="card-copy strong-copy">{{scale.coverSummary}}</view>
      </view>

      <view class="info-card">
        <view class="mini-icon-wrap note-icon">
          <image class="mini-icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/pkgAssessment/images/intro/intro-note.png" mode="aspectFit" />
        </view>
        <view class="card-copy muted-copy">{{scale.coverInstruction}}</view>
      </view>
    </view>
  </view>

  <view class="bottom-action">
    <button class="start-test-button" bindtap="startTest">
      <text class="button-sparkle">✦</text>
      <text>开始测试</text>
      <text class="button-sparkle right">✦</text>
    </button>
  </view>
</view>
