<view class="container">
  <view class="loading-container" wx:if="{{!scaleData}}">
    <text>正在为您加载题目...</text>
  </view>

  <view class="main-content" wx:else>
    <swiper class="question-swiper" current="{{currentIndex}}" bindchange="onSwiperChange" duration="300">
      <block wx:for="{{questions}}" wx:key="order" wx:for-index="index">
        <swiper-item>
          <view class="swiper-item-content">
            <view class="question-text">{{item.order}}. {{item.text}}</view>
            
            <view class="options-container">
              <radio-group class="option-group" bindchange="onRadioChange" data-order="{{item.order}}">
                
                <block wx:if="{{scaleData.assessment_type === 'scoring'}}">
                  <label class="option-row {{answers[item.order] == option.score ? 'selected' : ''}}" wx:for="{{item.choices}}" wx:key="score" wx:for-item="option">
                    <view class="option-dot-wrapper">
                      <view class="option-dot {{answers[item.order] == option.score ? 'selected' : ''}}"></view>
                    </view>
                    <view class="option-text">{{option.text}}</view>
                    <radio class="option-radio-hidden" value="{{option.score}}" checked="{{answers[item.order] == option.score}}"></radio>
                  </label>
                </block>

                <block wx:else>
                   <label class="option-row {{answers[item.order] == option.id ? 'selected' : ''}}" wx:for="{{item.choices}}" wx:key="id" wx:for-item="option">
                    <view class="option-dot-wrapper">
                      <view class="option-dot {{answers[item.order] == option.id ? 'selected' : ''}}"></view>
                    </view>
                    <view class="option-text">{{option.text}}</view>
                    <radio class="option-radio-hidden" value="{{option.id}}" checked="{{answers[item.order] == option.id}}"></radio>
                  </label>
                </block>

              </radio-group>
            </view>

            <view class="in-page-submit-container" wx:if="{{index === totalQuestions - 1}}">
              <view 
                class="submit-btn-view {{ (isSubmitting || answeredCount < totalQuestions) ? 'disabled' : '' }}"
                bindtap="submitAssessment">
                查看我的结果
              </view>
            </view>

          </view>
        </swiper-item>
      </block>
    </swiper>
    
    <view class="footer">
      <view class="progress-bar-container">
        <view class="progress-wrapper">
          <view class="progress-bar-bg">
            <view class="progress-bar-fg" style="width: {{progress}}%;"></view>
          </view>
          <image class="runner-icon" src="/images/assessment/run.png" style="left: {{progress}}%;"></image>
        </view>
        <view class="progress-text">{{answeredCount}}/{{totalQuestions}}</view>
      </view>
      
      <view class="action-buttons">
        <image class="nav-icon" src="/images/left.png" bindtap="prevQuestion" />
        <image class="nav-icon" src="/images/right.png" bindtap="nextQuestion" />
      </view>
    </view>
  </view>
</view>