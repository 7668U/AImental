page {
  height: 100%;
  background: #fff8ef;
}

.test-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 12% 20%, rgba(255, 226, 200, 0.72) 0, rgba(255, 226, 200, 0.38) 18%, transparent 42%),
    radial-gradient(circle at 84% 0%, rgba(252, 237, 216, 0.96) 0, rgba(252, 237, 216, 0.5) 28%, transparent 52%),
    linear-gradient(180deg, #fffaf4 0%, #fff5e9 100%);
  color: #342213;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.warm-bg {
  position: absolute;
  pointer-events: none;
  border-radius: 50%;
  background: rgba(255, 238, 219, 0.78);
  filter: blur(2rpx);
}

.warm-bg-top {
  width: 520rpx;
  height: 280rpx;
  left: -120rpx;
  top: 120rpx;
}

.warm-bg-bottom {
  width: 480rpx;
  height: 520rpx;
  right: -210rpx;
  bottom: -260rpx;
  background: rgba(255, 244, 229, 0.9);
}

.bg-dot {
  position: absolute;
  border-radius: 50%;
  background: rgba(251, 183, 137, 0.28);
}

.bg-dot-one {
  width: 22rpx;
  height: 22rpx;
  left: 160rpx;
  top: 184rpx;
}

.bg-dot-two {
  width: 12rpx;
  height: 12rpx;
  left: 286rpx;
  top: 318rpx;
}

.sparkle-img {
  position: absolute;
  width: 30rpx;
  height: 36rpx;
  pointer-events: none;
  z-index: 1;
}

.bg-sparkle-one {
  left: 300rpx;
  top: 168rpx;
  opacity: 0.34;
}

.test-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: content-box;
}

.nav-back {
  position: absolute;
  left: 32rpx;
  bottom: 8rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(246, 211, 184, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(188, 120, 70, 0.1);
}

.nav-back-icon {
  font-size: 76rpx;
  line-height: 1;
  color: #2f2118;
  font-weight: 500;
  margin-top: -6rpx;
}

.nav-title {
  font-size: 32rpx;
  line-height: 1;
  color: #302018;
  font-weight: 700;
  letter-spacing: 0;
}

.loading-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9a7d66;
  font-size: 28rpx;
  position: relative;
  z-index: 1;
}

.main-content {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: calc(28rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.question-swiper {
  flex: 1;
  width: 100%;
  min-height: 0;
}

.swiper-scroll {
  height: 100%;
}

.swiper-item-content {
  min-height: 100%;
  box-sizing: border-box;
  padding-bottom: 28rpx;
}

.question-card,
.options-panel,
.footer-card {
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(246, 215, 191, 0.9);
  box-shadow: 0 18rpx 48rpx rgba(192, 124, 69, 0.09);
  backdrop-filter: blur(8rpx);
}

.question-card {
  position: relative;
  min-height: 300rpx;
  border-radius: 38rpx;
  padding: 48rpx 44rpx 52rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.question-card::after {
  content: "";
  position: absolute;
  right: -12rpx;
  bottom: 42rpx;
  width: 138rpx;
  height: 116rpx;
  opacity: 0.38;
  background-image: radial-gradient(circle, #f5c39a 0 3rpx, transparent 4rpx);
  background-size: 20rpx 20rpx;
}

.question-index-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 34rpx;
}

.index-line {
  width: 54rpx;
  height: 2rpx;
  background: #f7bf8f;
  position: relative;
}

.index-line::before,
.index-line::after {
  content: "";
  position: absolute;
  top: -5rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #f7bf8f;
}

.index-line:first-child::before {
  left: -12rpx;
}

.index-line:first-child::after {
  display: none;
}

.index-line:last-child::before {
  display: none;
}

.index-line:last-child::after {
  right: -12rpx;
}

.question-index {
  min-width: 168rpx;
  height: 54rpx;
  margin: 0 20rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(245, 190, 143, 0.8);
  background: linear-gradient(180deg, rgba(255, 247, 235, 0.98), rgba(255, 237, 215, 0.9));
  color: #b55418;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.question-sparkle-one {
  right: 72rpx;
  top: 80rpx;
  width: 36rpx;
  height: 44rpx;
  opacity: 0.78;
}

.question-sparkle-two {
  left: 52rpx;
  bottom: 62rpx;
  width: 28rpx;
  height: 34rpx;
  opacity: 0.72;
}

.question-text {
  position: relative;
  z-index: 1;
  font-size: 38rpx;
  line-height: 1.55;
  font-weight: 800;
  color: #2d1d12;
  word-break: break-word;
  overflow-wrap: break-word;
}

.options-panel {
  margin-top: 28rpx;
  border-radius: 38rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.option-group {
  width: 100%;
}

.option-row {
  position: relative;
  min-height: 112rpx;
  display: flex;
  align-items: center;
  padding: 28rpx 72rpx 28rpx 42rpx;
  margin-bottom: 22rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(246, 211, 184, 0.86);
  background: rgba(255, 251, 246, 0.72);
  box-sizing: border-box;
  overflow: hidden;
  transition: border-color 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease;
}

.option-row:last-child {
  margin-bottom: 0;
}

.option-row.selected {
  border-color: #ffad78;
  background: linear-gradient(180deg, rgba(255, 250, 242, 0.98), rgba(255, 238, 222, 0.86));
  box-shadow: 0 10rpx 26rpx rgba(255, 151, 82, 0.12);
}

.option-dot {
  flex: 0 0 auto;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 5rpx solid #f3aa7a;
  box-sizing: border-box;
  background: #fffaf5;
  margin-right: 34rpx;
}

.option-dot.selected {
  border-color: #ff8c3e;
  background:
    radial-gradient(circle at center, #ff8c3e 0, #ff8c3e 45%, transparent 48%),
    #fffaf5;
}

.option-text {
  flex: 1;
  min-width: 0;
  color: #342213;
  font-size: 31rpx;
  line-height: 1.42;
  font-weight: 500;
  word-break: break-word;
  overflow-wrap: break-word;
}

.option-row.selected .option-text {
  color: #bf5b22;
  font-weight: 700;
}

.option-radio-hidden {
  display: none;
}

.option-sparkle {
  right: 46rpx;
  top: 50%;
  width: 24rpx;
  height: 30rpx;
  opacity: 0.42;
  transform: translateY(-50%);
}

.footer-shell {
  position: relative;
  flex-shrink: 0;
  margin-top: 40rpx;
}

.footer-card {
  border-radius: 34rpx;
  padding: 52rpx 28rpx 30rpx;
  box-sizing: border-box;
  overflow: visible;
}

.progress-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.progress-track-wrap {
  flex: 1;
  height: 46rpx;
  position: relative;
  display: flex;
  align-items: center;
  padding-left: 30rpx;
  box-sizing: border-box;
}

.progress-track {
  width: 100%;
  height: 22rpx;
  border-radius: 14rpx;
  background: #f5e8dc;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  min-width: 0;
  border-radius: 14rpx;
  background: linear-gradient(90deg, #ffc27e 0%, #ff913c 100%);
  transition: width 0.28s ease;
}

.runner-icon {
  position: absolute;
  left: 0;
  top: 50%;
  width: 70rpx;
  height: 70rpx;
  object-fit: contain;
  transform: translate(-36%, -54%);
  transition: left 0.28s ease;
  z-index: 2;
}

.progress-text {
  width: 86rpx;
  color: #aa7f60;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 800;
  text-align: right;
}

.answer-card-toggle {
  position: absolute;
  left: 50%;
  top: -25rpx;
  transform: translate(-50%, -50%);
  width: 124rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 250, 244, 1), rgba(255, 239, 221, 0.98));
  border: 1rpx solid rgba(245, 192, 151, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(201, 130, 82, 0.12);
  z-index: 5;
  transition: transform 0.22s ease;
}

.answer-card-toggle-icon {
  width: 34rpx;
  height: 34rpx;
  opacity: 1;
}

.answer-card-panel {
  border-radius: 30rpx;
  border: 1rpx solid rgba(246, 211, 184, 0.86);
  background: rgba(255, 252, 247, 0.84);
  padding: 60rpx 22rpx 26rpx;
  margin-bottom: 18rpx;
}

.answer-card-scroll {
  max-height: 320rpx;
}

.answer-card-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 18rpx;
}

.answer-card-item {
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(244, 208, 181, 0.9);
  background: rgba(255, 247, 239, 0.92);
  box-sizing: border-box;
}

.answer-card-item.answered {
  background: linear-gradient(180deg, rgba(255, 246, 236, 1), rgba(255, 232, 208, 0.98));
  border-color: rgba(255, 176, 112, 0.92);
}

.answer-card-item.unanswered {
  background: rgba(255, 251, 246, 0.96);
  border-style: dashed;
}

.answer-card-item.current {
  border-width: 3rpx;
  border-color: #ff9347;
  box-shadow: 0 8rpx 20rpx rgba(255, 148, 71, 0.16);
}

.answer-card-number {
  color: #a37b61;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 800;
}

.answer-card-item.answered .answer-card-number,
.answer-card-item.current .answer-card-number {
  color: #bf5b22;
}

.action-buttons {
  display: grid;
  grid-template-columns: 0.86fr 1.24fr;
  gap: 24rpx;
}

.prev-btn,
.next-btn {
  height: 88rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 30rpx;
  font-weight: 800;
  position: relative;
  overflow: hidden;
}

.prev-btn {
  gap: 18rpx;
  color: #9f7b64;
  background: rgba(255, 250, 245, 0.9);
  border: 1rpx solid rgba(246, 211, 184, 0.8);
  box-shadow: 0 10rpx 24rpx rgba(168, 114, 76, 0.06);
}

.next-btn {
  gap: 18rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ffc978 0%, #ff9644 100%);
  box-shadow: 0 14rpx 30rpx rgba(255, 144, 61, 0.28);
}

.prev-btn.disabled {
  opacity: 0.48;
}

.next-btn.disabled {
  opacity: 0.72;
}

.btn-chevron {
  font-size: 60rpx;
  line-height: 1;
  font-weight: 400;
  margin-top: -4rpx;
}

.btn-sparkle-one {
  left: 48rpx;
  top: 22rpx;
  width: 20rpx;
  height: 24rpx;
  opacity: 0.82;
}

.btn-sparkle-two {
  right: 44rpx;
  bottom: 18rpx;
  width: 18rpx;
  height: 22rpx;
  opacity: 0.62;
}
