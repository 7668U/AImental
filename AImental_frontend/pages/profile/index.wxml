<view class="profile-page">
  <image class="profile-bg" src="/images/profile/profile-bg.jpg" mode="aspectFill"></image>

  <view class="top-safe" style="height: {{topSafeHeight}}px;"></view>

  <view class="profile-hero">
    <view class="avatar-ring">
      <view class="avatar-orbit"></view>
      <image class="avatar" src="{{userInfo.avatar_url || 'https://assets.feelyourself.cn/miniprogram/assets/v1/images/default-avatar.png?v=202607050210'}}" mode="aspectFill"></image>
      <view class="avatar-heart">♥</view>
    </view>
    <view class="nickname">{{userInfo.nickname || '访客'}}</view>
    <view class="profile-slogan"><text>⌁</text> 爱世界 爱自己 <text>⌁</text></view>
  </view>

  <view class="menu-card">
    <view class="menu-item" bindtap="goToUserInfo">
      <view class="menu-icon-wrap">
        <image class="menu-icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/icons/icon-user.png" mode="aspectFit"></image>
      </view>
      <view class="menu-copy">
        <view class="menu-title">个人信息</view>
        <view class="menu-desc">管理个人资料与偏好设置</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>

    <view class="menu-item" bindtap="goToReports">
      <view class="menu-icon-wrap">
        <image class="menu-icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/icons/icon-report.png" mode="aspectFit"></image>
      </view>
      <view class="menu-copy">
        <view class="menu-title">测试历史</view>
        <view class="menu-desc">查看你的测评记录与结果</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>

    <view class="menu-item" bindtap="goToFeedback">
      <view class="menu-icon-wrap">
        <image class="menu-icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/icons/icon-feedback.png" mode="aspectFit"></image>
      </view>
      <view class="menu-copy">
        <view class="menu-title">意见反馈</view>
        <view class="menu-desc">分享你的想法，帮助我们更好地改进</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>

    <view class="menu-item" bindtap="goToAboutUs">
      <view class="menu-icon-wrap">
        <image class="menu-icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/icons/icon-about.png" mode="aspectFit"></image>
      </view>
      <view class="menu-copy">
        <view class="menu-title">关于我们</view>
        <view class="menu-desc">了解我们与产品相关信息</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view class="action-btn-container">
    <view wx:if="{{isLogin}}" class="action-btn logout-btn" bindtap="logout">
      <text class="action-icon">↪</text>
      <text>退出登录</text>
    </view>
    <view wx:else class="action-btn login-btn" bindtap="login">
      <text class="action-icon">↪</text>
      <text>点击登录</text>
    </view>
  </view>
</view>
