<view class="container">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="navigateBack">
      <image class="nav-back-icon" src="/images/icons/icon-back.png" mode="aspectFit" />
    </view>
    <view class="nav-title">关于我们</view>
  </view>

  <image class="bg-image" src="/images/logo.png" mode="aspectFit"></image>

  <view class="content">
    <view class="info-list">
      <view class="info-item">
        <text class="item-label">版本信息</text>
        <text class="item-value">{{version}}</text>
      </view>
      <view class="info-item clickable" bindtap="copyContact">
        <text class="item-label">联系我们</text>
        <text class="item-value">{{contactInfo}}</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <text>Copyright © 2025 Your Company</text>
  </view>
</view>