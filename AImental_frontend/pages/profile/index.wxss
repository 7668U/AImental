page {
  min-height: 100%;
  background: #fff8ee;
  color: #3f3229;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

.profile-page {
  position: relative;
  min-height: 100vh;
  padding: 0 26rpx calc(118rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-x: hidden;
  background: #fff8ee;
}

.profile-bg {
  position: fixed;
  z-index: 0;
  left: 0;
  top: 0;
  width: 100%;
  height: 100vh;
  pointer-events: none;
}

.top-safe {
  position: relative;
  z-index: 2;
  height: 72px;
}

.profile-hero {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 34rpx;
}

.avatar-ring {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  padding: 12rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 38rpx rgba(184, 116, 39, 0.12), 0 0 0 14rpx rgba(255, 255, 255, 0.28);
}

.avatar-orbit {
  position: absolute;
  left: -78rpx;
  top: 56rpx;
  width: 320rpx;
  height: 82rpx;
  border: 4rpx solid rgba(255, 224, 185, 0.78);
  border-radius: 50%;
  transform: rotate(-16deg);
  pointer-events: none;
}

.avatar {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  background: #ffe1a8;
}

.avatar-heart {
  position: absolute;
  z-index: 3;
  right: -14rpx;
  bottom: 6rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff7f1f;
  font-size: 31rpx;
  line-height: 1;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 20rpx rgba(255, 139, 49, 0.16);
}

.nickname {
  max-width: 660rpx;
  margin-top: 30rpx;
  font-size: 44rpx;
  line-height: 1.18;
  font-weight: 800;
  color: #4b392c;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0;
}

.profile-slogan {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.35;
  color: #aa6c35;
  text-align: center;
  letter-spacing: 0;
}

.profile-slogan text {
  color: rgba(218, 149, 73, 0.46);
  font-size: 25rpx;
}

.menu-card {
  position: relative;
  z-index: 2;
  margin: 28rpx 12rpx 0;
  padding: 16rpx 38rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 20rpx 46rpx rgba(142, 98, 50, 0.08);
  box-sizing: border-box;
}

.menu-item {
  position: relative;
  min-height: 126rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.menu-item::after {
  content: '';
  position: absolute;
  left: 116rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: rgba(112, 83, 58, 0.12);
}

.menu-item:last-child::after {
  display: none;
}

.menu-item:active {
  opacity: 0.72;
}

.menu-icon-wrap {
  width: 84rpx;
  height: 84rpx;
  margin-right: 30rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, rgba(255, 250, 243, 0.96), rgba(255, 238, 216, 0.9));
  box-shadow: inset 0 0 0 1rpx rgba(255, 216, 178, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon {
  width: 50rpx;
  height: 50rpx;
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: 33rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #3d332d;
  letter-spacing: 0;
}

.menu-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.32;
  color: #8d8178;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 0;
}

.menu-arrow {
  width: 34rpx;
  margin-left: 16rpx;
  color: #a6a09b;
  font-size: 54rpx;
  line-height: 1;
  font-weight: 300;
  text-align: right;
  flex-shrink: 0;
}

.action-btn-container {
  position: relative;
  z-index: 2;
  margin: 28rpx 88rpx 0;
}

.action-btn {
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0;
  box-shadow: 0 18rpx 34rpx rgba(255, 128, 31, 0.26);
}

.action-btn:active {
  opacity: 0.84;
}

.action-icon {
  margin-right: 16rpx;
  font-size: 36rpx;
  line-height: 1;
}

.login-btn,
.logout-btn {
  background: linear-gradient(135deg, #ffad55 0%, #ff7d21 100%);
}

@media (max-height: 700px) {
  .top-safe {
    height: 46px;
  }

  .profile-hero {
    padding-top: 18rpx;
  }

  .avatar-ring {
    width: 142rpx;
    height: 142rpx;
  }

  .nickname {
    margin-top: 20rpx;
    font-size: 38rpx;
  }

  .profile-slogan {
    margin-top: 12rpx;
  }

  .menu-card {
    margin-top: 20rpx;
    padding-top: 12rpx;
    padding-bottom: 12rpx;
  }

  .menu-item {
    min-height: 104rpx;
  }

  .menu-icon-wrap {
    width: 74rpx;
    height: 74rpx;
  }

  .menu-icon {
    width: 44rpx;
    height: 44rpx;
  }

  .action-btn-container {
    margin-top: 22rpx;
  }

  .action-btn {
    height: 80rpx;
  }
}
