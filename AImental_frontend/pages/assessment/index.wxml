<view class="page-container">

<block wx:if="{{isLoggedIn}}">

  <view class="top-bar" style="height: {{totalNavBarHeight}}px;">
    <view class="nav-bar-content" style="margin-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
      <view class="nav-bar-title"></view>
    </view>
  </view>

  <scroll-view class="scroll-content" scroll-y="true" style="padding-top: {{totalNavBarHeight}}px;">
    
    <view class="container">
      <view class="page-title">选择一个测评开始</view>
      <view class="page-subtitle">了解自己的内心世界</view>

      <view class="feedback-container" wx:if="{{isLoading}}">
        <text>正在加载测评列表...</text>
      </view>

      <view class="feedback-container" wx:if="{{isError}}">
        <text>加载失败，请下拉刷新重试</text>
      </view>

      <view class="card-grid" wx:if="{{!isLoading && !isError}}">
        <block wx:for="{{scaleList}}" wx:key="id">
          <view class="card-item" bindtap="goToTest" data-id="{{item.id}}">
            <image 
              class="card-icon" 
              src="{{item.iconPath}}" 
              binderror="handleIconError" 
              data-index="{{index}}"
            />
            <view class="card-name">{{item.name}}</view>
          </view>
        </block>
      </view>
    </view>
  </scroll-view>

</block>

<block wx:else>

  <view class="login-wrapper">
    <login-prompt 
      title="欢迎来到心理测评"
      subtitle="登录后开始探索你的内心世界"
      bind:loginevent="handleLogin" 
    />
  </view>
  
</block>
</view>