page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 85% 8%, rgba(255, 214, 165, 0.48) 0, rgba(255, 214, 165, 0) 260rpx),
    linear-gradient(180deg, #fff7ee 0%, #fffaf4 36%, #f9f6f0 100%);
  color: #303238;
}

.assessment-page {
  min-height: 100vh;
  padding: 24rpx 42rpx 48rpx;
  box-sizing: border-box;
}

.hero-section {
  position: relative;
  min-height: 372rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.hero-art {
  position: absolute;
  right: -46rpx;
  bottom: -8rpx;
  width: 458rpx;
  height: 292rpx;
  opacity: 0.98;
}

.hero-copy {
  position: relative;
  z-index: 1;
  padding-top: 90rpx;
  max-width: 430rpx;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  line-height: 1.18;
  font-weight: 800;
  color: #2f3338;
}

.hero-subtitle {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.22;
  color: #96989c;
}

.hero-subtitle + .hero-subtitle {
  margin-top: 8rpx;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.group-card {
  display: flex;
  align-items: center;
  min-height: 178rpx;
  padding: 34rpx 28rpx;
  box-sizing: border-box;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(167, 128, 83, 0.11);
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}

.group-card:active {
  transform: scale(0.985);
}

.group-icon {
  flex: 0 0 auto;
  width: 132rpx;
  height: 132rpx;
  border-radius: 30rpx;
  margin-right: 26rpx;
  background: #fff5ee;
}

.group-content {
  flex: 1;
  min-width: 0;
}

.group-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.group-title {
  font-size: 36rpx;
  line-height: 1.18;
  font-weight: 800;
  color: #2f3338;
}

.group-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.3;
  color: #87898e;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.group-action {
  flex: 0 0 auto;
  width: 180rpx;
  height: 80rpx;
  margin-left: 16rpx;
}

.login-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100vh;
  background: linear-gradient(180deg, #fff7ee 0%, #f9f6f0 100%);
}

.assessment-disclaimer-modal {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 300;
  width: 100%;
  height: 100%;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(41, 36, 31, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
}

.assessment-disclaimer-content {
  position: relative;
  width: 100%;
  max-width: 660rpx;
  max-height: 86vh;
  overflow: visible;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 30rpx 80rpx rgba(68, 48, 32, 0.22);
  border: 2rpx solid rgba(255, 236, 219, 0.92);
}

.assessment-disclaimer-body {
  padding: 58rpx 40rpx 42rpx;
  box-sizing: border-box;
}

.assessment-disclaimer-icon {
  position: absolute;
  left: 34rpx;
  top: 24rpx;
  z-index: 1;
  width: 66rpx;
  height: 66rpx;
  border-radius: 18rpx;
  box-shadow: 0 10rpx 18rpx rgba(255, 133, 105, 0.16);
}

.assessment-disclaimer-title {
  margin-top: 0;
  color: #2f3338;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.18;
  text-align: center;
}

.assessment-disclaimer-text {
  margin-top: 24rpx;
  color: #626872;
  font-size: 27rpx;
  line-height: 1.72;
}

.assessment-disclaimer-paragraph + .assessment-disclaimer-paragraph {
  margin-top: 18rpx;
}

.assessment-disclaimer-button {
  width: 100%;
  height: 82rpx;
  margin-top: 34rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8c2f 0%, #ff6418 100%);
  box-shadow: 0 16rpx 32rpx rgba(255, 100, 24, 0.26);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 82rpx;
  text-align: center;
}
