/* pages/assessment/index/index.wxss (最终完整版) */
page {
  background-color: #F9F7F3;
}

/* 外层安全区容器的样式 */
.safe-area-top {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

/* 内层内容容器，我们在这里定义布局边距 */
.container {
  padding: 80rpx 80rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.page-subtitle {
  font-size: 28rpx;
  color: #999;
  margin-top: 10rpx;
  margin-bottom: 50rpx;
}

.tab-container {
  display: flex;
  justify-content: flex-start;
  gap: 40rpx;
  margin-bottom: 50rpx;
}

.tab-button {
  padding: 12rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  color: #999;
  background-color: transparent;
  border-bottom: 3px solid transparent;
  transition: all 0.25s ease;
}

.tab-button.active {
  color: #333;
  font-weight: bold;
  border-bottom-color: #333;
}

.feedback-container {
  width: 100%;
  text-align: center;
  color: #999;
  padding: 100rpx 0;
}

.card-grid {
  display: grid;
  grid-template-columns: 270rpx 270rpx;
  gap: 50rpx;
  justify-content: center;
}

.card-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease;
  aspect-ratio: 1 / 1; 
  min-width: 0;
}

.card-item:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.card-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
}

.card-name {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%; 
  line-height: 1.4;
  min-height: 2.8em;
}

.card-name text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  overflow-wrap: break-word;
}