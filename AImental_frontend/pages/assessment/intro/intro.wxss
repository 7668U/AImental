.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.intro-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-top: 200rpx;
  margin-bottom: 20rpx;
  text-align: center;
  color: #333;
}

.intro-icon {
  width: 200rpx;
  height: 200rpx;
  margin-top: -300rpx; /* <-- 调整此值以控制图标距离标题底部的距离，值越大图标越往下 */
  margin-bottom: 20rpx; /* <-- 调整此值以控制图标距离介绍文字顶部的距离，值越大图标越往下 */
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.intro-description {
  font-size: 36rpx;
  color: #000;
  line-height: 1.6;
  text-align: left;
  margin-top: -300rpx; /* <-- 调整此值以控制介绍文字距离图标底部的距离，值越小介绍文字越往上 */
  margin-bottom: 10px; /* <-- 调整此值以控制介绍文字距离按钮顶部的距离，值越小按钮越往上 */
  padding: 0 20rpx;
}

.start-test-button {
  width: 80%;
  padding: 20rpx;
  background-color: #FFA500; /* Orange color */
  color: white;
  font-size: 36rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  transition: background-color 0.3s ease;
  position: relative;
  top: -250rpx; /* <-- 调整此值以微调按钮的垂直位置。负值向上移动，正值向下移动。例如：-50rpx */
}

.start-test-button:active {
  background-color: #FF8C00; /* Darker orange for active state */
}