/* pages/daily-checkin/paper-airplane/index.wxss */

/* .background-image 已移除 */

.page-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.sky-bg { /* 重新添加天空样式 */
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 70%; /* 天空占70% */
  background: linear-gradient(to bottom, #87CEEB, #B0E0E6);
}

.rooftop-bg { /* 重新添加屋顶样式 */
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 30%; /* 屋顶占30% */
  background-color: #A0522D; /* 棕色屋顶 */
  border-top: 5px solid #8B4513; /* 屋顶边缘线 */
  z-index: 0; /* 确保在背景图片之上，纸飞机之下 */
}

.airplane-container {
  position: relative;
  width: 100%;
  height: 100%;
  z-index: 10;
}

.airplane {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  opacity: 0.9;
  animation: float 6s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) rotate(-15deg);
  }
  50% {
    transform: translateY(-20px) rotate(15deg);
  }
}

/* 底部操作区 */
.actions-bar {
  position: absolute;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 30rpx;
  z-index: 20;
}

.action-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  color: white;
  font-size: 28rpx;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

.action-button.throw {
  background-color: #FF9800; /* 橙色 */
}

/* .action-button.pickup 已被移除 */

.action-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 998;
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80vw;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 5px 15px rgba(0,0,0,0.3);
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.write-modal {
  height: 50vh;
}

.read-modal {
  height: 60vh;
}

.message-input {
  width: 100%;
  height: calc(100% - 120rpx);
  padding: 20rpx;
  border: 1px solid #eee;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.message-display {
  width: 100%;
  height: calc(100% - 120rpx);
  padding: 20rpx;
  margin-bottom: 30rpx;
  font-size: 30rpx;
  line-height: 1.6;
  white-space: pre-wrap; /* 保留换行 */
}

