<view class="calendar-popup" wx:if="{{show}}">
  <view class="calendar-overlay" bind:tap="hide"></view>
  <view class="calendar-container">

    <view class="calendar-header">
      <image class="nav-arrow" src="/images/left.png" bind:tap="handleMonthChange" data-direction="{{-1}}"></image>
      <view class="current-date">{{currentYear}}年 {{currentMonth}}月</view>
      <image class="nav-arrow" src="/images/right.png" bind:tap="handleMonthChange" data-direction="{{1}}"></image>
    </view>

    <block wx:if="{{hasCheckinsThisMonth}}">
      <view class="week-header">
        <view class="week-day" wx:for="{{['日', '一', '二', '三', '四', '五', '六']}}" wx:key="*this">{{item}}</view>
      </view>

      <view class="date-grid">
        <view 
          wx:for="{{days}}" 
          wx:key="index" 
          class="day-cell {{item.isToday ? 'is-today' : ''}} {{item.day > 0 ? '' : 'is-placeholder'}}"
          bind:tap="handleDayTap"
          data-day="{{item}}"
        >
          <view 
            class="day-content" 
            style="background-color: {{item.checkin ? item.checkin.color : 'transparent'}};"
          >
            <image 
              wx:if="{{item.checkin}}" 
              class="mood-icon" 
              src="/images/daily-checkin/emotion/{{item.checkin.mood}}.png"
            ></image>
            <text class="day-number">{{item.day > 0 ? item.day : ''}}</text>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="empty-state">
          <image class="empty-icon" src="/images/daily-checkin/blank.png" mode="aspectFit"></image>
          <view class="empty-text">这个月还没有记录哦</view>
      </view>
    </block>
    
  </view>
</view>