<view class="calendar-popup" wx:if="{{show}}">
  <view class="calendar-overlay" bind:tap="hide"></view>
  <view class="calendar-container">

    <view class="calendar-header">
      <image class="nav-arrow" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/left.png" bind:tap="handleMonthChange" data-direction="{{-1}}"></image>
      <view class="current-date">{{currentYear}}年 {{currentMonth}}月</view>
      <image class="nav-arrow" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/right.png" bind:tap="handleMonthChange" data-direction="{{1}}"></image>
    </view>

    <view class="week-header">
      <view class="week-day" wx:for="{{['日', '一', '二', '三', '四', '五', '六']}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="date-grid">
      <view
        wx:for="{{days}}"
        wx:key="index"
        class="day-cell {{item.isToday ? 'is-today' : ''}} {{item.day > 0 ? '' : 'is-placeholder'}} {{item.hasMoments ? 'has-moments' : ''}} {{item.hasReview ? 'has-review' : ''}}"
        bind:tap="handleDayTap"
        data-day="{{item}}"
      >
        <view class="day-content">
          <image
            wx:if="{{item.hasReview}}"
            class="mood-icon review-icon"
            src="https://assets.feelyourself.cn/miniprogram/assets/v1/pkgDailyCheckin/images/record/mood24/{{item.reviewMoodIcon}}.png"
          ></image>
          <block wx:elif="{{item.hasMoments}}">
            <text class="moment-check">✓</text>
            <text wx:if="{{item.momentCount > 1}}" class="moment-count">{{item.momentCount}}</text>
          </block>
          <text wx:else class="day-number">{{item.day > 0 ? item.day : ''}}</text>
          <view wx:if="{{item.hasReview && item.hasMoments}}" class="moment-dot"></view>
          <view wx:if="{{item.hasReview}}" class="review-mark">回</view>
          </view>
      </view>
    </view>

    <view wx:if="{{!hasCheckinsThisMonth}}" class="empty-state">
      <image class="empty-icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/daily-checkin/blank.png" mode="aspectFit"></image>
      <view class="empty-text">这个月还没有记录哦</view>
    </view>
    
  </view>
</view>
