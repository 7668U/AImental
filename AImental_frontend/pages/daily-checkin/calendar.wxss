/* components/calendar/calendar.wxss */
.calendar-popup {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
}

.calendar-overlay {
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.4);
}

.calendar-container {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  overflow: hidden;
  background-color: #fffaf3;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 0 30rpx 28rpx;
  box-sizing: border-box;
  animation: slide-up 0.3s ease-out;
}

.calendar-hero-bg {
  position: absolute;
  top: -24rpx;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 294rpx;
  opacity: 0.96;
}

.calendar-content {
  position: relative;
  z-index: 1;
  padding-top: 40rpx;
}

@keyframes slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 34rpx;
  font-size: 36rpx;
  font-weight: bold;
  color: #5c3725;
}

.nav-arrow {
  width: 40rpx;
  height: 40rpx;
  padding: 10rpx;
}

.week-header {
  display: flex;
  justify-content: space-around;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  color: #98745e;
}

.week-day {
  width: calc(100% / 7);
  text-align: center;
}

.date-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: calc(100% / 7);
  height: 108rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
}

.day-cell.is-placeholder {
  pointer-events: none;
}

.day-cell.is-today .day-content {
  border: 2rpx solid #ff9d16;
  border-radius: 16rpx;
}

.day-cell.has-moments .day-content {
  background: #fff4e6;
}

.day-content {
  width: 90rpx;
  height: 90rpx;
  border-radius: 16rpx;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.2s ease;
}

.day-cell:active .day-content {
    transform: scale(0.9);
}

.moment-check {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #ff9d16;
  color: #fff;
  font-size: 34rpx;
  line-height: 54rpx;
  text-align: center;
  font-weight: 900;
  box-shadow: 0 6rpx 14rpx rgba(255, 126, 24, 0.18);
}

.day-number {
  font-size: 28rpx;
  color: #555;
  width: 50rpx;
  height: 50rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #fffdf9;
  border-radius: 50%;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(72, 58, 43, 0.08);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 8rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 8rpx;
}

.empty-text {
  color: #98745e;
  font-size: 26rpx;
}
