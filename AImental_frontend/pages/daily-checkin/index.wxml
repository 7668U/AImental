<calendar show="{{showCalendar}}" bind:daytap="onDayTap" bind:hide="hideCalendar"></calendar>

<view class="page-container">
  <image class="diary-bg" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/daily-checkin/layout/mood-diary-bg.jpg" mode="aspectFill"></image>

    <view class="top-bar" style="height: {{totalNavBarHeight}}px;">
      <view class="nav-bar-content" style="margin-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
        <view class="nav-bar-title"></view>
      </view>
    </view>

    <view class="main-content" style="padding-top: {{totalNavBarHeight}}px;">
      
      <view class="welcome-wrapper">
        <view class="title-row">
          <view class="title">你好，</view>
          <text class="greeting-heart">♥</text>
        </view>
        <view class="subtitle">今天也要好好关照自己</view>
      </view>

      <scroll-view class="card-scroll-area" scroll-y="true">
        <view class="daily-layout">
          <view class="primary-checkin-card" bind:tap="goToRecord">
            <view class="primary-copy">
              <view class="primary-title">此刻心情记录</view>
              <view class="primary-subtitle">现在的你，感觉怎么样？</view>
              <view wx:if="{{todayMomentCount > 0}}" class="primary-count-hint">今天已记录 {{todayMomentCount}} 次</view>
            </view>
            <image class="primary-illustration" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/daily-checkin/layout/checkin-hero.png" mode="aspectFit"></image>
            <view class="primary-action">
              <text>记录此刻</text>
            </view>
          </view>

          <view class="secondary-grid">
            <view class="secondary-card" bind:tap="openCalendar">
              <image class="secondary-icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/daily-checkin/layout/calendar-card.png" mode="aspectFit"></image>
              <view class="secondary-title">心情日历</view>
              <view class="secondary-subtitle">重温每日心情</view>
            </view>

            <view class="secondary-card" bind:tap="goToStatistics">
              <image class="secondary-icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/daily-checkin/layout/analysis-card.png" mode="aspectFit"></image>
              <view class="secondary-title">心情分析</view>
              <view class="secondary-subtitle">发现情绪的流动</view>
            </view>
          </view>

          <view class="trajectory-panel" bind:tap="goToTrajectory">
            <view class="trajectory-header">
              <view>
                <view class="trajectory-title">今日心情轨迹</view>
                <view class="trajectory-subtitle">{{trajectorySubtitle}}</view>
              </view>
              <view class="trajectory-link">查看全部</view>
            </view>

            <view wx:if="{{todayMomentCount > 0}}" class="trajectory-body">
              <scroll-view class="trajectory-preview-scroll" scroll-x="true" show-scrollbar="false">
                <view class="trajectory-preview-list">
                  <view wx:for="{{todayTrajectoryPreview}}" wx:key="id" class="trajectory-preview-item">
                    <image class="trajectory-preview-icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/pkgDailyCheckin/images/record/mood24/{{item.moodIcon}}.png" mode="aspectFit"></image>
                    <view class="trajectory-preview-time">{{item.localTime}}</view>
                  </view>
                  <view wx:if="{{hasDailyReview}}" class="trajectory-preview-item review">
                    <image class="trajectory-preview-icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/pkgDailyCheckin/images/record/mood24/{{reviewMoodIcon}}.png" mode="aspectFit"></image>
                    <view class="trajectory-preview-time">回顾</view>
                  </view>
                </view>
              </scroll-view>
              <view class="trajectory-meta">
                <text wx:if="{{latestMomentTime}}">最近一次 {{latestMomentTime}}</text>
                <text wx:if="{{hasDailyReview}}" class="review-badge">已回顾</text>
              </view>
            </view>

            <view wx:else class="trajectory-empty">
              <view class="trajectory-empty-text">把这一刻轻轻记下来</view>
              <view class="trajectory-empty-button" catchtap="goToRecord">记录此刻</view>
            </view>
          </view>
        </view>
      </scroll-view>

    </view>

</view>

<view class="daily-guide-modal" wx:if="{{showDailyCheckinGuide}}" catchtouchmove="preventDailyCheckinGuideClose">
  <view class="daily-guide-content" catchtap="preventDailyCheckinGuideClose">
    <image class="daily-guide-icon" src="{{dailyCheckinGuideIcon}}" mode="aspectFit"></image>
    <view class="daily-guide-body">
      <view class="daily-guide-title">温馨提示</view>
      <view class="daily-guide-text">
        <view class="daily-guide-paragraph">欢迎来到每日打卡。这里会陪你留下一些属于自己的记录：今天的心情、状态、色彩，还有那些想说却没来得及说出口的话。</view>
        <view class="daily-guide-paragraph">我们希望这个小工具，能陪你更细致地感受和理解自己的情绪。开心、疲惫、低落、焦虑、平静，每一种感受都有它出现的原因，也都值得被认真看见。</view>
        <view class="daily-guide-paragraph">学会爱自己，是一生都在练习的必修课；而学会理解自己的情绪，就是这门课里很重要的一部分。愿你在一次次记录里，慢慢认识自己，也慢慢学会用更温柔的方式照顾自己。</view>
      </view>
      <view class="daily-guide-button" bindtap="handleConfirmDailyCheckinGuide">开始记录</view>
    </view>
  </view>
</view>

<privacy-consent
  visible="{{privacyVisible}}"
  bind:confirm="onPrivacyConfirm"
  bind:reject="onPrivacyReject"
/>
