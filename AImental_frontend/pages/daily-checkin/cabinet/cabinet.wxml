<!-- 系统导航栏版本 -->
<view class="page-root" style="padding-top: {{contentTopLift}}rpx;">
  <view class="container">

    <!-- 标题 -->
    <view class="page-title" style="margin-bottom: {{titleBottomGap}}rpx;">我的记事簿</view>

    <!-- 书架（无论是否有数据都显示，确保“新建笔记本”按钮可见） -->
    <view class="bookshelf" style="margin-top: {{shelfPullUp}}rpx;">

      <!-- 已有笔记本 -->
      <view class="notebook-item" wx:for="{{notebooks}}" wx:key="id">
        <view class="notebook-frame">
          <view class="notebook-cover-wrapper"
                bindtap="navigateToNote"
                bindlongpress="showActionMenu"
                data-id="{{item.id}}"
                data-name="{{item.name}}"
                data-cover="{{item.cover_image}}">

            <image class="notebook-cover" src="{{item.cover_image}}" mode="aspectFill" />
            <image class="more-icon"
                   src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/icons/more.png"
                   catchtap="showActionMenu"
                   data-id="{{item.id}}"
                   data-name="{{item.name}}"
                   data-cover="{{item.cover_image}}" />

            <!-- 竖排标题 -->
            <view class="notebook-name-on-cover">
              <block wx:for="{{item.formattedName}}" wx:key="*this" wx:for-item="nameChunk">
                <text class="notebook-name-chunk">{{nameChunk}}</text>
              </block>
            </view>
          </view>
        </view>
      </view>

      <!-- 新建笔记本：始终显示 -->
      <view class="notebook-item add-new-notebook" bindtap="showCreateModal">
        <view class="notebook-frame">
          <view class="add-box-area">
            <image class="add-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/icons/plus.png" />
          </view>
        </view>
        <text class="notebook-name"></text>
      </view>

    </view>
  </view>

  <!-- Action Sheet -->
  <view class="action-sheet-mask" wx:if="{{showActionSheet}}" bindtap="hideActionSheet">
    <view class="action-sheet" catchtap="preventMaskTap">
      <view class="action-sheet-item" bindtap="showRenameModal">重命名</view>
      <view class="action-sheet-item" bindtap="openCoverSelector">更换封面</view>
      <view class="action-sheet-item danger" bindtap="confirmDeleteNotebook">删除笔记本</view>
      <view class="action-sheet-gap"></view>
      <view class="action-sheet-item" bindtap="hideActionSheet">取消</view>
    </view>
  </view>

  <!-- 封面选择器 / 弹窗保留你现有实现 -->
  <cover-selector wx:if="{{showCoverSelectorForUpdate}}"
                  selected-cover="{{currentNotebookCover}}"
                  bind:select="handleUpdateCover"
                  bind:close="hideCoverSelector" />

  <!-- 新建/重命名 Modal -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="hideModal">
    <view class="modal-content" catchtap="preventMaskTap">
      <view class="modal-title">{{modalMode === 'create' ? '新建笔记本' : '重命名'}}</view>
      <input class="name-input" maxlength="6" placeholder="请输入笔记本名称(最多6个字)"
             value="{{notebookNameInput}}" bindinput="handleNameInput" />
      <view wx:if="{{modalMode === 'create'}}">
        <cover-selector selected-cover="{{selectedCoverForCreate}}" bind:select="onCoverSelectForCreate" />
      </view>
      <view class="modal-actions">
        <button class="modal-btn cancel" bindtap="hideModal">取消</button>
        <button class="modal-btn confirm" bindtap="handleConfirm">确定</button>
      </view>
    </view>
  </view>
</view>
