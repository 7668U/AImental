/* pages/daily-checkin/index.wxss */

page {
  background-color: #fff4df;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

.page-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

.diary-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.top-bar {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 10;
  width: 100%;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(255, 244, 222, 0.88) 0%, rgba(255, 244, 222, 0) 100%);
}

.nav-bar-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.nav-bar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #3f2718;
}

.main-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
}

.welcome-wrapper {
  flex-shrink: 0;
  padding: 26rpx 60rpx 16rpx;
  box-sizing: border-box;
}

.title-row {
  display: flex;
  align-items: flex-end;
}

.welcome-wrapper .title {
  font-family: 'LXGWWenKaiHome', "STKaiti", "KaiTi", "Songti SC", "PingFang SC", serif;
  font-size: 66rpx;
  line-height: 1.05;
  font-weight: 500;
  color: #552814;
  letter-spacing: 0;
}

.greeting-heart {
  display: inline-block;
  margin-left: 28rpx;
  margin-bottom: 9rpx;
  color: #ff8a2a;
  font-size: 38rpx;
  line-height: 1;
}

.welcome-wrapper .subtitle {
  margin-top: 22rpx;
  font-family: 'LXGWWenKaiHome', "STKaiti", "KaiTi", "Songti SC", "PingFang SC", serif;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 500;
  color: #653522;
  letter-spacing: 0;
}

.welcome-line {
  display: flex;
  align-items: center;
  width: 335rpx;
  margin-top: 14rpx;
  margin-left: -8rpx;
  color: #e8a958;
}

.welcome-line-stroke {
  flex: 1;
  height: 16rpx;
  border-bottom: 2rpx solid rgba(226, 150, 65, 0.42);
  border-radius: 50%;
}

.welcome-line-flower {
  flex-shrink: 0;
  margin-left: -2rpx;
  font-size: 27rpx;
  line-height: 1;
}

.card-scroll-area {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.daily-layout {
  width: 100%;
  padding: 0 35rpx 28rpx;
  box-sizing: border-box;
}

.primary-checkin-card,
.secondary-card,
.trajectory-panel {
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 18rpx 44rpx rgba(167, 105, 34, 0.14);
  box-sizing: border-box;
  backdrop-filter: blur(12rpx);
}

.primary-checkin-card:active,
.secondary-card:active,
.trajectory-panel:active {
  transform: scale(0.985);
  box-shadow: 0 10rpx 28rpx rgba(167, 105, 34, 0.16);
}

.primary-checkin-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  width: 100%;
  height: 456rpx;
  margin-bottom: 22rpx;
  padding: 48rpx 46rpx 40rpx;
  overflow: hidden;
  border-radius: 38rpx;
}

.primary-illustration {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.primary-soft-mask {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  width: 58%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.91) 58%, rgba(255, 255, 255, 0.28) 100%);
}

.primary-copy {
  position: relative;
  z-index: 2;
  width: 365rpx;
}

.primary-title {
  font-size: 46rpx;
  line-height: 1.08;
  font-weight: 800;
  color: #5a270f;
  letter-spacing: 0;
}

.primary-subtitle {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.3;
  color: #805d4a;
  letter-spacing: 0;
}

.primary-action {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  left: auto;
  bottom: auto;
  z-index: 2;
  margin-top: 46rpx;
  width: 254rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff9332 0%, #ff681d 100%);
  box-shadow: 0 14rpx 24rpx rgba(230, 91, 18, 0.25), inset 0 2rpx 0 rgba(255, 255, 255, 0.38);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
}

.secondary-grid {
  display: flex;
  justify-content: space-between;
  width: 100%;
  gap: 22rpx;
}

.secondary-card {
  position: relative;
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 198rpx;
  padding: 30rpx 24rpx 28rpx;
  overflow: hidden;
  border-radius: 28rpx;
}

.secondary-icon {
  flex-shrink: 0;
  width: 118rpx;
  height: 118rpx;
  margin-right: 18rpx;
}

.secondary-copy {
  min-width: 0;
  flex: 1;
}

.secondary-title {
  font-size: 31rpx;
  line-height: 1.18;
  font-weight: 800;
  color: #5b2b18;
  letter-spacing: 0;
}

.secondary-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.22;
  color: #8d6856;
  letter-spacing: 0;
}

.trajectory-panel {
  margin-top: 30rpx;
  padding: 34rpx 40rpx 30rpx;
  border-radius: 30rpx;
}

.trajectory-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.trajectory-title {
  font-size: 34rpx;
  line-height: 1.18;
  font-weight: 800;
  color: #502413;
  letter-spacing: 0;
}

.trajectory-subtitle {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.25;
  color: #8d6856;
  letter-spacing: 0;
}

.trajectory-link {
  flex-shrink: 0;
  min-width: 132rpx;
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 239, 221, 0.88);
  color: #d45b12;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 52rpx;
  text-align: center;
  box-sizing: border-box;
}

.trajectory-body {
  margin-top: 32rpx;
}

.trajectory-preview-scroll {
  width: 100%;
  white-space: nowrap;
}

.trajectory-preview-list {
  position: relative;
  display: inline-flex;
  align-items: flex-start;
  gap: 34rpx;
  min-width: 100%;
}

.trajectory-preview-list::before {
  content: "";
  position: absolute;
  top: 48rpx;
  left: 54rpx;
  right: 54rpx;
  z-index: 0;
  border-top: 3rpx dashed rgba(229, 171, 105, 0.48);
}

.trajectory-preview-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 94rpx;
  min-height: 134rpx;
}

.trajectory-preview-icon {
  width: 86rpx;
  height: 86rpx;
  padding: 6rpx;
  border: 2rpx solid rgba(232, 180, 122, 0.55);
  border-radius: 50%;
  background: rgba(255, 251, 245, 0.95);
  box-sizing: border-box;
}

.trajectory-preview-time {
  margin-top: 13rpx;
  color: #7f5949;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: center;
}

.trajectory-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-top: 12rpx;
  padding: 8rpx 20rpx 22rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: rgba(255, 249, 240, 0.82);
}

.trajectory-empty-image {
  width: 340rpx;
  height: 170rpx;
}

.trajectory-empty-text {
  min-width: 0;
  color: #8a604b;
  font-size: 26rpx;
  line-height: 1.35;
  text-align: center;
}

.daily-guide-modal {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 46rpx;
  box-sizing: border-box;
  background: rgba(52, 38, 26, 0.44);
}

.daily-guide-content {
  position: relative;
  width: 100%;
  max-width: 660rpx;
  max-height: 86vh;
  border: 2rpx solid rgba(255, 227, 190, 0.92);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 30rpx 78rpx rgba(115, 69, 28, 0.22);
  overflow: hidden;
}

.daily-guide-icon {
  position: absolute;
  left: 34rpx;
  top: 42rpx;
  z-index: 1;
  width: 88rpx;
  height: 88rpx;
}

.daily-guide-body {
  max-height: 86vh;
  padding: 56rpx 40rpx 40rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.daily-guide-title {
  color: #3b2d24;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.18;
  text-align: center;
}

.daily-guide-text {
  margin-top: 26rpx;
  color: #725f52;
  font-size: 27rpx;
  line-height: 1.68;
  text-align: left;
}

.daily-guide-paragraph + .daily-guide-paragraph {
  margin-top: 18rpx;
}

.daily-guide-button {
  width: 100%;
  height: 82rpx;
  margin-top: 34rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ff9332 0%, #ff681d 100%);
  box-shadow: 0 16rpx 32rpx rgba(255, 105, 24, 0.25);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 82rpx;
  text-align: center;
}
