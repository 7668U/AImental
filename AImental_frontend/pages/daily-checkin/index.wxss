/* pages/daily-checkin/index.wxss (Q弹效果版) */

page {
  background-color: #F9F7F3;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

/* ========== 全局布局样式 ========== */

.page-container {
  width: 100vw;
  height: 100vh;
  box-sizing: border-box;
}

.login-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
}

/* ========== 自定义导航栏样式 ========== */

.top-bar {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 10;
  width: 100%;
  background-color: #F9F7F3;
  box-sizing: border-box;
}

.nav-bar-content {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.nav-bar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* ========== 页面内容区样式 ========== */

/* 主内容容器，负责Flex布局和避开导航栏 */
.main-content {
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 固定的欢迎语部分 */
.welcome-wrapper {
  padding: 0 40rpx;      /* 左右内边距 */
  margin-bottom: 20rpx;  /* 和下方卡片的间距 */
  flex-shrink: 0;          /* 高度不被压缩 */
}

.welcome-wrapper .title {
  font-size: 52rpx;
  font-weight: bold;
  color: #333;
}

.welcome-wrapper .subtitle {
  font-size: 32rpx;
  color: #888;
  margin-top: 10rpx;
}

/* 可滚动的卡片区域 */
.card-scroll-area {
  flex-grow: 1;
  overflow-y: auto;
}

.card-list {
  width: 100%;
  padding: 0 40rpx 40rpx; /* 上0, 左右40, 下40 */
  box-sizing: border-box;
}

/* 卡片自身样式 */
.card {
  display: flex;
  align-items: center;
  width: 100%;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(226, 172, 112, 0.15);
  /* [修改] 将原来的 transition 替换为下面这行，使用带有回弹效果的贝塞尔曲线 */
  transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.card:active {
  /* [修改] 将 scale 的值改小一点，让按压效果更明显 */
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(226, 172, 112, 0.2);
}

.card-icon {
  width: 90rpx;
  height: 90rpx;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.card-content {
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.card-subtitle {
  font-size: 26rpx;
  color: #999999;
}

/* 注意：旧的 .container 样式已被完全删除，因为它的功能被 .welcome-wrapper 和 .card-list 的 padding 取代了 */