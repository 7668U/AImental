/* pages/daily-checkin/index.wxss (Q弹效果版) */

page {
  background-color: #fff3df;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

/* ========== 全局布局样式 ========== */

.page-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

.diary-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.login-wrapper {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
}

/* ========== 自定义导航栏样式 ========== */

.top-bar {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 10;
  width: 100%;
  background: linear-gradient(180deg, rgba(255, 243, 223, 0.96) 0%, rgba(255, 243, 223, 0.72) 72%, rgba(255, 243, 223, 0) 100%);
  box-sizing: border-box;
}

.nav-bar-content {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.nav-bar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* ========== 页面内容区样式 ========== */

/* 主内容容器，负责Flex布局和避开导航栏 */
.main-content {
  position: relative;
  z-index: 1;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 固定的欢迎语部分 */
.welcome-wrapper {
  padding: 0 40rpx;      /* 左右内边距 */
  margin-bottom: 20rpx;  /* 和下方卡片的间距 */
  flex-shrink: 0;          /* 高度不被压缩 */
}

.title-row {
  display: flex;
  align-items: flex-end;
}

.welcome-wrapper .title {
  font-size: 52rpx;
  font-weight: bold;
  color: #5f3c26;
  letter-spacing: 0;
}

.greeting-heart {
  display: inline-block;
  margin-left: 22rpx;
  margin-bottom: 8rpx;
  color: #ff8f32;
  font-size: 38rpx;
  line-height: 1;
}

.welcome-wrapper .subtitle {
  font-size: 32rpx;
  color: #8b684d;
  margin-top: 10rpx;
}

.card-scroll-area {
  flex-grow: 1;
  overflow-y: auto;
}

.daily-layout {
  width: 100%;
  padding: 0 40rpx 44rpx;
  box-sizing: border-box;
}

.primary-checkin-card,
.secondary-card {
  background-color: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(255, 215, 165, 0.52);
  box-shadow: 0 12rpx 36rpx rgba(210, 142, 64, 0.14);
  backdrop-filter: blur(10rpx);
  transition: transform 0.28s cubic-bezier(0.175, 0.885, 0.32, 1.12), box-shadow 0.28s ease;
}

.primary-checkin-card:active,
.secondary-card:active {
  transform: scale(0.97);
  box-shadow: 0 6rpx 18rpx rgba(226, 172, 112, 0.22);
}

.primary-checkin-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 670rpx;
  border-radius: 40rpx;
  padding: 56rpx 52rpx 44rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
}

.primary-copy {
  flex-shrink: 0;
}

.primary-title {
  font-size: 54rpx;
  line-height: 1.12;
  font-weight: 800;
  color: #5d3a25;
  letter-spacing: 0;
}

.primary-subtitle {
  margin-top: 22rpx;
  font-size: 28rpx;
  line-height: 1.35;
  color: #8a6a51;
  letter-spacing: 0;
}

.primary-illustration {
  width: 100%;
  height: 338rpx;
  margin-top: 20rpx;
  flex-shrink: 0;
}

.primary-action {
  width: 360rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin: 20rpx auto 0;
  border-radius: 999rpx;
  text-align: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #ff8f32 0%, #ff6f20 100%);
  box-shadow: 0 10rpx 20rpx rgba(255, 126, 39, 0.22);
}

.secondary-grid {
  display: flex;
  justify-content: space-between;
  width: 100%;
}

.secondary-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 321rpx;
  height: 321rpx;
  border-radius: 34rpx;
  padding: 28rpx 24rpx 30rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.secondary-icon {
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
}

.secondary-title {
  margin-top: 14rpx;
  font-size: 34rpx;
  line-height: 1.18;
  font-weight: 800;
  color: #5d3a25;
  text-align: center;
  letter-spacing: 0;
}

.secondary-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.25;
  color: #92745c;
  text-align: center;
  letter-spacing: 0;
}

/* 注意：旧的 .container 样式已被完全删除，因为它的功能被 .welcome-wrapper 和 .daily-layout 的 padding 取代了 */
