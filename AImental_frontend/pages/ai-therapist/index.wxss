/* pages/ai-therapist/index.wxss */

/* --- 1. Variáveis Globais e de Cor --- */
page {
  --primary-orange: #F2994A;
  --primary-orange-light: #FFF5EE;
  --text-primary: #333333;
  --text-secondary: #888888;
  --bg-color: #F7F7F7;
  --hover-color: #f0f0f0;
}
/* --- 2. Contêiner no Nível da Página --- */
.page-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  background-color: var(--bg-color);
  overflow: hidden;
}
/* --- 3. Estilos da Barra Lateral --- */
.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  width: 75vw;
  max-width: 560rpx;
  height: 100%;
  background-color: #ffffff;
  box-sizing: border-box;
  transform: translateX(-100%);
  transition: transform 0.3s ease-in-out;
  z-index: 100;
  border-right: 1rpx solid #EAEAEA;
  display: flex;
  flex-direction: column;
  padding: 100rpx 30rpx 40rpx; 
}
.sidebar-visible {
  transform: translateX(0);
}
.new-chat-btn {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: var(--primary-orange-light);
  border: 1rpx solid var(--primary-orange);
  border-radius: 20rpx;
  font-size: 30rpx;
  color: var(--primary-orange);
  font-weight: bold;
  margin: 20rpx 0;
  flex-shrink: 0;
}
.icon-plus { width: 36rpx; height: 36rpx; margin-right: 20rpx; }
.history-title-container {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  padding: 20rpx 10rpx;
}
.history-title-icon { width: 32rpx; height: 32rpx; margin-right: 15rpx; }

/* --- [SEÇÃO MODIFICADA] Início das alterações na lista de histórico --- */
.history-list {
  flex-grow: 1;
  height: 100%;
}
.history-item-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  border-radius: 16rpx;
  transition: background-color 0.2s;
}
/* Efeito de hover para todo o wrapper */
.history-item-wrapper:hover {
  background-color: var(--hover-color);
}
.history-item {
  flex-grow: 1; /* Permite que o item ocupe o espaço disponível */
  padding: 25rpx 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border-radius: 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  /* O margin-bottom foi movido para o wrapper */
}
.history-item.active {
  background-color: var(--primary-orange);
  color: #ffffff;
  font-weight: bold;
}
/* Estilo para o botão de opções (três pontos) */
.history-item-options {
  flex-shrink: 0; 
  width: 40rpx;
  height: 40rpx;
  padding: 10rpx; 
  margin: 0 20rpx 0 10rpx;
  transition: opacity 0.2s, filter 0.2s; /* [优化] 增加过渡效果 */

  /* [核心修改] 默认状态下，使用滤镜将橙色图标变为灰色，并降低不透明度 */
  filter: grayscale(100%);
  opacity: 0.4;
}

/* 当历史项被激活(选中)时，让选项按钮恢复原色 */
.history-item.active + .history-item-options {
  /* [核心修改] 选中状态下，移除所有滤镜，让图标恢复原始的橙色，并让它完全不透明 */
  filter: none;
  opacity: 1;
}
/* --- [SEÇÃO MODIFICADA] Fim das alterações --- */

/* --- Conteúdo Principal --- */
.main-content {width: 100%;height: 100%;display: flex;flex-direction: column;transition: transform 0.3s ease-in-out;}
.main-content-pushed {transform: translateX(75vw);}
/* 1. Contêiner pai .top-bar */
.top-bar {
  display: flex;
  align-items: center;
  width: 100%;
  height: 60rpx; 
  padding-top: 100rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  box-sizing: content-box;
  flex-shrink: 0;
}
.top-bar-left,
.top-bar-right {
  flex: 1;
  display: flex;
  align-items: center;
}
.top-bar-center {
  flex: 2;
  text-align: center;
}
.top-bar-left {
  padding-left: 30rpx;
}
.top-bar-title {
  display: inline-block;
  font-family: Georgia, serif; 
  font-weight: 600;
  font-size: 40rpx;
}
.menu-icon {
  width: 48rpx;
  height: 48rpx;
}
.message-list {
  flex-grow: 1;
  padding: 30rpx 0; 
  overflow-y: auto;
}
.message-item {
  display: flex; 
  margin-bottom: 40rpx;
}
.user-row {
  justify-content: flex-end;
}
.message-bubble {
  max-width: 85%;
  padding: 22rpx 30rpx;
  border-radius: 30rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}
.ai-bubble {
  background-color: #ffffff;
  color: var(--text-primary);
  border-top-left-radius: 8rpx;
}
.user-bubble {
  background-color: var(--primary-orange);
  color: #ffffff;
  border-top-right-radius: 8rpx;
}
/* --- Estilo de animação de carregamento --- */
.loader {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(0, 0, 0, 0.1);
  border-top-color: var(--primary-orange);
  animation: spin 1s linear infinite;
}
@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
/* --- Área de Entrada e Login --- */
.input-area-minimalist {display: flex;align-items: center;padding: 20rpx 30rpx;background-color: #fff;border-top: 1rpx solid #f0f0f0;flex-shrink: 0;}
.input-field { flex-grow: 1; background-color: var(--bg-color); border-radius: 40rpx; padding: 18rpx 30rpx; height: 80rpx; box-sizing: border-box; }
.send-icon { width: 50rpx; height: 50rpx; margin-left: 20rpx; opacity: 0.5; }
.send-icon.active { opacity: 1; }
.login-prompt-container { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; padding: 40rpx; box-sizing: border-box; }
.login-avatar { width: 160rpx; height: 160rpx; border-radius: 50%; margin-bottom: 30rpx; }
.login-title { font-size: 40rpx; font-weight: bold; color: var(--text-primary); margin-bottom: 20rpx; }
.login-subtitle { font-size: 28rpx; color: var(--text-secondary); margin-bottom: 80rpx; }
.login-btn { background-color: var(--primary-orange); color: white; border-radius: 50rpx; padding: 0 60rpx; height: 90rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; white-space: nowrap; margin: 0; border: none; line-height: normal; }
.login-btn::after { border: none; }