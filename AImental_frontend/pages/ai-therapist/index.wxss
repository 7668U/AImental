/* pages/ai-therapist/index.wxss */

/* --- 1. Variáveis Globais e de Cor --- */
page {
  --primary-orange: #F2994A;
  --primary-orange-light: #FFF5EE;
  --text-primary: #333333;
  --text-secondary: #888888;
  --bg-color: #F9F7F3;
  --hover-color: #f0f0f0;
}
/* --- 2. Contêiner no Nível da Página --- */
.page-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  background-color: var(--bg-color);
  overflow: hidden;
}
/* --- 3. Estilos da Barra Lateral --- */
.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  width: 75vw;
  max-width: 560rpx;
  height: 100%;
  background-color: #ffffff;
  box-sizing: border-box;
  transform: translateX(-100%);
  transition: transform 0.3s ease-in-out;
  z-index: 100;
  border-right: 1rpx solid #EAEAEA;
  display: flex;
  flex-direction: column;
  padding: 180rpx 30rpx 40rpx; 
}
.sidebar-visible {
  transform: translateX(0);
}
.new-chat-btn {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: var(--primary-orange-light);
  border: 1rpx solid var(--primary-orange);
  border-radius: 20rpx;
  font-size: 30rpx;
  color: var(--primary-orange);
  font-weight: bold;
  margin: 20rpx 0;
  flex-shrink: 0;
}
.icon-plus { width: 36rpx; height: 36rpx; margin-right: 20rpx; }
.history-title-container {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  padding: 20rpx 10rpx;
}
.history-title-icon { width: 32rpx; height: 32rpx; margin-right: 15rpx; }

.history-list {
  flex-grow: 1;
  height: 100%;
}
.history-item-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  border-radius: 16rpx;
  transition: background-color 0.2s;
}
.history-item-wrapper:hover {
  background-color: var(--hover-color);
}
.history-item {
  flex-grow: 1;
  padding: 25rpx 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border-radius: 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.history-item.active {
  background-color: var(--primary-orange);
  color: #ffffff;
  font-weight: bold;
}
.history-item-options {
  flex-shrink: 0; 
  width: 40rpx;
  height: 40rpx;
  padding: 10rpx; 
  margin: 0 20rpx 0 10rpx;
  transition: opacity 0.2s, filter 0.2s;
  filter: grayscale(100%);
  opacity: 0.4;
}
.history-item.active + .history-item-options {
  filter: none;
  opacity: 1;
}

/* --- Conteúdo Principal --- */
.main-content {
  position: relative; 
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  transition: transform 0.3s ease-in-out;
}
.main-content-pushed {
  transform: translateX(75vw);
}

.top-bar {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 10;
  width: 100%;
  background-color: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  border-bottom: 1rpx solid #f0f0f0;
  box-sizing: border-box; 
}

.nav-bar-content {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.message-list {
  flex-grow: 1;
  overflow-y: auto;
  box-sizing: border-box;
  background-color: transparent;
  position: relative;
  z-index: 2;
  padding-bottom: 30rpx;
}
.top-bar-left,
.top-bar-right {
  flex: 1;
  display: flex;
  align-items: center;
}
.top-bar-center {
  flex: 2;
  text-align: center;
}
.top-bar-left {
  padding-left: 30rpx;
}
.top-bar-title {
  display: inline-block;
  font-family: Georgia, serif; 
  font-weight: 600;
  font-size: 40rpx;
}
.menu-icon {
  width: 48rpx;
  height: 48rpx;
}

/* --- [新增] 设置图标样式 --- */
.settings-icon {
  width: 48rpx;
  height: 48rpx;
  margin-left: 40rpx; /* 与菜单图标的间距 */
}

.message-item {
  display: flex; 
  margin-bottom: 40rpx;
}
.user-row {
  justify-content: flex-end;
}
.message-bubble {
  max-width: 85%;
  padding: 22rpx 30rpx;
  border-radius: 30rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}
.ai-bubble {
  background-color: #ffffff;
  color: var(--text-primary);
  border-top-left-radius: 8rpx;
}
.user-bubble {
  background-color: var(--primary-orange);
  color: #ffffff;
  border-top-right-radius: 8rpx;
}
.loader {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(0, 0, 0, 0.1);
  border-top-color: var(--primary-orange);
  animation: spin 1s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* --- Área de Entrada e Login --- */
.input-area-minimalist {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.input-field { 
  flex-grow: 1; 
  background-color: var(--bg-color); 
  border-radius: 40rpx; 
  padding: 18rpx 30rpx; 
  height: 80rpx; 
  box-sizing: border-box; 
}
.send-icon { 
  width: 50rpx; 
  height: 50rpx; 
  margin-left: 20rpx; 
  opacity: 0.5; 
}
.send-icon.active { 
  opacity: 1; 
}

.chat-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  pointer-events: none;
}
.chat-background-image {
  width: 450rpx;
  height: 450rpx;
  opacity: 0.8;
}

.login-prompt-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  text-align: center;
  padding: 40rpx;
  box-sizing: border-box;
}
.login-prompt-title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}
.login-prompt-subtitle {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 60rpx;
}
.login-btn {
  background-color: var(--primary-orange);
  color: white;
  padding: 20rpx 80rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
}
.login-btn:active {
  background-color: #e08a40;
}

/* --- [新增] 设置弹窗样式 --- */
.settings-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5); /* 半透明遮罩 */
  z-index: 200;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-content {
  width: 80vw;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 40rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.setting-text {
  display: flex;
  flex-direction: column;
  margin-right: 30rpx;
}

.setting-label {
  font-size: 30rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.setting-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.input-field::before {
  display: none !important;
  content: none !important;
}

.input-field::after {
  /* 为保险起见，也禁用::after伪元素 */
  display: none !important;
  content: none !important;
}

.message-list .message-item:first-child {
  margin-top: 100rpx; /* 您可以根据需要调整这个数值，比如 30rpx 或 50rpx */
}