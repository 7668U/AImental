/* pages/ai-therapist/index.wxss */

/* --- 1. Variáveis Globais e de Cor --- */
page {
  --primary-orange: #F2994A;
  --primary-orange-light: #FFF5EE;
  --text-primary: #333333;
  --text-secondary: #888888;
  --bg-color: #F9F7F3;
  --hover-color: #f0f0f0;
}
/* --- 2. Contêiner no Nível da Página --- */
.page-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  background-color: var(--bg-color);
  overflow: hidden;
}
/* --- 3. Estilos da Barra Lateral --- */
.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  width: 75vw;
  max-width: 560rpx;
  height: 100%;
  background-color: #ffffff;
  box-sizing: border-box;
  transform: translateX(-100%);
  transition: transform 0.3s ease-in-out;
  z-index: 100;
  border-right: 1rpx solid #EAEAEA;
  display: flex;
  flex-direction: column;
  padding: 180rpx 30rpx 40rpx; 
}
.sidebar-visible {
  transform: translateX(0);
}
.new-chat-btn {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: var(--primary-orange-light);
  border: 1rpx solid var(--primary-orange);
  border-radius: 20rpx;
  font-size: 30rpx;
  color: var(--primary-orange);
  font-weight: bold;
  margin: 20rpx 0;
  flex-shrink: 0;
}
.icon-plus { width: 36rpx; height: 36rpx; margin-right: 20rpx; }
.history-title-container {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  padding: 20rpx 10rpx;
}
.history-title-icon { width: 32rpx; height: 32rpx; margin-right: 15rpx; }

/* --- [SEÇÃO MODIFICADA] Início das alterações na lista de histórico --- */
.history-list {
  flex-grow: 1;
  height: 100%;
}
.history-item-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  border-radius: 16rpx;
  transition: background-color 0.2s;
}
/* Efeito de hover para todo o wrapper */
.history-item-wrapper:hover {
  background-color: var(--hover-color);
}
.history-item {
  flex-grow: 1; /* Permite que o item ocupe o espaço disponível */
  padding: 25rpx 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border-radius: 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  /* O margin-bottom foi movido para o wrapper */
}
.history-item.active {
  background-color: var(--primary-orange);
  color: #ffffff;
  font-weight: bold;
}
/* Estilo para o botão de opções (três pontos) */
.history-item-options {
  flex-shrink: 0; 
  width: 40rpx;
  height: 40rpx;
  padding: 10rpx; 
  margin: 0 20rpx 0 10rpx;
  transition: opacity 0.2s, filter 0.2s; /* [优化] 增加过渡效果 */

  /* [核心修改] 默认状态下，使用滤镜将橙色图标变为灰色，并降低不透明度 */
  filter: grayscale(100%);
  opacity: 0.4;
}

/* 当历史项被激活(选中)时，让选项按钮恢复原色 */
.history-item.active + .history-item-options {
  /* [核心修改] 选中状态下，移除所有滤镜，让图标恢复原始的橙色，并让它完全不透明 */
  filter: none;
  opacity: 1;
}
/* --- [SEÇÃO MODIFICADA] Fim das alterações --- */

/* --- Conteúdo Principal --- */
.main-content {
  /* 【修改】添加 position: relative，为背景图定位做准备 */
  position: relative; 
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  transition: transform 0.3s ease-in-out;
}
.main-content-pushed {
  transform: translateX(75vw);
}
/* index.wxss */

.top-bar {
  /* ...保留之前的 position, top, left, z-index, width, background等样式... */
  position: absolute;
  top: 0;
  left: 0;
  z-index: 10;
  width: 100%;
  background-color: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  border-bottom: 1rpx solid #f0f0f0;
  box-sizing: border-box; 
  
  /* 【删除】删除固定的 height 和 padding-top */
  /* height: 128rpx;  <-- 删除 */
  /* padding-top: 88rpx; <-- 删除 */
}

/* 【新增】为内容容器添加样式 */
.nav-bar-content {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.message-list {
  /* 占据父容器所有剩余空间 */
  flex-grow: 1;

  /* 内容超出时允许垂直滚动 */
  overflow-y: auto;
  
  /* 【关键】修正盒子模型，让 padding-top 被正确计算 */
  box-sizing: border-box;

  /* 背景透明，以显示后方的背景图 */
  background-color: transparent;

  /* 用于层级控制 */
  position: relative;
  z-index: 2;
  
  /* 在列表底部留出一些空白，避免消息紧贴输入框 */
  padding-bottom: 30rpx;

  /* 注意：这里没有 padding-top！
    因为 padding-top 是在 .wxml文件中通过 style 动态设置的，
    所以 .wxss 文件里一定不能有固定的 padding-top。
  */
}
.top-bar-left,
.top-bar-right {
  flex: 1;
  display: flex;
  align-items: center;
}
.top-bar-center {
  flex: 2;
  text-align: center;
}
.top-bar-left {
  padding-left: 30rpx;
}
.top-bar-title {
  display: inline-block;
  font-family: Georgia, serif; 
  font-weight: 600;
  font-size: 40rpx;
}
.menu-icon {
  width: 48rpx;
  height: 48rpx;
}



.message-item {
  display: flex; 
  margin-bottom: 40rpx;
}
.user-row {
  justify-content: flex-end;
}
.message-bubble {
  max-width: 85%;
  padding: 22rpx 30rpx;
  border-radius: 30rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}
.ai-bubble {
  background-color: #ffffff;
  color: var(--text-primary);
  border-top-left-radius: 8rpx;
}
.user-bubble {
  background-color: var(--primary-orange);
  color: #ffffff;
  border-top-right-radius: 8rpx;
}
.loader {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(0, 0, 0, 0.1);
  border-top-color: var(--primary-orange);
  animation: spin 1s linear infinite;
}
@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* --- Área de Entrada e Login --- */
.input-area-minimalist {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.input-field { 
  flex-grow: 1; 
  background-color: var(--bg-color); 
  border-radius: 40rpx; 
  padding: 18rpx 30rpx; 
  height: 80rpx; 
  box-sizing: border-box; 
}
.send-icon { 
  width: 50rpx; 
  height: 50rpx; 
  margin-left: 20rpx; 
  opacity: 0.5; 
}
.send-icon.active { 
  opacity: 1; 
}


/* --- 【新增】背景图片样式 --- */
.chat-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  pointer-events: none;
}
.chat-background-image {
  width: 450rpx;
  height: 450rpx;
  opacity: 0.8;
}