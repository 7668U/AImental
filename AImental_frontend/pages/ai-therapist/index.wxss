/* pages/ai-therapist/index.wxss (最终无头像版) */

/* --- 1. 全局与颜色变量 --- */
page {
  --primary-orange: #F2994A;
  --primary-orange-light: #FFF5EE;
  --text-primary: #333333;
  --text-secondary: #888888;
  --bg-color: #F7F7F7;
  --hover-color: #f0f0f0;
}
/* --- 2. 页面级容器 --- */
.page-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  background-color: var(--bg-color);
  overflow: hidden;
}
/* --- 3. 侧边栏样式 --- */
.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  width: 75vw;
  max-width: 560rpx;
  height: 100%;
  background-color: #ffffff;
  box-sizing: border-box;
  transform: translateX(-100%);
  transition: transform 0.3s ease-in-out;
  z-index: 100;
  border-right: 1rpx solid #EAEAEA;
  display: flex;
  flex-direction: column;
  padding: 100rpx 30rpx 40rpx; 
}
.sidebar-visible {
  transform: translateX(0);
}
.new-chat-btn {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: var(--primary-orange-light);
  border: 1rpx solid var(--primary-orange);
  border-radius: 20rpx;
  font-size: 30rpx;
  color: var(--primary-orange);
  font-weight: bold;
  margin: 20rpx 0;
  flex-shrink: 0;
}
.icon-plus { width: 36rpx; height: 36rpx; margin-right: 20rpx; }
.history-title-container {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  padding: 20rpx 10rpx;
}
.history-title-icon { width: 32rpx; height: 32rpx; margin-right: 15rpx; }
.history-list {
  flex-grow: 1;
  height: 100%;
}
.history-item {
  padding: 25rpx 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border-radius: 16rpx;
  margin-bottom: 10rpx;
  transition: background-color 0.2s, color 0.2s;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.history-item-hover {
  background-color: var(--hover-color) !important;
  color: var(--text-primary) !important;
}
.history-item.active {
  background-color: var(--primary-orange);
  color: #ffffff;
  font-weight: bold;
}

/* --- 主内容区 --- */
.main-content {width: 100%;height: 100%;display: flex;flex-direction: column;transition: transform 0.3s ease-in-out;}
.main-content-pushed {transform: translateX(75vw);}
/* 1. 父容器 .top-bar */
.top-bar {
  display: flex; /* 开启 Flex 布局 */
  align-items: center; /* 让左、中、右三个部分在垂直方向上居中 */
  width: 100%; /* 宽度占满 */
  
  /* 其他基础样式 */
  height: 60rpx; 
  padding-top: 100rpx; /* 适配刘海屏 */
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  box-sizing: content-box; /* 确保 padding 不会影响宽度计算 */
  flex-shrink: 0;
}

/* 2. 定义左、中、右三个部分 */
.top-bar-left,
.top-bar-right {
  flex: 1; /* (关键) 让左右两边各占一份空间 */
  display: flex;
  align-items: center;
}

.top-bar-center {
  flex: 2; /* 让中间区域占据更多空间，也可以设为1，效果类似 */
  text-align: center; /* (关键) 让标题在其中文本居中 */
}

/* 3. 左边部分的具体内容样式 */
.top-bar-left {
  padding-left: 30rpx; /* 给图标一个左边距 */
}

/* 4. 中间标题的字体样式 */
.top-bar-title {
  display: inline-block; /* 确保标题是行内块，以便居中 */
  font-family: 'Playfair Display', serif; /* 你选的艺术字体 */
  font-size: 38rpx;
  font-weight: 600;
}

/* 5. 图标样式 (不再需要任何定位) */
.menu-icon {
  width: 48rpx;
  height: 48rpx;
}

