<view class="page-container">
  <image class="page-bg" src="/images/ai-therapist/chat-bg-window.png" mode="aspectFill"></image>

  <view class="disclaimer-modal" wx:if="{{isDisclaimerVisible}}">
    <view class="disclaimer-content">
      <view class="disclaimer-title">温馨提示</view>
      <view class="disclaimer-text">
        AI心理伙伴旨在为您提供便捷的心理疏导与支持。但请注意，它的建议不能替代专业的心理医生、精神科医生或任何持牌医疗人员的诊断和治疗。
        <view class="disclaimer-text-paragraph">如果您正在经历严重的心理困扰，请务必寻求真人专业人士的帮助。</view>
      </view>
      <view class="disclaimer-button" bindtap="handleConfirmDisclaimer">我已知晓</view>
    </view>
  </view>

  <view class="settings-modal" wx:if="{{isSettingsVisible}}" catchtap="closeSettings">
    <view class="modal-content" catchtap="preventClose">
      <view class="modal-title">对话设置</view>
      <view class="setting-item">
        <view class="setting-text">
          <view class="setting-label">启用个性化对话</view>
          <view class="setting-desc">允许AI了解您近期的心情与测评结果，以更好地对话。</view>
        </view>
        <switch checked="{{allowAiReadData}}" bindchange="onAllowStatusChange" color="#ff6b16" />
      </view>
    </view>
  </view>

  <view class="sidebar {{isSidebarVisible ? 'sidebar-visible' : ''}}" catchtap="preventClose">
    <view class="sidebar-inner" style="padding-top: {{statusBarHeight}}px;">
      <view class="history-panel-top" style="height: {{navBarHeight}}px;">
        <view class="history-new-button" catchtap="startNewChat">
          <view class="history-plus"></view>
          <text>新建</text>
        </view>
        <view class="history-setting-button" catchtap="toggleSettings">
          <image class="history-setting-icon" src="/images/icons/setting.png"></image>
        </view>
      </view>
      <view class="sidebar-rule"></view>

      <scroll-view class="history-list" scroll-y="true" bounces="false">
        <block wx:if="{{chatHistory.length > 0}}">
          <view
            wx:for="{{chatHistory}}"
            wx:key="id"
            class="history-card {{item.id === activeChatId ? 'active' : ''}}"
            bindtap="switchChat"
            data-id="{{item.id}}"
          >
            <view class="history-card-main">
              <view class="history-card-top">
                <text class="history-card-title">{{item.title}}</text>
                <text class="history-card-date">{{item.displayDate}}</text>
              </view>
              <view class="history-card-preview">{{item.preview}}</view>
            </view>
            <view
              class="history-card-options"
              catchtap="showChatOptions"
              data-id="{{item.id}}"
              data-title="{{item.title}}"
            >
              <view class="history-option-dot"></view>
              <view class="history-option-dot"></view>
              <view class="history-option-dot"></view>
            </view>
          </view>
        </block>

        <view wx:else class="empty-history">
          <view class="empty-history-title">还没有对话</view>
          <view class="empty-history-desc">新建一次聊天后，会出现在这里。</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="main-content {{isSidebarVisible ? 'main-content-pushed' : ''}}" bindtap="closeSidebar">
    <block wx:if="{{isLoggedIn}}">
      <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
        <view class="nav-bar-content" style="height: {{navBarHeight}}px;">
          <view class="project-button" catchtap="toggleSidebar">
            <view class="history-clock"></view>
            <text>历史</text>
          </view>

          <view class="more-button" catchtap="toggleSettings">
            <view class="more-dot"></view>
            <view class="more-dot"></view>
            <view class="more-dot"></view>
          </view>
        </view>
      </view>

      <scroll-view
        class="message-list"
        scroll-y="true"
        scroll-into-view="{{latestMessageId}}"
        bounces="false"
      >
        <view id="chatTopAnchor" class="chat-top-anchor"></view>
        <view class="intro-row">
          <image class="intro-plant" src="/images/ai-therapist/plant-buddy.png" mode="aspectFit"></image>
          <view class="intro-pill">
            <text class="intro-spark">✦</text>
            <text class="intro-text">我是你的AI伙伴，随时在这里陪伴你</text>
            <text class="intro-heart">♥</text>
          </view>
        </view>

        <view
          wx:for="{{messages}}"
          wx:key="id"
          id="msg-{{item.id}}"
          class="message-row {{item.sender === 'user' ? 'user-row' : 'ai-row'}}"
        >
          <view class="message-stack {{item.sender === 'user' ? 'user-stack' : 'ai-stack'}}">
            <view class="message-bubble {{item.sender === 'user' ? 'user-bubble' : 'ai-bubble'}}">
              <view class="bubble-tail {{item.sender === 'user' ? 'user-tail' : 'ai-tail'}}"></view>
              <block wx:if="{{item.isLoading}}">
                <view class="loader"></view>
              </block>
              <block wx:else>
                <view class="content">{{item.text}}</view>
              </block>
            </view>
            <view wx:if="{{item.sender === 'user'}}" class="message-time">{{item.displayTime}}</view>
          </view>
          <image
            wx:if="{{item.sender === 'user'}}"
            class="message-plane"
            src="/images/ai-therapist/paper-plane.png"
            mode="aspectFit"
          ></image>
        </view>
      </scroll-view>

      <view class="scroll-top-button {{isEmojiPanelVisible ? 'scroll-top-button-hidden' : ''}}" catchtap="scrollToTop">
        <view class="scroll-top-arrow"></view>
      </view>

      <view class="emoji-panel {{isEmojiPanelVisible ? 'emoji-panel-visible' : ''}}" wx:if="{{isEmojiPanelVisible}}" catchtap="preventClose">
        <view
          wx:for="{{emojiOptions}}"
          wx:key="*this"
          class="emoji-option"
          data-emoji="{{item}}"
          catchtap="selectEmoji"
        >{{item}}</view>
      </view>

      <view class="input-dock">
        <view class="input-shell">
          <view class="input-smile" catchtap="toggleEmojiPanel">
            <view class="smile-eye smile-eye-left"></view>
            <view class="smile-eye smile-eye-right"></view>
            <view class="smile-mouth"></view>
          </view>
          <input
            class="input-field"
            type="text"
            value="{{inputValue}}"
            bindinput="onInput"
            placeholder="输入你想说的话..."
            placeholder-class="input-placeholder"
            confirm-type="send"
            bindconfirm="onSend"
          />
        </view>
        <view class="send-button {{inputValue ? 'active' : ''}}" bindtap="onSend">
          <text>发送</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="auth-shell">
        <login-prompt
          title="欢迎来到AI心理疗愈室"
          subtitle="请先登录，开启你的心灵对话之旅"
          bind:loginevent="handleLogin"
        />
      </view>
    </block>
  </view>
</view>
