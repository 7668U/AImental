<view class="page-container">
    <view class="disclaimer-modal" wx:if="{{isDisclaimerVisible}}">
        <view class="disclaimer-content">
            <view class="disclaimer-title">温馨提示</view>
            <view class="disclaimer-text">
                AI心理伙伴旨在为您提供便捷的心理疏导与支持。但请注意，它的建议不能替代专业的心理医生、精神科医生或任何持牌医疗人员的诊断和治疗。
                <view style="margin-top: 20rpx;">如果您正在经历严重的心理困扰，请务必寻求真人专业人士的帮助。</view>
            </view>
            <view class="disclaimer-button" bindtap="handleConfirmDisclaimer">我已知晓</view>
        </view>
    </view>

    <view class="settings-modal" wx:if="{{isSettingsVisible}}" catchtap="closeSettings">
        <view class="modal-content" catchtap="preventClose">
            <view class="modal-title">对话设置</view>
            <view class="setting-item">
                <view class="setting-text">
                    <view class="setting-label">启用个性化对话</view>
                    <view class="setting-desc">允许AI了解您近期的心情与测评结果，以更好地对话。</view>
                </view>
                <switch 
                    checked="{{allowAiReadData}}" 
                    bindchange="onAllowStatusChange"
                    color="#F2994A"
                />
            </view>
        </view>
    </view>

    <view class="sidebar {{ isSidebarVisible ? 'sidebar-visible' : '' }}">
        <view class="new-chat-btn" bindtap="startNewChat">
            <image src="/images/icons/plus.png" class="icon-plus"></image>
            <text>新建聊天</text>
        </view>
        <scroll-view class="history-list" scroll-y="true">
            <view 
                wx:for="{{chatHistory}}" 
                wx:key="id" 
                class="history-item-wrapper" >
                <view 
                    class="history-item {{item.id === activeChatId ? 'active' : ''}}"
                    bindtap="switchChat"
                    data-id="{{item.id}}"
                >
                    <text class="history-item-title">{{item.title}}</text>
                </view>
                
                <image 
                    src="/images/icons/more.png" 
                    class="history-item-options"
                    catchtap="showChatOptions"
                    data-id="{{item.id}}"
                    data-title="{{item.title}}"
                ></image>
                </view>
        </scroll-view>
    </view>

    <view class="main-content {{ isSidebarVisible ? 'main-content-pushed' : '' }}" bindtap="closeSidebar">

        <block wx:if="{{isLoggedIn}}">
            <view class="top-bar" style="height: {{totalNavBarHeight}}px;">
                <view class="nav-bar-content" style="margin-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
                    <view class="top-bar-left">
                        <image class="menu-icon" src="/images/icons/menu.png" catchtap="toggleSidebar"></image>
                        <image class="settings-icon" src="/images/icons/setting.png" catchtap="toggleSettings"></image>
                    </view>

                    <view class="top-bar-center">
                        </view>

                    <view class="top-bar-right"></view>
                </view>
            </view>
            
            <view class="chat-background">
                <image src="/images/background.png" class="chat-background-image"></image>
            </view>

            <scroll-view class="message-list" scroll-y="true" scroll-into-view="{{latestMessageId}}" style="padding-top: {{totalNavBarHeight}}px;" bounces="false"> 
                
                <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="message-item {{item.sender === 'user' ? 'user-row' : ''}}">

                    <view wx:if="{{item.sender === 'ai'}}" class="message-bubble ai-bubble">
                        <block wx:if="{{item.isLoading}}">
                            <view class="loader"></view>
                        </block>
                        <block wx:else>
                            <view class="content">{{item.text}}</view>
                        </block>
                    </view>

                    <view wx:if="{{item.sender === 'user'}}" class="message-bubble user-bubble">
                        <view class="content">{{item.text}}</view>
                    </view>
                    
                </view>
            </scroll-view>

            <view class="input-area-minimalist">
                <input 
                class="input-field" 
                type="text" 
                value="{{inputValue}}"
                bindinput="onInput"
                placeholder="" 
                confirm-type="send"
                bindconfirm="onSend"

                />
                <image 
                    class="send-icon {{inputValue ? 'active' : ''}}" 
                    src="/images/icons/send.png" 
                    bindtap="onSend"
                ></image>
            </view>
        </block>

        <block wx:else>
            <login-prompt 
              title="欢迎来到AI心理疗愈室"
              subtitle="请先登录，开启您的心灵对话之旅"
              bind:loginevent="handleLogin" 
            />
        </block>

    </view>
</view>