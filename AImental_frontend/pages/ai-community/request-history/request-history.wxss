/* pages/request-history/request-history.wxss */
.history-page {
  background-color: #1a1a2e; /* 统一的深色背景 */
  min-height: 100vh;
  padding: 0 0 40rpx;
  box-sizing: border-box;
}

.page-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #fff;
  padding: 80rpx 40rpx 40rpx;
  text-shadow: 0 0 10rpx rgba(0, 255, 255, 0.5);
}

.request-list {
  margin: 0 30rpx;
  border-radius: 20rpx;
}

.request-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1px solid rgba(0, 255, 255, 0.1); /* 赛博朋克风格分割线 */
  transition: background-color 0.2s;
}

.request-item:last-child {
  border-bottom: none;
}

.request-item:active {
  background-color: rgba(0, 255, 255, 0.05); /* 点击反馈 */
}

.item-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  border: 2px solid rgba(255, 255, 255, 0.5);
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #fff;
}

.item-description {
  font-size: 26rpx;
  color: #aaa;
  margin-top: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-date {
  font-size: 24rpx;
  color: #778;
  margin-top: 8rpx;
}

.item-status {
  margin-left: 30rpx;
}

.status-badge {
  font-size: 26rpx;
  padding: 10rpx 25rpx;
  border-radius: 30rpx;
  font-weight: bold;
}

/* 状态徽章的赛博朋克风格 */
.accepted {
  color: #0ff;
  background-color: rgba(0, 255, 255, 0.1);
  text-shadow: 0 0 5rpx #0ff;
}
.pending {
  color: #f0f;
  background-color: rgba(255, 0, 255, 0.1);
  text-shadow: 0 0 5rpx #f0f;
}
.rejected {
  color: #889;
  background-color: rgba(136, 136, 153, 0.1);
}

/* 空状态和加载状态 */
.empty-state, .loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 0;
}
.empty-icon {
  width: 180rpx;
  height: 180rpx;
  opacity: 0.3;
}
.empty-text, .loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #889;
}