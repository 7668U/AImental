/* pages/add-friends/wxss - 最终版 */

/* --- 页面整体布局 --- */
.page {
  width: 100vw;
  height: 100vh;
  background-color: #1a1a2e;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  position: relative;
}

.history-btn {
  position: absolute;
  top: calc(var(--status-bar-height, 20px) + 20rpx);
  right: 40rpx;
  padding: 10rpx;
  z-index: 10;
}
.history-btn__icon { width: 50rpx; height: 50rpx; filter: invert(1); }

.card-swiper {
  width: 100%;
  height: 1020rpx;
  overflow: visible;
}

.card-swiper-item {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

/* --- AI卡片基础样式 --- */
.ai-card {
  width: 640rpx;
  height: 980rpx;
  background-color: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 40rpx;
  transition: transform 0.4s ease-in-out, opacity 0.4s ease-in-out;
  opacity: 0;
  transform: scale(0.9);
}

/* --- 淡入淡出动画 --- */
.ai-card.active {
  opacity: 1;
  transform: scale(1);
}
.ai-card.inactive {
  opacity: 0;
  transform: scale(0.9);
  pointer-events: none;
}
.ai-card.disappearing {
  opacity: 0;
  transform: translateY(50%) scale(0.8);
}


/* --- 【布局核心修改】 --- */
.ai-card__header {
  display: flex;
  width: 100%;
  justify-content: space-between;
  align-items: center; /* 核心：让左右两边的内容垂直居中对齐 */
  flex-shrink: 0;
}

.ai-card__name {
  font-size: 60rpx;
  font-weight: bold;
  color: #1a1a1a;
  flex-shrink: 0; /* 核心：防止名字被压缩 */
  padding-right: 20rpx; /* 与右侧信息拉开一点距离 */
  white-space: nowrap; /* 核心：强制不换行 */
}

.ai-card__info-block {
  text-align: left;
}
.info-item { display: flex; margin-bottom: 10rpx; font-size: 26rpx; }
.info-item__label { color: #888; width: 90rpx; }
.info-item__value { color: #333; font-weight: 500; }
/* --- 布局修改结束 --- */


.ai-card__body {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-grow: 1;
}

.ai-card__avatar {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  border: 10rpx solid white;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.1);
  margin-bottom: 30rpx;
}

.ai-card__motto { font-size: 28rpx; color: #777; font-style: italic; margin-bottom: 30rpx; text-align: center; }
.ai-card__tags { display: flex; flex-wrap: wrap; justify-content: center; }
.tag { background-color: #f0f2f5; color: #5c6a7e; font-size: 24rpx; padding: 10rpx 25rpx; border-radius: 30rpx; margin: 10rpx; }

.ai-card__footer {
  width: 100%;
  display: flex;
  justify-content: center;
  flex-shrink: 0;
}

.add-btn-circular { width: 130rpx; height: 130rpx; border-radius: 50%; display: flex; justify-content: center; align-items: center; background-image: linear-gradient(45deg, #f0f, #0ff); box-shadow: 0 0 20rpx rgba(255, 0, 255, 0.6), 0 0 20rpx rgba(0, 255, 255, 0.6); transition: all 0.2s ease-in-out; }
.add-btn-circular:active { transform: scale(0.9); box-shadow: 0 0 10rpx rgba(255, 0, 255, 0.8), 0 0 10rpx rgba(0, 255, 255, 0.8); }
.add-btn__plus { width: 60rpx; height: 60rpx; position: relative; }
.add-btn__plus::before, .add-btn__plus::after { content: ''; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); background-color: #1a1a2e; border-radius: 4rpx; }
.add-btn__plus::before { width: 8rpx; height: 100%; }
.add-btn__plus::after { width: 100%; height: 8rpx; }

.bottom-hint-text { position: absolute; bottom: 6vh; left: 0; right: 0; text-align: center; font-size: 32rpx; font-family: 'PingFang SC', 'Helvetica Neue', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif; font-weight: bold; color: rgba(255, 255, 255, 0.6); letter-spacing: 2rpx; }

/* 自定义赛博朋克弹窗样式 (保持不变) */
.modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(26, 26, 46, 0.7); display: flex; justify-content: center; align-items: center; z-index: 1000; backdrop-filter: blur(10rpx); opacity: 0; transition: opacity 0.3s ease; pointer-events: none; }
.modal-overlay.visible { opacity: 1; pointer-events: auto; }
.modal-content { width: 80vw; background-color: #1e1e3f; border-radius: 30rpx; padding: 50rpx; box-sizing: border-box; border: 1px solid rgba(0, 255, 255, 0.5); box-shadow: 0 0 40rpx rgba(0, 255, 255, 0.3); display: flex; flex-direction: column; align-items: center; transform: scale(0.9); transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
.modal-overlay.visible .modal-content { transform: scale(1); }
.modal-title { font-size: 36rpx; font-weight: bold; color: #fff; margin-bottom: 20rpx; text-shadow: 0 0 10rpx rgba(0, 255, 255, 0.7); }
.modal-input { width: 100%; height: 80rpx; background-color: rgba(0, 0, 0, 0.3); border-radius: 15rpx; margin-top: 20rpx; padding: 0 20rpx; box-sizing: border-box; color: #fff; font-size: 28rpx; border: 1px solid rgba(0, 255, 255, 0.3); text-align: center; }
.modal-actions { display: flex; width: 100%; margin-top: 50rpx; justify-content: space-between; }
/* 修改后 */
.modal-button {
  width: 48%;
  height: 80rpx;
  border-radius: 15rpx;
  font-size: 30rpx;
  font-weight: bold;
  transition: all 0.2s ease;
  
  /* --- 核心修改：使用Flexbox居中 --- */
  display: flex;
  justify-content: center; /* 水平居中 */
  align-items: center;    /* 垂直居中 */
  /* 不再需要 line-height 和 text-align 来居中 */
}
.modal-button.cancel { background-color: transparent; color: #889; border: 1px solid #445; }
.modal-button.confirm { background-image: linear-gradient(45deg, #f0f, #0ff); color: #fff; }
.modal-button:active { transform: scale(0.95); }