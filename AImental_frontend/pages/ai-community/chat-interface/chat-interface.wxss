/* pages/ai-community/chat-interface/chat-interface.wxss */

/* 【核心修改】让顶层容器负责处理边距 */
.container {
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  box-sizing: border-box; /* 确保 padding-top 在 100vh 内部计算 */
}

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100%; 
  background-color: #F9F7F3; 
  /* 【核心修改】移除这里的 box-sizing，因为它不再需要处理 padding */
}

/* =========================================== */
/* 1. 动态自定义导航栏 (采用新版样式) */
/* =========================================== */
.custom-nav-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background-color: #F9F7F3; /* 使用页面背景色 */
  border-bottom: 1rpx solid #e0e0e0;
}
.custom-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}
.nav-left, .nav-right {
  display: flex;
  align-items: center;
  /* 【核心】设置一个固定的、对称的宽度 */
  width: 90rpx;
}
.nav-left {
  justify-content: center; /* 居中放置返回图标 */
}
.nav-right {
  /* 空的占位符 */
}
.nav-center {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden; /* 防止内容溢出 */
}

/* 【修改】移除旧的 .custom-nav-bar 样式 */

/* 返回图标样式 */
.back-icon { 
  width: 48rpx; 
  height: 48rpx;
}

/* 标题容器，移除用于手动居中的 margin */
.nav-title-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 【移除】margin-right: 68rpx; */
}
.nav-title { 
  font-size: 34rpx; 
  font-weight: 500; 
  color: #000; 
}
.nav-status { 
  font-size: 24rpx; 
  color: #888; 
}

/* =========================================== */
/* 2. 页面主体内容 (样式基本保持不变) */
/* =========================================== */
.message-list {
  flex: 1; /* 占据剩余所有空间 */
  overflow-y: auto;
  box-sizing: border-box;
}
.message-item { padding: 0 20rpx; margin-top: 30rpx; }
.message-row { display: flex; width: 100%; align-items: flex-start; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 10rpx; flex-shrink: 0; }
.bubble-wrapper { display: flex; flex-direction: column; }
.bubble { max-width: calc(100vw - 220rpx); padding: 20rpx; border-radius: 10rpx; font-size: 32rpx; line-height: 1.5; word-wrap: break-word; word-break: break-all; }
.message-time-ai, .message-time-user { font-size: 22rpx; color: #aaa; margin-top: 8rpx; }
.message-row.ai { justify-content: flex-start; }
.message-row.ai .avatar { margin-right: 20rpx; }
.message-row.ai .bubble { background-color: #ffffff; }
.message-row.ai .message-time-ai { align-self: flex-start; }
.message-row.user { justify-content: flex-end; }
.message-row.user .avatar { margin-left: 20rpx; }
.message-row.user .bubble { background-color: #FFB643; } 
.message-row.user .message-time-user { align-self: flex-end; }
.message-status { display: flex; justify-content: flex-end; align-items: center; align-self: flex-end; margin-right: 10rpx; margin-bottom: 10rpx; height: 40rpx; width: 120rpx; }
.status-unit { display: flex; align-items: center; }
.status-text { font-size: 24rpx; color: #aaa; margin-left: 8rpx; }
.sent-icon, .read-icon { width: 32rpx; height: 32rpx; }
.sending-icon { width: 30rpx; height: 30rpx; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.failed-icon { width: 30rpx; height: 30rpx; }


/* --- 【核心修改区域】底部输入栏 --- */
.input-bar-wrapper {
  flex-shrink: 0;
  background-color: #F1EEE9; 
  padding: 20rpx 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #ddd;
}
.input-bar { 
  display: flex; 
  align-items: center; 
  width: 100%; 
}
.input-field {
  flex: 1;
  background-color: #ffffff;
  height: 72rpx; 
  line-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
}

/* 【核心修改】针对 <view> 标签的按钮样式 */
.send-btn {
  /* 在这里自由修改为您想要的宽度，现在它一定会生效 */
  width: 100rpx; 
  height: 72rpx;
  margin-left: 20rpx;
  background-color: #FFB643;
  color: white;
  font-size: 28rpx;
  border-radius: 10rpx;

  /* 新增：让文字在 view 中水平垂直居中 */
  display: flex;
  justify-content: center;
  align-items: center;
  
  /* 新增：防止内容被意外压缩 */
  flex-shrink: 0; 
}

/* 【核心修改】将 [disabled] 属性选择器改为 .disabled 类选择器 */
.send-btn.disabled { 
  background-color: #FFDDAA;
  color: #fff; 
}

/* (不再需要 .send-btn::after 的修复代码，因为 view 没有这个伪元素) */