<view class="community-page">
  <view class="custom-nav-wrapper" style="padding-top: {{statusBarHeight}}px;">
    <view class="custom-nav" style="height: {{navBarHeight}}px;"></view>
  </view>

  <scroll-view
    class="community-scroll"
    scroll-y="true"
    enhanced="true"
    show-scrollbar="false"
    refresher-enabled="true"
    refresher-background="#fff8f1"
    refresher-triggered="{{isRefreshing}}"
    bindrefresherrefresh="onPullDownRefresh"
  >
    <view
      class="community-hero"
      style="padding-top: {{totalHeaderHeight}}px;"
    >
      <image
        class="community-hero-bg"
        src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/community-premium/community-hero-sunroom.jpg"
        mode="aspectFill"
      ></image>
      <image
        class="hero-leaf-accent"
        src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/community-premium/leaf-sparkle.png"
        mode="aspectFit"
      ></image>

      <view class="hero-copy">
        <view class="hero-title">心灵社区</view>
        <view class="hero-subtitle">
          <text>和各种不同的NPC诉说心事，看看谁最懂你的感受吧</text>
        </view>
      </view>
    </view>

    <view class="community-body">
      <view class="refresh-notice" wx:if="{{isError && chatList.length}}" bindtap="retryGetChatList">
        <view class="refresh-notice-dot"></view>
        <text>刷新没有成功，轻触再试一次</text>
      </view>

      <block wx:if="{{isLoading && !chatList.length}}">
        <view class="skeleton-card" wx:for="{{skeletonItems}}" wx:key="*this">
          <view class="skeleton-avatar skeleton-shimmer"></view>
          <view class="skeleton-copy">
            <view class="skeleton-line skeleton-line-title skeleton-shimmer"></view>
            <view class="skeleton-line skeleton-line-message skeleton-shimmer"></view>
            <view class="skeleton-line skeleton-line-meta skeleton-shimmer"></view>
          </view>
        </view>
      </block>

      <view class="state-panel state-panel-error" wx:elif="{{isError && !chatList.length}}">
        <view class="state-icon">!</view>
        <view class="state-title">社区暂时没有回应</view>
        <view class="state-description">可能只是网络走神了一会儿，请稍后再试。</view>
        <view class="state-action" bindtap="retryGetChatList">重新连接</view>
      </view>

      <block wx:elif="{{chatList.length}}">
        <view
          class="character-card {{item.unread ? 'character-card-unread' : ''}}"
          wx:for="{{chatList}}"
          wx:key="id"
          bindtap="navigateToChat"
          data-ai="{{item}}"
        >
          <view class="avatar-container">
            <image class="avatar" src="{{item.avatar}}" mode="aspectFill"></image>
            <view class="unread-dot" wx:if="{{item.unread}}"></view>
          </view>

          <view class="character-info">
            <view class="character-topline">
              <view class="name-group">
                <text class="character-name">{{item.name}}</text>
              </view>
              <text class="character-time">{{item.time}}</text>
            </view>

            <view class="last-message">{{item.lastMessage}}</view>

            <view class="character-meta">
              <view class="presence presence-status">
                <view class="presence-dot"></view>
                <text>{{item.presenceLabel}}</text>
              </view>
              <view class="affinity-meta">
                <image
                  class="affinity-icon"
                  src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/community-premium/affinity-heart.png"
                  mode="aspectFit"
                ></image>
                <text>{{item.affinityScoreText}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>

      <view class="state-panel" wx:else>
        <image
          class="state-illustration"
          src="https://assets.feelyourself.cn/miniprogram/assets/v1/images/community-redesign/community-empty-conversation.png"
          mode="aspectFit"
        ></image>
        <view class="state-title">伙伴们还在来的路上</view>
        <view class="state-description">下拉刷新看看，也许下一次就会遇见新的故事。</view>
      </view>

    </view>
  </scroll-view>
</view>

<view class="community-guide-modal" wx:if="{{showCommunityGuide}}" catchtouchmove="preventCommunityGuideClose">
  <view class="community-guide-content" catchtap="preventCommunityGuideClose">
    <image class="community-guide-icon" src="{{communityGuideIcon}}" mode="aspectFit"></image>
    <view class="community-guide-body">
      <view class="community-guide-title">温馨提示</view>
      <view class="community-guide-text">
        <view class="community-guide-paragraph">欢迎来到心灵社区。这里的 NPC 都是 AI 虚拟角色，并非真实用户。但我们希望追求更真实的情感交互，所以这里的 NPC 都有自己的性格、记忆、生活节奏，也会在每天经历新的故事。</view>
        <view class="community-guide-paragraph">每个 NPC 都有自己的生活轨迹。你们的一次问候、一段倾诉、一次认真回应，都可能让关系发生细微变化。好感度记录的不是冷冰冰的分数，而是你们从陌生到熟悉、从试探到信任的过程。</view>
        <view class="community-guide-paragraph">我们会持续努力，让这里的角色拥有更鲜活的灵魂，也让每一次互动更真实、更温柔。希望你能在这里找到让你舒适的倾诉和交流的方式，也收获一点被理解、被陪伴的感觉。</view>
      </view>
      <view class="community-guide-button" bindtap="handleConfirmCommunityGuide">开始探索</view>
    </view>
  </view>
</view>

<privacy-consent
  visible="{{privacyVisible}}"
  bind:confirm="onPrivacyConfirm"
  bind:reject="onPrivacyReject"
/>
