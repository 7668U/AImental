/* pages/ai-community/chat-list/chat-list.wxss */

page {
  background-color: #F9F7F3;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page-container {
  height: 100vh;
  width: 100vw;
  overflow: hidden;
}

/* =========================================== */
/* 1. 动态自定义导航栏 (采用新版样式) */
/* =========================================== */

/* 【移除】所有 .top-bar, .nav-bar-content, .top-bar-* 等旧样式 */

/* 【新增】来自参考代码的导航栏样式结构 */
.custom-nav-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  /* 保留你原有的背景模糊效果 */
  background-color: #F9F7F3(240, 225, 195, 0.85);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-bottom: 5rpx solid rgba(0, 0, 0, 0.04);
}
.custom-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}
.nav-left, .nav-right {
  display: flex;
  align-items: center;
  /* 【核心】设置一个固定的、对称的宽度 */
  width: 90rpx; 
}
.nav-left {
  justify-content: flex-start;
  /* 保留你原有的边距 */
  padding-left: 30rpx;
  box-sizing: border-box;
}
.nav-right {
  /* 这个是空的，但必须存在且宽度与左边一致，以保证标题居中 */
  justify-content: flex-end;
}
.nav-center {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}
.nav-title {
  /* 保留你原有的标题字体样式 */
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}
.action-icon {
  width: 44rpx;
  height: 44rpx;
}

/* =========================================== */
/* 2. 好友聊天列表 (这部分样式保持不变) */
/* =========================================== */
.list-container {
  height: 100vh;
  width: 100%;
  box-sizing: border-box;
  background-color: #F9F7F3;
}

.chat-item {
  display: flex;
  padding: 25rpx 30rpx;
  align-items: center;
  transition: background-color 0.2s;
  border-bottom: 1rpx solid #F1EEE9;
  padding-left: 155rpx;
  padding-right: 30rpx;
  background-color: #f5ecd7; 
}

.chat-item:active {
  background-color: #fad89f;
}

.chat-item:last-child {
  border-bottom: none;
}

.avatar-container {
  position: relative;
  margin-left: -125rpx;
  margin-right: 25rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background-color: #eee;
}

.unread-dot {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 20rpx;
  height: 20rpx;
  background-color: #fa5151;
  border-radius: 50%;
  border: 4rpx solid #F9F7F3;
}

.info-container {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 120rpx;
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.name {
  font-size: 32rpx;
  color: #333;
}

.time {
  font-size: 24rpx;
  color: #aaa;
}

.last-message {
  font-size: 28rpx;
  color: #888;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 250rpx;
  opacity: 0.6;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #aaa;
}