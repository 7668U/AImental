/* pages/ai-community/main/main.wxss */

page {
  /* 设置一个类似微信的灰色背景，让白色卡片区域更突出 */
  background-color: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page-container {
  height: 100vh;
  width: 100vw;
  overflow: hidden; /* 防止子元素溢出 */
}

/* =========================================== */
/* 1. 动态自定义导航栏 (学习自您的范例) */
/* =========================================== */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  
  /* 核心：半透明背景 + 背景模糊效果，非常有质感 */
  background-color: rgba(247, 247, 247, 0.85);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px); /* 兼容旧版 Safari */
  
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.nav-bar-content {
  width: 100%;
  display: flex;
  align-items: flex-end; /* 【核心改动】从“居中”改为“底部对齐” */
  justify-content: space-between;
  padding: 0 30rpx;
  /* 【新增】增加一个下内边距，避免文字和图标完全贴死在分割线上 */
  padding-bottom: 16rpx; 
  box-sizing: border-box;
}

/* 三段式布局，让标题居中，两侧按钮对齐 */
.top-bar-left, .top-bar-right {
  flex: 1;
  display: flex;
  align-items: center;
}
.top-bar-center {
  flex: 2; /* 中间区域更宽，避免标题过长被压缩 */
  text-align: center;
}
.top-bar-right {
  justify-content: flex-end; /* 右侧按钮靠右 */
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
}

.action-icon {
  width: 44rpx;
  height: 44rpx;
}

/* =========================================== */
/* 2. 好友聊天列表 */
/* =========================================== */
.list-container {
  height: 100vh;
  width: 100%;
  box-sizing: border-box;
  background-color: #fff; /* 列表区域是白色背景 */
}

.chat-item {
  display: flex;
  padding: 25rpx 30rpx;
  align-items: center;
  transition: background-color 0.2s;
}

.chat-item:active {
  background-color: #f0f0f0;
}

.avatar-container {
  position: relative;
  margin-right: 25rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background-color: #eee;
}

.unread-dot {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 20rpx;
  height: 20rpx;
  background-color: #fa5151; /* 微信红点颜色 */
  border-radius: 50%;
  border: 4rpx solid #fff; /* 白色描边，让红点更突出 */
}

.info-container {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-bottom: 1rpx solid #f0f0f0;
  padding: 10rpx 0;
  height: 120rpx;
}

.chat-item:last-child .info-container {
  border-bottom: none;
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.name {
  font-size: 32rpx;
  color: #333;
}

.time {
  font-size: 24rpx;
  color: #aaa;
}

.last-message {
  font-size: 28rpx;
  color: #888;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 列表为空时的样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 250rpx;
  opacity: 0.6;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #aaa;
}