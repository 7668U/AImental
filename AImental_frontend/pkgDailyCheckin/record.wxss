page {
  min-height: 100%;
  background: linear-gradient(180deg, #fffaf3 0%, #f8efe6 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  color: #5b3a28;
}

.page-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.record-nav {
  flex-shrink: 0;
  box-sizing: border-box;
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.nav-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-title {
  position: absolute;
  left: 160rpx;
  right: 160rpx;
  top: 50%;
  transform: translateY(-50%);
  text-align: center;
  font-size: 34rpx;
  font-weight: 800;
  color: #5a3725;
  letter-spacing: 0;
}

.nav-button {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 24rpx rgba(150, 96, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-back {
  font-size: 66rpx;
  line-height: 1;
  color: #2f2d2a;
  padding-bottom: 8rpx;
  box-sizing: border-box;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.nav-icon {
  width: 38rpx;
  height: 38rpx;
}

.nav-more {
  color: #8d5b3f;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.record-scroll {
  flex: 1;
  min-height: 0;
}

.record-content {
  padding: 26rpx 32rpx 160rpx;
  box-sizing: border-box;
}

.hero-card {
  position: relative;
  min-height: 188rpx;
  border-radius: 28rpx;
  padding: 40rpx 34rpx;
  margin-bottom: 28rpx;
  background: linear-gradient(110deg, #fff8eb 0%, #fff1dd 62%, #ffe5ca 100%);
  border: 1rpx solid rgba(239, 198, 146, 0.48);
  box-shadow: 0 12rpx 32rpx rgba(190, 118, 46, 0.08);
  overflow: hidden;
  box-sizing: border-box;
}

.hero-copy {
  position: relative;
  z-index: 2;
  max-width: 430rpx;
}

.hero-title {
  font-size: 58rpx;
  line-height: 1.08;
  font-weight: 900;
  color: #6a432c;
  letter-spacing: 0;
}

.hero-subtitle {
  margin-top: 20rpx;
  font-size: 27rpx;
  line-height: 1.35;
  color: #8d6d58;
  letter-spacing: 0;
}

.hero-art {
  position: absolute;
  right: 10rpx;
  bottom: -6rpx;
  width: 360rpx;
  height: 170rpx;
  z-index: 1;
}

.section-card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  padding: 30rpx 28rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(178, 126, 77, 0.08);
  box-sizing: border-box;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.status-header {
  justify-content: space-between;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  min-width: 0;
}

.section-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 33rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #64412f;
  letter-spacing: 0;
}

.mood-section {
  padding-left: 22rpx;
  padding-right: 22rpx;
}

.status-section {
  padding-left: 22rpx;
  padding-right: 22rpx;
}

.mood-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  column-gap: 8rpx;
  row-gap: 14rpx;
}

.status-hint {
  font-size: 22rpx;
  color: #b88652;
}

.mood-card {
  position: relative;
  height: 122rpx;
  border-radius: 20rpx;
  background: #fbf6f0;
  border: 3rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  column-gap: 8rpx;
  row-gap: 14rpx;
}

.status-card {
  position: relative;
  height: 122rpx;
  border-radius: 20rpx;
  background: #fbf6f0;
  border: 3rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
}

.status-card.selected {
  border-color: #ff9d16;
  background: #fffaf3;
  box-shadow: 0 8rpx 20rpx rgba(255, 157, 22, 0.16);
}

.status-card:active {
  transform: scale(0.96);
}

.status-card.disabled {
  pointer-events: none;
  opacity: 0.62;
}

.status-card-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.status-card-name {
  margin-top: 5rpx;
  font-size: 22rpx;
  line-height: 1.15;
  color: #704c38;
  text-align: center;
  letter-spacing: 0;
}

.status-check {
  right: -4rpx;
  bottom: -4rpx;
  width: 30rpx;
  height: 30rpx;
  font-size: 21rpx;
  line-height: 30rpx;
}

.mood-card.selected {
  border-color: #ff9d16;
  background: #fffaf3;
  box-shadow: 0 8rpx 20rpx rgba(255, 157, 22, 0.16);
}

.mood-card:active {
  transform: scale(0.96);
}

.mood-card.disabled {
  pointer-events: none;
  opacity: 0.62;
}

.mood-card-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.mood-card-name {
  margin-top: 5rpx;
  font-size: 22rpx;
  line-height: 1.15;
  color: #704c38;
  text-align: center;
  letter-spacing: 0;
}

.mood-check {
  right: -4rpx;
  bottom: -4rpx;
  width: 30rpx;
  height: 30rpx;
  font-size: 21rpx;
  line-height: 30rpx;
}


.selected-check,
.color-check {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #ff9d16;
  color: #fff;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
  font-weight: 800;
  box-shadow: 0 4rpx 10rpx rgba(255, 157, 22, 0.28);
}

.color-section {
  padding-left: 22rpx;
  padding-right: 22rpx;
  padding-bottom: 28rpx;
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  column-gap: 10rpx;
  row-gap: 14rpx;
}

.color-swatch {
  position: relative;
  height: 82rpx;
  border-radius: 22rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid transparent;
  background: #fbf6f0;
  box-sizing: border-box;
}

.color-swatch.selected {
  border-color: #ff9d16;
  background: #fffaf3;
  box-shadow: 0 8rpx 20rpx rgba(255, 157, 22, 0.16);
}

.color-swatch.disabled {
  pointer-events: none;
  opacity: 0.62;
}

.color-swatch-dot {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  box-shadow: inset 0 -4rpx 8rpx rgba(120, 75, 40, 0.12);
}

.color-selected-info {
  margin-top: 18rpx;
  min-height: 58rpx;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  background: #fff8ef;
  border: 1rpx solid #f1dfc9;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.color-selected-name {
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #6a432c;
  text-align: center;
}

.journal-card {
  padding: 30rpx 28rpx;
  margin-bottom: 18rpx;
}

.journal-header {
  margin-bottom: 18rpx;
}

.journal-title-wrap {
  margin-bottom: 20rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.meta-chip {
  min-width: 0;
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  border: 1rpx solid #efdcca;
  background: rgba(255, 255, 255, 0.74);
  color: #80614f;
  font-size: 24rpx;
  line-height: 54rpx;
  box-sizing: border-box;
}

.location-chip {
  max-width: 330rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.textarea-wrap {
  position: relative;
  min-height: 210rpx;
  border-radius: 20rpx;
  border: 1rpx solid #eaded4;
  background: rgba(255, 255, 255, 0.78);
  padding: 24rpx 24rpx 44rpx;
  box-sizing: border-box;
}

.text-area {
  width: 100%;
  min-height: 154rpx;
  height: 154rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #604638;
  letter-spacing: 0;
}

.text-area::placeholder {
  color: #b7aaa1;
}

.text-count {
  position: absolute;
  right: 24rpx;
  bottom: 18rpx;
  color: #b7aaa1;
  font-size: 24rpx;
}

.journal-tools {
  margin-top: 22rpx;
}

.photo-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.photo-title {
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #6a432c;
}

.photo-count {
  font-size: 23rpx;
  line-height: 1.2;
  color: #b88652;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.photo-item,
.image-uploader {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 18rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.photo-item {
  background: #fff8ef;
  box-shadow: inset 0 0 0 1rpx #f0dfce;
}

.photo-item image {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-item.disabled {
  pointer-events: none;
  opacity: 0.82;
}

.photo-remove {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(60, 43, 32, 0.62);
  color: #fff;
  font-size: 30rpx;
  line-height: 30rpx;
  text-align: center;
  font-weight: 700;
  z-index: 2;
}

.image-uploader {
  border: 2rpx dashed #eac7ad;
  background: rgba(255, 251, 247, 0.88);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #936d56;
}

.plus-icon {
  font-size: 50rpx;
  line-height: 1;
  color: #8f644c;
}

.upload-text {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8f644c;
}

.upload-hint {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #b99a86;
}


.footer {
  flex-shrink: 0;
  padding: 18rpx 56rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(248, 239, 230, 0) 0%, #f8efe6 32%, #f8efe6 100%);
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  height: 78rpx;
  padding: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb53c 0%, #ff6f16 100%);
  color: #fff;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0;
  box-shadow: 0 14rpx 28rpx rgba(255, 127, 24, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #ddd1c8;
  color: #8b7d74;
  box-shadow: none;
}
