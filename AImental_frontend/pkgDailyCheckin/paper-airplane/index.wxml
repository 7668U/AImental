<!-- pages/daily-checkin/paper-airplane/index.wxml -->
<view class="page-container">
  <!-- 背景元素 -->
  <view class="sky-bg">
    <!-- 云朵 -->
    <image src="/images/cloud.png" class="cloud cloud-1"></image>
  </view>

  <!-- 纸飞机容器 -->
  <view class="airplane-container">
    <!-- 动态生成的纸飞机 -->
    <image wx:for="{{airplanes}}" wx:key="id"
           src="/images/paper_airplane.png"
           class="airplane"
           style="top: {{item.top}}%; left: {{item.left}}%; transform: rotate({{item.rotate}}deg);"
           data-id="{{item.id}}"
           bindtap="onAirplaneTap">
    </image>
  </view>

  <!-- 底部操作区: 修改为 button 元素以确保点击事件的响应 -->
  <view class="actions-bar">
    <button class="throw-button-container" bindtap="onThrowClick">
      <image src="/images/send_airplane.png" class="throw-button-img"></image>
      <text class="throw-button-text">扔一个</text>
    </button>
  </view>

  <!-- 写纸条的弹窗 -->
  <view class="modal-mask" wx:if="{{showWriteModal}}" bindtap="hideModals"></view>
  <view class="modal-content write-modal" wx:if="{{showWriteModal}}">
    <!-- 弹窗右上角的取消按钮 -->
    <image src="/images/cancle.png" class="modal-cancel-btn" bindtap="hideModals"></image>
    
    <textarea class="message-input" placeholder="把你的心事写在纸上，然后让它飞远吧..." maxlength="500" value="{{newMessage}}" bindinput="onMessageInput"></textarea>
    <view class="modal-button" bindtap="sendAirplane">飞出去</view>
  </view>

  <!-- 查看纸条的弹窗 -->
  <view class="modal-mask" wx:if="{{showReadModal}}" bindtap="hideModals"></view>
  <view class="modal-content read-modal" wx:if="{{showReadModal}}">
     <!-- 弹窗右上角的取消按钮 -->
    <image src="/images/cancle.png" class="modal-cancel-btn" bindtap="hideModals"></image>
    
    <scroll-view scroll-y="true" class="message-display">
      <text>{{openedMessage}}</text>
    </scroll-view>
    <view class="modal-button" bindtap="hideModals">收起来</view>
  </view>

</view>
