page {
  min-height: 100%;
  background: linear-gradient(180deg, #fffaf3 0%, #f6efe8 100%);
  color: #5b3a28;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

.page-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.trajectory-nav {
  flex-shrink: 0;
  padding-left: 32rpx;
  padding-right: 32rpx;
  box-sizing: border-box;
}

.nav-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-title {
  position: absolute;
  left: 160rpx;
  right: 160rpx;
  top: 50%;
  transform: translateY(-50%);
  text-align: center;
  font-size: 34rpx;
  font-weight: 800;
  color: #5a3725;
}

.nav-button {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 24rpx rgba(150, 96, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-back {
  font-size: 66rpx;
  line-height: 1;
  color: #2f2d2a;
  padding-bottom: 8rpx;
  box-sizing: border-box;
}

.nav-action {
  min-width: 132rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fff1dc;
  color: #c96a18;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-align: center;
  box-sizing: border-box;
}

.trajectory-scroll {
  flex: 1;
  min-height: 0;
}

.trajectory-content {
  padding: 24rpx 32rpx 70rpx;
  box-sizing: border-box;
}

.date-header {
  margin-bottom: 24rpx;
}

.date-title {
  font-size: 48rpx;
  line-height: 1.12;
  font-weight: 900;
  color: #5d3a25;
}

.date-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.35;
  color: #8a6a51;
}

.sequence-section,
.empty-card,
.review-section {
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid #f0dfce;
  box-shadow: 0 10rpx 28rpx rgba(178, 126, 77, 0.08);
  box-sizing: border-box;
}

.sequence-scroll {
  width: 100%;
  white-space: nowrap;
}

.sequence-list {
  display: inline-flex;
  gap: 22rpx;
  min-width: 100%;
}

.sequence-node {
  width: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sequence-icon {
  width: 74rpx;
  height: 74rpx;
  border-radius: 24rpx;
  background: #fffaf3;
  border: 2rpx solid #f1dfc9;
  box-sizing: border-box;
}

.review-node .sequence-icon {
  background: #fff1dc;
  border-color: #ffbd6a;
}

.sequence-time {
  margin-top: 9rpx;
  color: #886b58;
  font-size: 22rpx;
  line-height: 1.2;
}

.empty-card {
  margin-top: 24rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5d3a25;
}

.empty-text {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.45;
  color: #8a6a51;
}

.empty-button {
  width: 220rpx;
  height: 64rpx;
  margin: 24rpx auto 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9639 0%, #ff6418 100%);
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 64rpx;
}

.timeline-section {
  margin-top: 30rpx;
}

.section-title {
  font-size: 34rpx;
  line-height: 1.18;
  font-weight: 900;
  color: #5d3a25;
}

.trend-copy {
  margin-top: 12rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #fff6eb;
  color: #8a6a51;
  font-size: 25rpx;
  line-height: 1.45;
}

.timeline-list {
  margin-top: 24rpx;
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 82rpx 34rpx minmax(0, 1fr);
  column-gap: 16rpx;
}

.timeline-item + .timeline-item {
  margin-top: 24rpx;
}

.timeline-time {
  padding-top: 30rpx;
  color: #9a7860;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: right;
}

.timeline-line {
  position: relative;
  display: flex;
  justify-content: center;
}

.timeline-line::before {
  content: '';
  position: absolute;
  top: 52rpx;
  bottom: -38rpx;
  width: 2rpx;
  background: #efdcca;
}

.timeline-item:last-child .timeline-line::before {
  display: none;
}

.timeline-dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 34rpx;
  border-radius: 50%;
  background: #ff9d16;
  box-shadow: 0 0 0 8rpx #fff0dc;
}

.timeline-card {
  min-width: 0;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid #f0dfce;
  box-shadow: 0 10rpx 28rpx rgba(178, 126, 77, 0.08);
  box-sizing: border-box;
}

.timeline-card-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.timeline-mood-icon {
  width: 70rpx;
  height: 70rpx;
  border-radius: 22rpx;
  background: #fffaf3;
  flex-shrink: 0;
}

.timeline-copy {
  flex: 1;
  min-width: 0;
}

.timeline-mood {
  color: #5d3a25;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 900;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.tag-chip {
  max-width: 180rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #fff4e6;
  color: #926a4d;
  font-size: 21rpx;
  line-height: 36rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.color-dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  box-shadow: inset 0 -3rpx 6rpx rgba(90, 55, 37, 0.14);
  flex-shrink: 0;
}

.memory-text {
  margin-top: 18rpx;
  color: #6f5648;
  font-size: 26rpx;
  line-height: 1.48;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.photo-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.photo-thumb {
  width: 118rpx;
  height: 118rpx;
  border-radius: 18rpx;
  background: #fff8ef;
}

.review-section {
  margin-top: 32rpx;
}

.review-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fff7ed;
  box-sizing: border-box;
}

.review-icon {
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  background: #fff1dc;
  flex-shrink: 0;
}

.review-copy {
  flex: 1;
  min-width: 0;
}

.review-title {
  color: #5d3a25;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 900;
}

.review-note {
  margin-top: 8rpx;
  color: #7e6252;
  font-size: 24rpx;
  line-height: 1.4;
}

.review-note.muted {
  color: #9a8070;
}

.review-edit,
.review-button {
  flex-shrink: 0;
  min-width: 104rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #c96a18;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 52rpx;
  text-align: center;
  box-sizing: border-box;
}

.review-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fff7ed;
  box-sizing: border-box;
}

.review-empty-title {
  color: #5d3a25;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}

.review-empty-text {
  margin-top: 8rpx;
  color: #8a6a51;
  font-size: 24rpx;
  line-height: 1.35;
}

.review-modal {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 500;
  display: flex;
  align-items: flex-end;
}

.review-modal-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(52, 38, 26, 0.42);
}

.review-modal-card {
  position: relative;
  z-index: 1;
  width: 100%;
  max-height: 88vh;
  padding: 34rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  border-top-left-radius: 34rpx;
  border-top-right-radius: 34rpx;
  background: #fffaf3;
  box-sizing: border-box;
  overflow-y: auto;
}

.modal-title {
  color: #5d3a25;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}

.review-mood-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.review-mood {
  height: 114rpx;
  border-radius: 20rpx;
  background: #fbf6f0;
  border: 3rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.review-mood.selected {
  border-color: #ff9d16;
  background: #fff4e6;
}

.review-mood-icon {
  width: 58rpx;
  height: 58rpx;
}

.review-mood-name {
  margin-top: 4rpx;
  color: #704c38;
  font-size: 20rpx;
  line-height: 1.15;
}

.review-textarea {
  width: 100%;
  height: 132rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid #eaded4;
  color: #604638;
  font-size: 26rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.modal-cancel,
.modal-submit {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 76rpx;
  text-align: center;
}

.modal-cancel {
  background: #f2e9df;
  color: #7d6658;
}

.modal-submit {
  background: linear-gradient(135deg, #ff9639 0%, #ff6418 100%);
  color: #fff;
  box-shadow: 0 12rpx 24rpx rgba(255, 105, 24, 0.22);
}
