<view class="page-container">
  <image class="trajectory-bg" src="/pkgDailyCheckin/assets/trajectory/trajectory-bg.jpg" mode="aspectFill"></image>
  <view class="trajectory-nav" style="padding-top: {{statusBarHeight}}px; height: {{totalNavBarHeight}}px;">
    <view class="nav-row" style="height: {{navBarHeight}}px;">
      <view class="nav-button nav-back" bindtap="goBack">‹</view>
      <view class="nav-title">心情轨迹</view>
      <view wx:if="{{isToday}}" class="nav-action" bindtap="goToRecord">记录此刻</view>
    </view>
  </view>

  <scroll-view class="trajectory-scroll" scroll-y="true" enhanced="true" show-scrollbar="false">
    <view class="trajectory-content">
      <view class="date-header">
        <view class="date-title-row">
          <view class="date-title">{{dateLabel}}</view>
          <image class="title-leaf" src="/pkgDailyCheckin/assets/trajectory/leaf-title.jpg" mode="aspectFit"></image>
        </view>
        <view class="date-subtitle">{{isToday ? '今天的心情正在流动' : '回看这一天的心情变化'}}</view>
      </view>

      <view class="sequence-section">
        <scroll-view class="sequence-scroll" scroll-x="true" show-scrollbar="false">
          <view class="sequence-list">
            <view wx:for="{{moments}}" wx:key="id" class="sequence-node">
              <image class="sequence-icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/pkgDailyCheckin/images/record/mood24/{{item.moodIcon}}.png" mode="aspectFit"></image>
              <view class="sequence-time">{{item.localTime}}</view>
            </view>
          </view>
        </scroll-view>
      </view>

      <view wx:if="{{moments.length === 0}}" class="empty-card">
        <view class="empty-title">这一天还没有心情记录</view>
        <view class="empty-text">{{isToday ? '可以从此刻开始，留下第一条心情。' : '没有记录也没关系，这一天也安静地经过了。'}}</view>
        <view wx:if="{{isToday}}" class="empty-button" bindtap="goToRecord">记录此刻</view>
      </view>

      <view wx:if="{{moments.length > 0}}" class="timeline-section">
        <view class="timeline-heading">
          <view>
            <view class="section-title">心情变化</view>
            <view class="trend-copy">{{trendText}}</view>
          </view>
          <view class="timeline-filter">按时间查看⌄</view>
        </view>

        <view class="timeline-list">
          <view wx:for="{{moments}}" wx:key="id" class="timeline-item">
            <view class="timeline-time">{{item.localTime}}</view>
            <view class="timeline-line">
              <view class="timeline-dot"></view>
            </view>
            <view class="timeline-card mood-tone-{{item.moodTone}}">
              <image class="timeline-scene" src="{{item.moodScene}}" mode="aspectFill"></image>
              <view class="timeline-scene-fade"></view>
              <view class="timeline-card-main">
                <image class="timeline-mood-icon" src="https://assets.feelyourself.cn/miniprogram/assets/v1/pkgDailyCheckin/images/record/mood24/{{item.moodIcon}}.png" mode="aspectFit"></image>
                <view class="timeline-copy">
                  <view class="timeline-mood">{{item.mood}}</view>
                  <view class="tag-row">
                    <view wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag-chip">{{tag}}</view>
                  </view>
                </view>
                <view class="color-dot" style="background-color: {{item.color}};"></view>
              </view>

              <view wx:if="{{item.text_content}}" class="memory-text">{{item.text_content}}</view>
              <view wx:if="{{item.imageUrls.length}}" class="photo-row">
                <image
                  wx:for="{{item.imageUrls}}"
                  wx:for-item="photo"
                  wx:key="*this"
                  class="photo-thumb"
                  src="{{photo}}"
                  mode="aspectFill"
                  bindtap="previewImage"
                  data-current="{{photo}}"
                  data-urls="{{item.imageUrls}}"
                ></image>
              </view>
            </view>
          </view>
        </view>
      </view>

    </view>
  </scroll-view>
</view>
