<view class="privacy-page">
  <view class="top-safe" style="height: {{topSafeHeight}}px;"></view>
  <view class="privacy-nav">
    <view class="nav-back" bindtap="goBack">‹</view>
    <view class="nav-title">隐私与数据</view>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view class="privacy-scroll" scroll-y="true" enhanced="true">
    <view class="privacy-hero">
      <image class="hero-shield" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/privacy/privacy-shield.png" mode="aspectFit"></image>
      <view class="hero-title">认真守护每一份信任</view>
      <view class="hero-copy">你的情绪、测评与聊天记录属于高度私密的信息。我们从存储、查询到读取都按最小必要原则保护。</view>
    </view>

    <view class="protection-band">
      <view class="protection-item">
        <view class="protection-mark">
          <image class="protection-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/privacy/privacy-lock-line.png" mode="aspectFit"></image>
        </view>
        <view class="protection-title">认证加密</view>
        <view class="protection-copy">敏感字段和上传图片均加密保存</view>
      </view>
      <view class="protection-item">
        <view class="protection-mark">
          <image class="protection-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/privacy/privacy-minimal-line.png" mode="aspectFit"></image>
        </view>
        <view class="protection-title">最小必要</view>
        <view class="protection-copy">只处理完成对应功能所需的信息</view>
      </view>
      <view class="protection-item">
        <view class="protection-mark">
          <image class="protection-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/privacy/privacy-control-line.png" mode="aspectFit"></image>
        </view>
        <view class="protection-title">用户可控</view>
        <view class="protection-copy">支持更正、删除和撤回同意</view>
      </view>
    </view>

    <view class="consent-status">
      <view class="status-copy">
        <view class="status-title">当前隐私同意状态</view>
        <view class="status-desc" wx:if="{{consentCurrent}}">
          已同意版本 {{policy.version}}
          <text wx:if="{{consentedAtText}}"> · {{consentedAtText}}</text>
        </view>
        <view class="status-desc" wx:else>尚未同意当前版本，登录时会再次向你说明</view>
      </view>
      <view class="status-pill {{consentCurrent ? 'is-current' : ''}}">
        {{consentCurrent ? '已生效' : '未生效'}}
      </view>
    </view>

    <view class="policy-card">
      <view class="policy-title-row">
        <image class="policy-heading-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/privacy/privacy-shield-line.png" mode="aspectFit"></image>
        <view class="policy-heading-copy">
          <view class="policy-heading">{{policy.title}}</view>
          <view class="policy-meta">版本 {{policy.version}} · 生效日期 {{policy.effectiveDate}}</view>
        </view>
      </view>
      <view class="policy-summary">{{policy.summary}}</view>
      <view wx:for="{{policy.sections}}" wx:key="title" class="policy-section">
        <view class="policy-section-title">{{item.title}}</view>
        <view class="policy-section-content">{{item.content}}</view>
      </view>
      <view class="policy-notice">{{policy.notice}}</view>
    </view>

    <view wx:if="{{isLoggedIn}}" class="withdraw-button" bindtap="withdrawConsent">撤回隐私同意并退出登录</view>
    <view class="page-bottom-note">如需查询、删除或导出更多个人数据，请通过“我的 - 意见反馈”联系我们。</view>
  </scroll-view>
</view>
