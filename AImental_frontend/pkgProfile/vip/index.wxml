<view class="vip-page">
  <view class="status-spacer" style="height: {{statusBarHeight}}px;"></view>

  <view class="nav-row">
    <view class="back-button" bindtap="handleBack" aria-label="返回">
      <text class="back-icon">‹</text>
    </view>
  </view>

  <view class="page-header">
    <view class="page-title">会员中心</view>
    <view class="record-entry" bindtap="openPurchaseRecords">
      <view class="record-icon">
        <text>▤</text>
      </view>
      <text>购买记录</text>
    </view>
  </view>

  <view class="member-card">
    <image class="member-card-bg" src="/images/vip/member-card-bg.png" mode="aspectFill"></image>
    <view class="member-expire-top">{{currentMember.expiresText}}</view>
    <view class="member-card-content">
      <image class="member-avatar" src="{{currentMember.icon}}" mode="aspectFit"></image>
      <view class="member-info">
        <view class="member-name">{{currentMember.name}}</view>
      </view>
    </view>
    <view class="service-link" bindtap="openAgreement">
      <text>会员服务协议</text>
    </view>
  </view>

  <view class="usage-card section-card">
    <view class="section-title">会员权益使用情况</view>
    <view class="usage-list">
      <view wx:for="{{usageItems}}" wx:key="feature" class="usage-row">
        <image class="usage-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <text class="usage-name">{{item.name}}</text>
        <view class="progress-track">
          <view class="progress-fill" style="{{item.progressStyle}}"></view>
        </view>
        <text class="usage-count">{{item.countText}}</text>
      </view>
    </view>
  </view>

  <view class="addon-section section-card">
    <view class="section-title addon-title">加量包购买</view>
    <view class="addon-grid">
      <view
        wx:for="{{addonProducts}}"
        wx:key="code"
        class="addon-card"
        data-code="{{item.code}}"
        bindtap="openAddonModal"
      >
        <image class="addon-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <view class="addon-copy">
          <view class="addon-name">{{item.name}}</view>
          <view class="addon-amount">{{item.amount}} 次</view>
        </view>
        <view class="addon-price">¥{{item.priceText}}</view>
        <view class="addon-buy-button">
          <text>›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer-art-wrap">
    <image class="footer-art" src="/images/vip/member-center-footer.png" mode="aspectFill"></image>
  </view>

  <view wx:if="{{addonModalVisible}}" class="modal-layer">
    <view class="modal-mask" bindtap="closeAddonModal"></view>
    <view class="addon-modal">
      <view class="modal-title">购买加量包</view>
      <view class="modal-close" bindtap="closeAddonModal">×</view>

      <view class="modal-product">
        <view class="modal-product-art">
          <image src="{{selectedAddon.icon}}" mode="aspectFit"></image>
        </view>
        <view class="modal-product-copy">
          <view class="modal-product-name">{{selectedAddon.name}}</view>
          <view class="modal-product-amount">{{selectedAddon.amount}}次</view>
          <view class="modal-product-desc">{{selectedAddon.description}}</view>
        </view>
      </view>

      <view class="modal-divider"></view>

      <view class="modal-price">¥{{selectedAddon.priceText}}</view>
      <view class="quantity-stepper">
        <view class="stepper-button" bindtap="decreaseQuantity">−</view>
        <view class="stepper-value">{{addonQuantity}}</view>
        <view class="stepper-button plus" bindtap="increaseQuantity">＋</view>
      </view>
      <view class="stepper-tip">可按需选择购买数量</view>

      <view class="pay-panel">
        <view class="total-row">
          <text>合计</text>
          <text class="total-price">¥{{addonTotalText}}</text>
        </view>
        <button
          class="pay-button {{addonAgreementChecked ? '' : 'disabled'}}"
          loading="{{purchaseLoading}}"
          disabled="{{purchaseLoading}}"
          bindtap="handleAddonPay"
        >
          立即支付
        </button>
        <view class="modal-agreement">
          <view class="modal-agreement-check {{addonAgreementChecked ? 'checked' : ''}}" bindtap="toggleAddonAgreement">
            <text wx:if="{{addonAgreementChecked}}">✓</text>
          </view>
          <text class="modal-agreement-copy" bindtap="toggleAddonAgreement">我已阅读并同意</text>
          <text class="modal-agreement-link" catchtap="openAgreement">会员服务协议</text>
          <text class="modal-agreement-arrow">›</text>
        </view>
      </view>
    </view>
  </view>
</view>
