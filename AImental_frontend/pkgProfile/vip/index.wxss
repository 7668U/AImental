page {
  min-height: 100%;
  background: #fff8ef;
  color: #3f2c22;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft Yahei', sans-serif;
}

.vip-page {
  position: relative;
  min-height: 100vh;
  padding: 0 38rpx;
  box-sizing: border-box;
  overflow-x: hidden;
  background: linear-gradient(180deg, rgba(255, 250, 242, 0.08) 0%, #fffaf4 33%, #fff8ef 100%);
}

.page-background {
  position: absolute;
  z-index: 0;
  left: 0;
  top: 0;
  width: 100%;
  height: 390rpx;
  opacity: 0.98;
  pointer-events: none;
}

.status-spacer,
.nav-row,
.hero-copy,
.plan-list,
.purchase-spacer {
  position: relative;
  z-index: 1;
}

.nav-row {
  height: 96rpx;
  display: flex;
  align-items: center;
}

.back-button {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 22rpx rgba(178, 106, 52, 0.12);
  border: 1rpx solid rgba(247, 169, 95, 0.28);
}

.back-button:active {
  opacity: 0.72;
}

.back-icon {
  margin-top: -5rpx;
  color: #39251d;
  font-size: 68rpx;
  line-height: 1;
  font-weight: 300;
}

.hero-copy {
  padding: 28rpx 8rpx 52rpx;
}

.page-title {
  font-size: 46rpx;
  line-height: 1.22;
  font-weight: 800;
  color: #3d291f;
  letter-spacing: 0;
}

.page-subtitle {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.45;
  color: #75675e;
  letter-spacing: 0;
}

.plan-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.plan-card {
  position: relative;
  min-height: 320rpx;
  padding: 28rpx 28rpx 26rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(235, 183, 133, 0.36);
  box-sizing: border-box;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 30rpx rgba(173, 108, 60, 0.08);
  transition: border-color 180ms ease-out, box-shadow 180ms ease-out, transform 180ms ease-out;
}

.plan-card:active {
  transform: scale(0.995);
}

.plan-card.selected {
  border-width: 3rpx;
}

.plan-card.selected.plan-light {
  border-color: #f3a044;
  box-shadow: 0 14rpx 34rpx rgba(225, 128, 42, 0.13);
}

.plan-card.selected.plan-knowing {
  border-color: #4db674;
  box-shadow: 0 14rpx 34rpx rgba(61, 160, 97, 0.14);
}

.plan-card.selected.plan-companion {
  border-color: #e96b67;
  box-shadow: 0 14rpx 34rpx rgba(220, 81, 76, 0.13);
}

.plan-heading {
  position: relative;
  min-height: 82rpx;
  margin-left: 176rpx;
  padding-right: 44rpx;
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
}

.plan-heading-copy {
  flex: 1;
  min-width: 0;
}

.plan-name-row {
  min-height: 40rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.plan-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f28a35;
}

.plan-knowing .plan-dot {
  background: #45aa69;
}

.plan-companion .plan-dot {
  background: #e45552;
}

.plan-name {
  font-size: 33rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #4d3022;
  white-space: nowrap;
}

.plan-knowing .plan-name {
  color: #2f754d;
}

.plan-companion .plan-name {
  color: #d64946;
}

.recommended-tag,
.current-tag {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.recommended-tag {
  color: #2f8552;
  background: #eaf7ee;
}

.current-tag {
  color: #c05b1b;
  background: #fff1e4;
}

.plan-description {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: #6f625a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.plan-price-area {
  margin-left: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.pricing-label {
  margin-bottom: 1rpx;
  font-size: 17rpx;
  line-height: 1.2;
  color: #c97b43;
}

.plan-price {
  display: flex;
  align-items: baseline;
  color: #ff6f17;
  white-space: nowrap;
}

.currency {
  margin-right: 2rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.price-value {
  font-size: 43rpx;
  line-height: 1;
  font-weight: 800;
}

.price-unit {
  margin-left: 2rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.select-indicator {
  position: absolute;
  top: 20rpx;
  right: 0;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid #e1d8d0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.selected .select-indicator {
  border-color: #ff7d21;
  background: #ff7d21;
}

.select-check {
  color: #fff;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 800;
}

.plan-art {
  position: absolute;
  left: 20rpx;
  top: 75rpx;
  width: 166rpx;
  height: 196rpx;
}

.quota-list {
  margin: 12rpx 12rpx 0 176rpx;
}

.quota-row {
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx dashed rgba(143, 112, 93, 0.16);
}

.quota-row:last-child {
  border-bottom: 0;
}

.quota-name-wrap {
  min-width: 0;
  display: flex;
  align-items: center;
}

.quota-icon-wrap {
  width: 37rpx;
  height: 37rpx;
  margin-right: 13rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #fff5e9;
}

.plan-knowing .quota-icon-wrap {
  background: #edf8ef;
}

.plan-companion .quota-icon-wrap {
  background: #fff0ef;
}

.quota-icon {
  width: 34rpx;
  height: 34rpx;
}

.quota-name {
  max-width: 210rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: #50443d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.quota-value {
  margin-left: 12rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: #50443d;
  white-space: nowrap;
}

.purchase-spacer {
  height: calc(226rpx + env(safe-area-inset-bottom));
}

.purchase-bar {
  position: fixed;
  z-index: 20;
  left: 20rpx;
  right: 20rpx;
  bottom: 0;
  padding: 20rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -10rpx 36rpx rgba(150, 93, 47, 0.12);
}

.purchase-main {
  min-height: 88rpx;
  display: flex;
  align-items: center;
}

.selected-plan-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(232, 171, 94, 0.54);
  box-sizing: border-box;
  overflow: hidden;
  flex-shrink: 0;
  background: #fffaf3;
}

.selected-plan-thumb image {
  width: 100%;
  height: 100%;
}

.selected-plan-summary {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.selected-plan-line {
  display: flex;
  align-items: baseline;
  min-width: 0;
  white-space: nowrap;
}

.selected-plan-name {
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #563426;
}

.summary-separator {
  margin: 0 7rpx;
  color: #d56a28;
  font-size: 25rpx;
}

.selected-price {
  color: #ff6f17;
  font-size: 33rpx;
  font-weight: 800;
}

.selected-price-unit {
  margin-left: 2rpx;
  color: #6d5140;
  font-size: 21rpx;
}

.purchase-note {
  margin-top: 7rpx;
  font-size: 21rpx;
  line-height: 1.2;
  color: #8a7e76;
}

.purchase-divider {
  width: 1rpx;
  height: 60rpx;
  margin: 0 20rpx;
  background: rgba(125, 95, 76, 0.16);
  flex-shrink: 0;
}

.purchase-button {
  width: 250rpx;
  height: 80rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 800;
  background: linear-gradient(135deg, #ff9f3d 0%, #ff6f17 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 116, 26, 0.22);
}

.purchase-button::after {
  display: none;
}

.purchase-button.disabled {
  color: #fff;
  background: #c9beb5;
  box-shadow: none;
}

.agreement-row {
  min-height: 48rpx;
  padding-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  line-height: 1.2;
}

.agreement-check {
  width: 24rpx;
  height: 24rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  border: 2rpx solid #d5c8bd;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #fff;
  font-size: 17rpx;
  line-height: 1;
  background: #fff;
}

.agreement-check.checked {
  border-color: #ff7d21;
  background: #ff7d21;
}

.agreement-copy {
  color: #8b8078;
}

.agreement-link {
  margin-left: 8rpx;
  color: #ff6f17;
}

.agreement-arrow {
  margin-left: 6rpx;
  color: #a6988f;
  font-size: 30rpx;
}

@media (max-width: 350px) {
  .vip-page {
    padding-left: 28rpx;
    padding-right: 28rpx;
  }

  .page-title {
    font-size: 41rpx;
  }

  .plan-card {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .plan-heading,
  .quota-list {
    margin-left: 150rpx;
  }

  .plan-art {
    width: 142rpx;
    height: 174rpx;
  }

  .plan-name {
    font-size: 29rpx;
  }

  .price-value {
    font-size: 37rpx;
  }

  .purchase-divider {
    margin-left: 12rpx;
    margin-right: 12rpx;
  }

  .purchase-button {
    width: 220rpx;
    font-size: 25rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .plan-card {
    transition: none;
  }
}
