page {
  min-height: 100%;
  background: #fff7ed;
  color: #342318;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft Yahei', sans-serif;
}

.vip-page {
  position: relative;
  min-height: 100vh;
  padding: 0 28rpx 0;
  box-sizing: border-box;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 50% -10%, rgba(255, 232, 198, 0.72) 0, rgba(255, 250, 244, 0) 380rpx),
    linear-gradient(180deg, #fff8ee 0%, #fffaf5 58%, #fff6ea 100%);
}

.status-spacer,
.nav-row,
.page-header,
.member-card,
.section-card,
.footer-art-wrap {
  position: relative;
  z-index: 1;
}

.nav-row {
  height: 96rpx;
  display: flex;
  align-items: center;
}

.back-button {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-button:active,
.record-entry:active,
.service-link:active,
.addon-card:active,
.modal-close:active,
.stepper-button:active,
.pay-button:active {
  opacity: 0.72;
}

.back-icon {
  margin-top: -6rpx;
  color: #111;
  font-size: 70rpx;
  line-height: 1;
  font-weight: 300;
}

.page-header {
  min-height: 138rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.page-title {
  padding-top: 24rpx;
  color: #3b281c;
  font-size: 48rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 0;
}

.record-entry {
  margin-top: 2rpx;
  width: 116rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #634a39;
  font-size: 22rpx;
  line-height: 1.2;
}

.record-icon {
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 10rpx;
  border: 2rpx solid rgba(238, 180, 112, 0.68);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4e3a2c;
  font-size: 31rpx;
  background: rgba(255, 247, 236, 0.92);
}

.member-card {
  height: 346rpx;
  border: 1rpx solid rgba(237, 185, 120, 0.6);
  border-radius: 28rpx;
  overflow: hidden;
  background: #ffe8cf;
  box-shadow: 0 16rpx 32rpx rgba(169, 103, 45, 0.08);
}

.member-card-bg {
  position: absolute;
  z-index: 0;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.member-card-content {
  position: relative;
  z-index: 1;
  height: 100%;
  padding: 92rpx 24rpx 64rpx 26rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.member-expire-top {
  position: absolute;
  z-index: 2;
  left: 28rpx;
  top: 28rpx;
  color: #4c3b31;
  font-size: 25rpx;
  line-height: 1.25;
}

.member-avatar {
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
}

.member-info {
  margin-left: 22rpx;
  display: flex;
  align-items: center;
  min-width: 0;
}

.member-name {
  color: #3f2a1d;
  font-size: 42rpx;
  line-height: 1.15;
  font-weight: 900;
}

.service-link {
  position: absolute;
  z-index: 2;
  left: 28rpx;
  bottom: 32rpx;
  min-width: 154rpx;
  height: 46rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4e3b30;
  font-size: 23rpx;
  line-height: 1;
  background: rgba(255, 255, 255, 0.82);
}

.section-card {
  margin-top: 22rpx;
  border: 1rpx solid rgba(238, 207, 169, 0.66);
  border-radius: 26rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 14rpx 28rpx rgba(157, 111, 66, 0.055);
}

.usage-card {
  padding: 26rpx 28rpx 30rpx;
}

.section-title {
  color: #37251a;
  font-size: 31rpx;
  line-height: 1.2;
  font-weight: 900;
}

.usage-list {
  margin-top: 24rpx;
}

.usage-row {
  height: 78rpx;
  display: flex;
  align-items: center;
}

.usage-row + .usage-row {
  margin-top: 14rpx;
}

.usage-icon {
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
}

.usage-name {
  width: 124rpx;
  margin-left: 20rpx;
  color: #252321;
  font-size: 25rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.progress-track {
  position: relative;
  flex: 1;
  height: 13rpx;
  margin-left: 8rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #fbecd8;
}

.progress-fill {
  height: 100%;
  min-width: 6rpx;
  border-radius: 999rpx;
}

.usage-count {
  width: 136rpx;
  margin-left: 22rpx;
  color: #23201e;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: right;
  white-space: nowrap;
}

.addon-section {
  padding: 24rpx 24rpx 28rpx;
}

.addon-title {
  margin-bottom: 18rpx;
}

.addon-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.addon-card {
  position: relative;
  min-height: 144rpx;
  padding: 22rpx 18rpx 22rpx;
  border: 1rpx solid rgba(237, 207, 174, 0.76);
  border-radius: 22rpx;
  box-sizing: border-box;
  background: rgba(255, 253, 249, 0.94);
  box-shadow: 0 10rpx 20rpx rgba(173, 121, 67, 0.06);
}

.addon-icon {
  position: absolute;
  left: 18rpx;
  top: 20rpx;
  width: 68rpx;
  height: 68rpx;
}

.addon-copy {
  min-height: 68rpx;
  margin-left: 84rpx;
  padding-right: 4rpx;
}

.addon-name {
  color: #312820;
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 600;
}

.addon-amount {
  margin-top: 9rpx;
  color: #8b8178;
  font-size: 22rpx;
  line-height: 1.2;
}

.addon-price {
  margin-top: 18rpx;
  color: #ff7417;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 900;
}

.addon-buy-button {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  width: 42rpx;
  height: 42rpx;
  border: 5rpx solid #f6d1a3;
  border-radius: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1f1d1a;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 400;
  background: #fffaf2;
}

.addon-buy-button text {
  margin-top: -4rpx;
}

.footer-art-wrap {
  height: 118rpx;
  margin: 26rpx -28rpx 0;
  overflow: hidden;
}

.footer-art {
  width: 100%;
  height: 180rpx;
}

.modal-layer {
  position: fixed;
  z-index: 50;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.modal-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.62);
}

.addon-modal {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
  padding: 40rpx 34rpx 26rpx;
  border-radius: 34rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fffdfa 0%, #fff8ef 100%);
  box-shadow: 0 -10rpx 38rpx rgba(43, 30, 20, 0.18);
}

.modal-title {
  color: #3b281c;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 900;
  text-align: center;
}

.modal-close {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111;
  font-size: 48rpx;
  line-height: 1;
  background: #f3e7da;
}

.modal-product {
  margin-top: 34rpx;
  display: flex;
  align-items: center;
}

.modal-product-art {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
}

.modal-product-art image {
  width: 150rpx;
  height: 150rpx;
}

.modal-product-copy {
  min-width: 0;
  margin-left: 12rpx;
}

.modal-product-name {
  color: #3a281d;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 900;
}

.modal-product-amount {
  margin-top: 16rpx;
  color: #8a786a;
  font-size: 26rpx;
  line-height: 1.2;
}

.modal-product-desc {
  margin-top: 16rpx;
  color: #a18d7e;
  font-size: 24rpx;
  line-height: 1.25;
}

.modal-divider {
  height: 1rpx;
  margin: 24rpx 0 26rpx;
  border-top: 2rpx dashed #f0d6bd;
}

.modal-price {
  color: #ff7417;
  font-size: 48rpx;
  line-height: 1;
  font-weight: 900;
  text-align: center;
}

.quantity-stepper {
  width: 326rpx;
  height: 72rpx;
  margin: 26rpx auto 0;
  padding: 0 18rpx;
  border: 1rpx solid #f2d8bf;
  border-radius: 999rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.74);
}

.stepper-button {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #33251d;
  font-size: 40rpx;
  line-height: 1;
  background: #fff0df;
}

.stepper-button.plus {
  color: #f27418;
}

.stepper-value {
  color: #251d18;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 700;
}

.stepper-tip {
  margin-top: 20rpx;
  color: #b09b89;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: center;
}

.pay-panel {
  margin-top: 30rpx;
  padding: 24rpx 20rpx 18rpx;
  border: 1rpx solid #f2d7bc;
  border-radius: 22rpx;
  box-sizing: border-box;
  background: rgba(255, 251, 246, 0.78);
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #2d241e;
  font-size: 28rpx;
  line-height: 1.2;
}

.total-price {
  color: #ff7417;
  font-size: 34rpx;
  font-weight: 900;
}

.pay-button {
  height: 82rpx;
  margin: 34rpx 0 0;
  border: 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 900;
  background: linear-gradient(135deg, #ff9c28 0%, #ff7417 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 117, 24, 0.22);
}

.pay-button::after {
  display: none;
}

.pay-button.disabled {
  color: rgba(255, 255, 255, 0.9);
  background: #cfc7c0;
  box-shadow: none;
}

.modal-agreement {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b6a99d;
  font-size: 23rpx;
  line-height: 1.2;
}

.modal-agreement-check {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  border: 2rpx solid #d8cbc1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 17rpx;
  line-height: 1;
  font-weight: 800;
  background: #fffaf6;
}

.modal-agreement-check.checked {
  border-color: #ff7a1a;
  background: #ff7a1a;
}

.modal-agreement-copy {
  color: #a99d93;
}

.modal-agreement-link {
  margin-left: 5rpx;
  color: #ff7a1a;
}

.modal-agreement-arrow {
  margin-left: 2rpx;
  color: #ff7a1a;
  font-size: 25rpx;
}

@media (max-width: 350px) {
  .vip-page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .member-card-content {
    padding-left: 20rpx;
  }

  .member-avatar {
    width: 132rpx;
    height: 132rpx;
  }

  .member-name {
    font-size: 37rpx;
  }

  .usage-card {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .usage-name {
    width: 116rpx;
    margin-left: 14rpx;
    font-size: 23rpx;
  }

  .usage-count {
    width: 122rpx;
    margin-left: 14rpx;
    font-size: 22rpx;
  }

  .addon-grid {
    gap: 14rpx;
  }

  .addon-card {
    padding-left: 14rpx;
    padding-right: 14rpx;
  }

  .addon-copy {
    margin-left: 76rpx;
  }
}
