page {
  min-height: 100%;
  background: #fff8ef;
  color: #3f2c22;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft Yahei', sans-serif;
}

.vip-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
}

.vip-loading-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 38rpx;
  background: #fff8ef;
}

.loading-mode {
  background: #fff8ef;
}

.vip-loading-center {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vip-loading-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 5rpx solid rgba(239, 115, 105, 0.2);
  border-top-color: #ef7369;
  border-radius: 50%;
  animation: vip-loading-spin 0.8s linear infinite;
}

@keyframes vip-loading-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.purchase-mode {
  padding: 0 38rpx;
  background: linear-gradient(180deg, rgba(255, 250, 242, 0.08) 0%, #fffaf4 33%, #fff8ef 100%);
}

.member-mode {
  height: 100vh;
  max-height: 100vh;
  padding: 0 28rpx;
  background:
    radial-gradient(circle at 50% -10%, rgba(255, 232, 198, 0.72) 0, rgba(255, 250, 244, 0) 380rpx),
    linear-gradient(180deg, #fff8ee 0%, #fffaf5 58%, #fff6ea 100%);
  overflow: hidden;
}

.page-background {
  position: absolute;
  z-index: 0;
  left: 0;
  top: 0;
  width: 100%;
  height: 390rpx;
  opacity: 0.98;
  pointer-events: none;
}

.status-spacer,
.nav-row,
.hero-copy,
.plan-list,
.purchase-spacer,
.member-page-header,
.member-card,
.section-card,
.footer-art-wrap {
  position: relative;
  z-index: 1;
}

.nav-row {
  height: 96rpx;
  display: flex;
  align-items: center;
}

.back-button {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 22rpx rgba(178, 106, 52, 0.12);
  border: 1rpx solid rgba(247, 169, 95, 0.28);
}

.back-button:active,
.record-entry:active,
.service-link:active,
.addon-card:active,
.modal-close:active,
.stepper-button:active,
.pay-button:active {
  opacity: 0.72;
}

.back-icon {
  margin-top: -5rpx;
  color: #39251d;
  font-size: 68rpx;
  line-height: 1;
  font-weight: 300;
}

.member-mode .back-button {
  width: 58rpx;
  height: 58rpx;
  border: 0;
  border-radius: 0;
  justify-content: flex-start;
  background: transparent;
  box-shadow: none;
}

.member-mode .nav-row {
  height: 62rpx;
  align-items: flex-start;
}

.member-mode .back-icon {
  margin-top: -6rpx;
  color: #111;
  font-size: 70rpx;
}

.hero-copy {
  padding: 28rpx 8rpx 52rpx;
}

.page-title {
  font-family: 'LXGWWenKaiHome', "STKaiti", "KaiTi", "Songti SC", "PingFang SC", serif;
  font-size: 46rpx;
  line-height: 1.22;
  font-weight: 400;
  color: #4b2c1b;
  letter-spacing: 0;
}

.page-subtitle {
  margin-top: 14rpx;
  max-width: 560rpx;
  font-family: 'LXGWWenKaiHome', "STKaiti", "KaiTi", "Songti SC", "PingFang SC", serif;
  font-size: 27rpx;
  line-height: 1.45;
  font-weight: 400;
  color: #806d61;
  letter-spacing: 0;
  white-space: normal;
  word-break: break-all;
}

.subtitle-break {
  display: block;
}

.plan-list {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.plan-card {
  position: relative;
  min-height: 304rpx;
  padding: 28rpx 28rpx 26rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(235, 183, 133, 0.36);
  box-sizing: border-box;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(173, 108, 60, 0.08);
}

.plan-card.selected.plan-light {
  border-color: #f3a044;
}

.plan-card.selected.plan-knowing {
  border-color: #4db674;
}

.plan-card.selected.plan-companion {
  border-color: #e96b67;
}

.plan-heading {
  position: relative;
  min-height: 52rpx;
  margin-left: 176rpx;
  padding-right: 44rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.plan-heading-copy {
  flex: 1;
  min-width: 0;
}

.plan-name-row {
  min-height: 40rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.plan-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #f28a35;
}

.plan-knowing .plan-dot {
  background: #45aa69;
}

.plan-companion .plan-dot {
  background: #e45552;
}

.plan-name {
  font-size: 33rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #4d3022;
  white-space: nowrap;
}

.plan-knowing .plan-name {
  color: #2f754d;
}

.plan-companion .plan-name {
  color: #d64946;
}

.current-tag {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  color: #c05b1b;
  font-size: 18rpx;
  line-height: 1.2;
  white-space: nowrap;
  background: #fff1e4;
}

.plan-price-area {
  margin-left: 14rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
  flex-shrink: 0;
}

.plan-price {
  display: flex;
  align-items: baseline;
  color: #ff6f17;
  white-space: nowrap;
}

.currency {
  margin-right: 2rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.price-value {
  font-size: 43rpx;
  line-height: 1;
  font-weight: 800;
}

.price-unit {
  margin-left: 2rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.select-indicator {
  position: absolute;
  top: 50%;
  right: 0;
  transform: translateY(-50%);
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid #e1d8d0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.selected .select-indicator {
  border-color: #ff7d21;
  background: #ff7d21;
}

.select-check {
  color: #fff;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 800;
  opacity: 0;
}

.selected .select-check {
  opacity: 1;
}

.plan-art {
  position: absolute;
  left: 18rpx;
  top: 76rpx;
  width: 174rpx;
  height: 174rpx;
}

.plan-light .plan-art {
  left: 18rpx;
  top: 76rpx;
  width: 174rpx;
  height: 174rpx;
}

.quota-list {
  margin: 4rpx 12rpx 0 176rpx;
}

.quota-row {
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx dashed rgba(143, 112, 93, 0.16);
}

.quota-row:last-child {
  border-bottom: 0;
}

.quota-name-wrap {
  min-width: 0;
  display: flex;
  align-items: center;
}

.quota-icon-wrap {
  width: 37rpx;
  height: 37rpx;
  margin-right: 13rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #fff5e9;
}

.plan-knowing .quota-icon-wrap {
  background: #edf8ef;
}

.plan-companion .quota-icon-wrap {
  background: #fff0ef;
}

.quota-icon {
  width: 34rpx;
  height: 34rpx;
}

.quota-name {
  max-width: 210rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: #50443d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.quota-value {
  margin-left: 12rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: #50443d;
  white-space: nowrap;
}

.purchase-spacer {
  height: calc(226rpx + env(safe-area-inset-bottom));
}

.purchase-bar {
  position: fixed;
  z-index: 20;
  left: 20rpx;
  right: 20rpx;
  bottom: 0;
  padding: 20rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  box-sizing: border-box;
  background: #fff;
  box-shadow: 0 -10rpx 36rpx rgba(150, 93, 47, 0.12);
}

.purchase-main {
  min-height: 88rpx;
  display: flex;
  align-items: center;
}

.selected-plan-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(232, 171, 94, 0.54);
  box-sizing: border-box;
  overflow: hidden;
  flex-shrink: 0;
  background: #fffaf3;
}

.selected-plan-thumb image {
  width: 100%;
  height: 100%;
}

.selected-plan-summary {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.selected-plan-line {
  display: flex;
  align-items: baseline;
  min-width: 0;
  white-space: nowrap;
}

.selected-plan-name {
  max-width: 170rpx;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #563426;
}

.summary-separator {
  margin: 0 7rpx;
  color: #d56a28;
  font-size: 25rpx;
}

.selected-price {
  color: #ff6f17;
  font-size: 33rpx;
  font-weight: 800;
}

.selected-price-unit {
  margin-left: 2rpx;
  color: #6d5140;
  font-size: 21rpx;
}

.purchase-note {
  margin-top: 7rpx;
  font-size: 21rpx;
  line-height: 1.2;
  color: #8a7e76;
}

.purchase-divider {
  width: 1rpx;
  height: 60rpx;
  margin: 0 16rpx;
  background: rgba(125, 95, 76, 0.16);
  flex-shrink: 0;
}

.purchase-button {
  width: 176rpx;
  min-width: 176rpx;
  max-width: 176rpx;
  flex: 0 0 176rpx;
  height: 80rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 800;
  background: linear-gradient(135deg, #ff9f3d 0%, #ff6f17 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 116, 26, 0.22);
}

.purchase-button::after {
  display: none;
}

.purchase-button.disabled {
  color: #fff;
  font-size: 26rpx;
  background: #c9beb5;
  box-shadow: none;
}

.agreement-row {
  min-height: 48rpx;
  padding-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  line-height: 1.2;
}

.agreement-check {
  width: 24rpx;
  height: 24rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  border: 2rpx solid #d5c8bd;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #fff;
  font-size: 17rpx;
  line-height: 1;
  background: #fff;
}

.agreement-check.checked {
  border-color: #ff7d21;
  background: #ff7d21;
}

.agreement-copy {
  color: #8b8078;
}

.agreement-link {
  margin-left: 8rpx;
  color: #ff6f17;
}

.agreement-arrow {
  margin-left: 6rpx;
  color: #a6988f;
  font-size: 30rpx;
}

.member-page-header {
  min-height: 104rpx;
  display: grid;
  grid-template-columns: 116rpx minmax(0, 1fr) 116rpx;
  align-items: center;
  column-gap: 8rpx;
}

.member-page-title {
  min-width: 0;
  color: #171717;
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 900;
  text-align: center;
  letter-spacing: 0;
}

.member-page-side-placeholder {
  width: 116rpx;
  height: 1rpx;
}

.record-entry {
  width: 116rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #634a39;
  font-size: 22rpx;
  line-height: 1.2;
}

.record-icon {
  width: 88rpx;
  height: 78rpx;
  margin-bottom: -2rpx;
}

.member-card {
  height: 392rpx;
  border: 1rpx solid rgba(239, 190, 124, 0.76);
  border-radius: 30rpx;
  overflow: hidden;
  background: #fff0d7;
  box-shadow: 0 16rpx 32rpx rgba(169, 103, 45, 0.09);
}

.member-card-bg {
  position: absolute;
  z-index: 0;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 1;
}

.member-name {
  position: absolute;
  z-index: 2;
  left: 46rpx;
  top: 112rpx;
  color: #754012;
  font-family: "Source Han Serif SC", "Noto Serif SC", "Songti SC", STSong, SimSun, serif;
  font-size: 68rpx;
  line-height: 1.08;
  font-weight: 900;
  letter-spacing: 0;
  white-space: nowrap;
}

.member-validity {
  position: absolute;
  z-index: 2;
  left: 42rpx;
  top: 35rpx;
  max-width: 390rpx;
  display: flex;
  align-items: center;
  color: #87552d;
  font-size: 25rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.member-validity-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 13rpx;
  flex-shrink: 0;
}

.member-title-ornament {
  position: absolute;
  z-index: 2;
  left: 48rpx;
  top: 194rpx;
  width: 264rpx;
  height: 24rpx;
  display: flex;
  align-items: center;
}

.member-title-line {
  flex: 1;
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(238, 172, 84, 0), rgba(238, 172, 84, 0.86), rgba(238, 172, 84, 0.08));
}

.member-title-spark {
  width: 14rpx;
  height: 14rpx;
  margin-left: 12rpx;
  background: #e9a952;
  transform: rotate(45deg);
}

.member-badge-icon {
  position: absolute;
  z-index: 2;
  left: 56rpx;
  bottom: 34rpx;
  width: 150rpx;
  height: 140rpx;
}

.service-link {
  position: absolute;
  z-index: 2;
  right: 32rpx;
  top: 32rpx;
  min-width: 184rpx;
  height: 60rpx;
  padding: 0 26rpx 0 30rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #875129;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 700;
  background: linear-gradient(180deg, rgba(255, 251, 242, 0.94), rgba(255, 239, 210, 0.9));
  box-shadow:
    inset 0 0 0 2rpx rgba(234, 190, 135, 0.44),
    0 8rpx 18rpx rgba(169, 103, 45, 0.1);
}

.service-arrow {
  width: 14rpx;
  height: 14rpx;
  margin-left: 18rpx;
  border-top: 4rpx solid #8b542b;
  border-right: 4rpx solid #8b542b;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.section-card {
  margin-top: 22rpx;
  border: 1rpx solid rgba(238, 207, 169, 0.66);
  border-radius: 26rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 14rpx 28rpx rgba(157, 111, 66, 0.055);
}

.usage-card {
  padding: 26rpx 28rpx 30rpx;
}

.section-title {
  color: #37251a;
  font-size: 31rpx;
  line-height: 1.2;
  font-weight: 900;
}

.usage-list {
  margin-top: 24rpx;
}

.usage-row {
  height: 78rpx;
  display: grid;
  grid-template-columns: 58rpx 166rpx minmax(118rpx, 1fr) 136rpx;
  column-gap: 16rpx;
  align-items: center;
}

.usage-row + .usage-row {
  margin-top: 14rpx;
}

.usage-icon {
  width: 58rpx;
  height: 58rpx;
}

.usage-name {
  color: #252321;
  font-size: 25rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.progress-track {
  position: relative;
  min-width: 0;
  height: 13rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #fbecd8;
}

.progress-fill {
  height: 100%;
  min-width: 6rpx;
  border-radius: 999rpx;
}

.usage-count {
  width: 136rpx;
  color: #23201e;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: right;
  white-space: nowrap;
}

.addon-section {
  padding: 24rpx 24rpx 22rpx;
}

.addon-title {
  margin-bottom: 18rpx;
}

.addon-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.addon-card {
  position: relative;
  min-height: 144rpx;
  padding: 22rpx 18rpx 22rpx;
  border: 1rpx solid rgba(237, 207, 174, 0.76);
  border-radius: 22rpx;
  box-sizing: border-box;
  background: rgba(255, 253, 249, 0.94);
  box-shadow: 0 10rpx 20rpx rgba(173, 121, 67, 0.06);
}

.addon-icon {
  position: absolute;
  left: 18rpx;
  top: 20rpx;
  width: 68rpx;
  height: 68rpx;
}

.addon-copy {
  min-height: 68rpx;
  margin-left: 84rpx;
  padding-right: 4rpx;
}

.addon-name {
  color: #312820;
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 600;
}

.addon-amount {
  margin-top: 9rpx;
  color: #8b8178;
  font-size: 22rpx;
  line-height: 1.2;
}

.addon-price {
  margin-top: 18rpx;
  color: #ff7417;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 900;
}

.addon-buy-button {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  width: 42rpx;
  height: 42rpx;
  border: 5rpx solid #f6d1a3;
  border-radius: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1f1d1a;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 400;
  background: #fffaf2;
}

.addon-buy-button text {
  margin-top: -4rpx;
}

.footer-art-wrap {
  position: relative;
  height: 226rpx;
  margin: 4rpx -28rpx -20rpx;
  overflow: hidden;
}

.footer-art {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 110%;
  height: 320rpx;
  display: block;
  transform: translateX(-50%);
}

.modal-layer {
  position: fixed;
  z-index: 50;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.modal-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.62);
}

.addon-modal {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
  padding: 40rpx 34rpx 26rpx;
  border-radius: 34rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fffdfa 0%, #fff8ef 100%);
  box-shadow: 0 -10rpx 38rpx rgba(43, 30, 20, 0.18);
}

.modal-title {
  color: #3b281c;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 900;
  text-align: center;
}

.modal-close {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111;
  font-size: 48rpx;
  line-height: 1;
  background: #f3e7da;
}

.modal-product {
  margin-top: 34rpx;
  display: flex;
  align-items: center;
}

.modal-product-art,
.modal-product-art image {
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
}

.modal-product-copy {
  min-width: 0;
  margin-left: 12rpx;
}

.modal-product-name {
  color: #3a281d;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 900;
}

.modal-product-amount {
  margin-top: 16rpx;
  color: #8a786a;
  font-size: 26rpx;
  line-height: 1.2;
}

.modal-product-desc {
  margin-top: 16rpx;
  color: #a18d7e;
  font-size: 24rpx;
  line-height: 1.25;
}

.modal-divider {
  height: 1rpx;
  margin: 24rpx 0 26rpx;
  border-top: 2rpx dashed #f0d6bd;
}

.modal-price {
  color: #ff7417;
  font-size: 48rpx;
  line-height: 1;
  font-weight: 900;
  text-align: center;
}

.quantity-stepper {
  width: 326rpx;
  height: 72rpx;
  margin: 26rpx auto 0;
  padding: 0 18rpx;
  border: 1rpx solid #f2d8bf;
  border-radius: 999rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.74);
}

.stepper-button {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #33251d;
  font-size: 40rpx;
  line-height: 1;
  background: #fff0df;
}

.stepper-button.plus {
  color: #f27418;
}

.stepper-value {
  color: #251d18;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 700;
}

.stepper-tip {
  margin-top: 20rpx;
  color: #b09b89;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: center;
}

.pay-panel {
  margin-top: 30rpx;
  padding: 24rpx 20rpx 18rpx;
  border: 1rpx solid #f2d7bc;
  border-radius: 22rpx;
  box-sizing: border-box;
  background: rgba(255, 251, 246, 0.78);
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #2d241e;
  font-size: 28rpx;
  line-height: 1.2;
}

.total-price {
  color: #ff7417;
  font-size: 34rpx;
  font-weight: 900;
}

.pay-button {
  height: 82rpx;
  margin: 34rpx 0 0;
  border: 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 900;
  background: linear-gradient(135deg, #ff9c28 0%, #ff7417 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 117, 24, 0.22);
}

.pay-button::after {
  display: none;
}

.pay-button.disabled {
  color: rgba(255, 255, 255, 0.9);
  background: #cfc7c0;
  box-shadow: none;
}

.modal-agreement {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b6a99d;
  font-size: 23rpx;
  line-height: 1.2;
}

.modal-agreement-check {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  border: 2rpx solid #d8cbc1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 17rpx;
  line-height: 1;
  font-weight: 800;
  background: #fffaf6;
}

.modal-agreement-check.checked {
  border-color: #ff7a1a;
  background: #ff7a1a;
}

.modal-agreement-copy {
  color: #a99d93;
}

.modal-agreement-link {
  margin-left: 5rpx;
  color: #ff7a1a;
}

.modal-agreement-arrow {
  margin-left: 2rpx;
  color: #ff7a1a;
  font-size: 25rpx;
}

.agreement-modal-mask {
  position: fixed;
  z-index: 60;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  padding: 72rpx 38rpx calc(54rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(49, 35, 26, 0.42);
}

.agreement-modal {
  width: 100%;
  max-height: 82vh;
  border-radius: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #fffaf4;
  box-shadow: 0 24rpx 64rpx rgba(84, 50, 26, 0.2);
}

.agreement-modal-header {
  position: relative;
  min-height: 96rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid rgba(151, 111, 78, 0.12);
  box-sizing: border-box;
}

.agreement-modal-title {
  text-align: center;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #4b2c1b;
}

.agreement-modal-close {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #927f72;
  font-size: 42rpx;
  line-height: 1;
  background: rgba(119, 88, 66, 0.08);
}

.agreement-modal-scroll {
  height: 58vh;
  padding: 26rpx 14rpx 18rpx 30rpx;
  box-sizing: border-box;
}

.agreement-modal-content {
  padding-right: 34rpx;
  box-sizing: border-box;
}

.agreement-intro {
  margin-bottom: 18rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #9a8170;
}

.agreement-section {
  margin-top: 30rpx;
}

.agreement-section-title {
  margin-bottom: 14rpx;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #563426;
}

.agreement-item-title {
  margin: 22rpx 0 8rpx;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #3a7b52;
}

.agreement-paragraph {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.72;
  color: #68574c;
  text-align: justify;
}

.agreement-modal-button {
  height: 76rpx;
  margin: 18rpx 30rpx 28rpx;
  border: 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 27rpx;
  line-height: 1;
  font-weight: 800;
  background: linear-gradient(135deg, #ff9f3d 0%, #ff6f17 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 116, 26, 0.18);
}

.agreement-modal-button::after {
  display: none;
}

@media (max-width: 350px) {
  .purchase-mode {
    padding-left: 28rpx;
    padding-right: 28rpx;
  }

  .page-title {
    font-size: 41rpx;
  }

  .plan-card {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .plan-heading,
  .quota-list {
    margin-left: 150rpx;
  }

  .plan-art {
    left: 10rpx;
    top: 70rpx;
    width: 154rpx;
    height: 154rpx;
  }

  .plan-light .plan-art {
    left: 10rpx;
    top: 70rpx;
    width: 154rpx;
    height: 154rpx;
  }

  .plan-name {
    font-size: 29rpx;
  }

  .price-value {
    font-size: 37rpx;
  }

  .purchase-divider {
    margin-left: 12rpx;
    margin-right: 12rpx;
  }

  .purchase-button {
    width: 164rpx;
    min-width: 164rpx;
    max-width: 164rpx;
    flex-basis: 164rpx;
    font-size: 28rpx;
  }

  .member-mode {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .member-card {
    height: 370rpx;
  }

  .member-validity {
    left: 34rpx;
    top: 30rpx;
    max-width: 340rpx;
    font-size: 23rpx;
  }

  .member-name {
    left: 38rpx;
    top: 104rpx;
    font-size: 58rpx;
  }

  .member-title-ornament {
    left: 40rpx;
    top: 176rpx;
    width: 228rpx;
  }

  .member-badge-icon {
    left: 46rpx;
    bottom: 30rpx;
    width: 132rpx;
    height: 124rpx;
  }

  .service-link {
    right: 22rpx;
    top: 28rpx;
    min-width: 158rpx;
    height: 52rpx;
    font-size: 23rpx;
  }

  .usage-card {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .usage-row {
    grid-template-columns: 54rpx 152rpx minmax(84rpx, 1fr) 122rpx;
    column-gap: 10rpx;
  }

  .usage-icon {
    width: 54rpx;
    height: 54rpx;
  }

  .usage-name {
    font-size: 23rpx;
  }

  .usage-count {
    width: 122rpx;
    font-size: 22rpx;
  }

  .addon-grid {
    gap: 14rpx;
  }

  .addon-card {
    padding-left: 14rpx;
    padding-right: 14rpx;
  }

  .addon-copy {
    margin-left: 76rpx;
  }

  .footer-art-wrap {
    margin-left: -22rpx;
    margin-right: -22rpx;
  }

  .agreement-modal-mask {
    padding-left: 28rpx;
    padding-right: 28rpx;
  }

  .agreement-modal-scroll {
    height: 56vh;
  }
}
