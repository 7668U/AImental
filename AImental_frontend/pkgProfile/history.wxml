<view class="history-page">
  <image class="page-bg" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/pkgProfile/images/profile/profile-info-bg.png" mode="aspectFill"></image>

  <view class="custom-nav-wrapper" style="padding-top: {{navTop}}px;">
    <view class="custom-nav" style="height: {{navHeight}}px;">
      <view class="nav-left" bindtap="navigateBack">
        <view class="nav-back-icon"></view>
      </view>
      <view class="nav-center">
        <text class="nav-title">历史记录</text>
      </view>
      <view class="nav-right"></view>
    </view>
  </view>

  <scroll-view class="main-content" scroll-y enhanced show-scrollbar="{{false}}" style="padding-top: {{navHeight + navTop}}px;">
    <view class="history-tabs">
      <view
        class="history-tab {{activeHistoryTab === 'assessment' ? 'active' : ''}}"
        bindtap="switchHistoryTab"
        data-tab="assessment"
      >心理测评历史</view>
      <view
        class="history-tab {{activeHistoryTab === 'mood_analysis' ? 'active' : ''}}"
        bindtap="switchHistoryTab"
        data-tab="mood_analysis"
      >心情分析历史</view>
    </view>

    <block wx:if="{{activeHistoryTab === 'assessment'}}">
      <view wx:if="{{isLoading}}" class="loading-tip">
        <text>正在加载心理测评记录...</text>
      </view>

      <block wx:else>
        <view wx:if="{{assessmentAnalysisHistory.length > 0}}" class="synthesis-history">
          <view class="synthesis-heading">
            <view>
              <text class="synthesis-title">综合分析报告</text>
              <text class="synthesis-subtitle">基于多次测评生成的阶段性回顾</text>
            </view>
            <text class="synthesis-count">{{assessmentAnalysisHistory.length}}份</text>
          </view>
          <view
            class="synthesis-report-row"
            wx:for="{{assessmentAnalysisHistory}}"
            wx:for-index="analysisIndex"
            wx:key="id"
            bindtap="goToAssessmentAnalysisReport"
            data-index="{{analysisIndex}}"
          >
            <view class="synthesis-report-main">
              <text class="synthesis-report-date">{{item.created_at_formatted}}</text>
              <text class="synthesis-report-meta">综合 {{item.history_count}} 次测评</text>
            </view>
            <view class="synthesis-report-arrow"></view>
          </view>
        </view>

        <view wx:if="{{groupedHistory.length === 0 && assessmentAnalysisHistory.length === 0 && !isAssessmentAnalysisLoading}}" class="empty-container">
          <image class="empty-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/icons/icon-no-data.png" mode="aspectFit"></image>
          <text class="empty-text">暂无心理测评记录</text>
          <text class="empty-subtext">去完成一次测评，回顾自己的心灵足迹吧</text>
        </view>

        <view class="history-card" wx:for="{{groupedHistory}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="scale_id">
          <view class="card-header">
            <view class="scale-title">
              <view class="scale-title-dot"></view>
              <view class="scale-name">{{group.scale_name}}</view>
            </view>
            <view class="card-actions">
              <text class="test-count-number">{{group.count}}次</text>


              <view class="expand-trigger" catchtap="toggleExpand" data-index="{{groupIndex}}">
                <view class="header-arrow {{group.is_expanded ? 'expanded' : ''}}"></view>
              </view>
            </view>
          </view>

          <view class="history-list {{group.is_expanded ? 'expanded' : ''}}">
            <view class="history-item" wx:for="{{group.records}}" wx:for-item="record" wx:for-index="recordIndex" wx:key="id">
              <view
                class="history-item-content"
                catchlongpress="handleLongPressDelete"
                bindtap="goToResultDetail"
                data-record="{{record}}"
                data-group-index="{{groupIndex}}"
                data-record-index="{{recordIndex}}">
                <view class="item-left">
                  <view class="item-time">{{record.completed_at_formatted}}</view>
                  <view class="item-score" wx:if="{{record.scale_info.assessment_type === 'scoring'}}">得分：{{record.display_final_score}}</view>
                </view>
                <view class="item-right">
                  <view class="item-result">{{record.display_result_level}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </block>

    <block wx:elif="{{activeHistoryTab === 'mood_analysis'}}">
      <view wx:if="{{isMoodAnalysisLoading}}" class="loading-tip">
        <text>正在加载心情分析历史...</text>
      </view>

      <block wx:else>
        <view wx:if="{{moodAnalysisHistory.length === 0}}" class="empty-container">
          <image class="empty-icon" src="https://assets.feelyourself.cn/miniprogram/assets/releases/20260718-1/images/icons/icon-no-data.png" mode="aspectFit"></image>
          <text class="empty-text">暂无心情分析历史</text>
          <text class="empty-subtext">生成一次心情分析后，报告会保存在这里</text>
        </view>

        <view
          class="mood-report-card"
          wx:for="{{moodAnalysisHistory}}"
          wx:for-index="reportIndex"
          wx:key="id"
          bindtap="goToMoodAnalysisReport"
          data-index="{{reportIndex}}"
        >
          <view class="mood-report-period">
            <text>{{item.start_date}}</text>
            <text class="mood-report-period-separator">至</text>
            <text>{{item.end_date}}</text>
            <view class="mood-report-arrow"></view>
          </view>
        </view>
      </block>
    </block>
  </scroll-view>
</view>
