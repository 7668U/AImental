<view class="page-container">
  <image class="page-bg" src="/images/profile/profile-info-bg.png" mode="aspectFill"></image>

  <view class="custom-nav-wrapper" style="padding-top: {{navTop}}px;">
    <view class="custom-nav" style="height: {{navHeight}}px;">
      <view class="nav-left" bindtap="navigateBack">
        <view class="nav-back-icon"></view>
      </view>
      <view class="nav-center">
        <text class="nav-title">个人信息</text>
      </view>
      <view class="nav-right"></view>
    </view>
  </view>

  <view class="main-content" style="padding-top: {{navHeight + navTop}}px;">
    <view class="profile-hero">
      <view class="avatar-wrapper" bindtap="onChangeAvatar">
        <image class="avatar" src="{{avatar_url || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      </view>
    </view>

    <view class="info-section">
      <view class="info-item">
        <image class="info-icon" src="/images/profile/profile-info-cat.png" mode="aspectFit"></image>
        <text class="label">昵称</text>
        <view class="value-container">
          <input 
            wx:if="{{isEditingNickname}}"
            class="info-input" 
            value="{{nickname}}"
            placeholder="请输入昵称"
            placeholder-class="input-placeholder"
            bindinput="onNickNameInput"
            bindblur="saveNickname"
            focus="{{isEditingNickname}}"
          />
          <text wx:else class="user-info-text" bindtap="editNickname">{{nickname || '未设置'}}</text>
          <text class="value-arrow">›</text>
        </view>
      </view>

      <picker bindchange="bindGenderChange" value="{{genderIndex}}" range="{{genderRange}}">
        <view class="info-item">
          <image class="info-icon" src="/images/profile/profile-info-heart.png" mode="aspectFit"></image>
          <text class="label">性别</text>
          <view class="value-container">
            <text class="user-info-text">{{genderRange[genderIndex]}}</text>
            <text class="value-arrow">›</text>
          </view>
        </view>
      </picker>

      <picker mode="date" value="{{birthday}}" start="1920-01-01" end="{{currentDate}}" bindchange="bindBirthdayChange">
        <view class="info-item">
          <image class="info-icon" src="/images/profile/profile-info-cake.png" mode="aspectFit"></image>
          <text class="label">生日</text>
          <view class="value-container">
            <text class="user-info-text">{{birthday}}</text>
            <text class="value-arrow">›</text>
          </view>
        </view>
      </picker>
    </view>
  </view>
</view>
