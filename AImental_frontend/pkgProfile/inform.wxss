/* pages/inform/inform.wxss */
page {
  background-color: #f7f7f7;
}

/* --- 自定义导航栏样式 (稳定版 Flex 方案) --- */
.custom-nav-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  z-index: 1000;
  box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}

.custom-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.nav-left, .nav-right {
  display: flex;
  align-items: center;
  width: 120rpx; 
}

.nav-left {
  justify-content: flex-start;
  padding-left: 24rpx;
}

.nav-right {
  justify-content: flex-end;
}

.nav-back-icon {
  width: 36rpx;
  height: 36rpx;
}

.nav-center {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.nav-title {
  font-size: 17px;
  font-weight: 600;
  color: #000000;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}
/* --- 导航栏样式结束 --- */


/* 主内容区域 */
.main-content {
  box-sizing: border-box;
  width: 100%;
}

/* 头像区域 */
.avatar-wrapper {
  display: flex;
  justify-content: center;
  padding-top: 60rpx;
  padding-bottom: 40rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: block;
  overflow: hidden;
}

/* 通用信息区块样式 */
.info-section {
  background-color: #ffffff; /* 您可以修改成您喜欢的颜色 */
  border-radius: 16rpx;
  margin: 0 24rpx;
  padding: 0 30rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f0f0; /* 您可以修改成您喜欢的颜色 */
}

.info-section .info-item:last-child {
  border-bottom: none;
}

/* 新增这个样式，让 picker 填满右侧空间 */
.picker-container {
  flex: 1; /* 让 picker 占据所有剩余空间 */
  display: flex; /* 让 picker 内部的 value-container 可以正常布局 */
}

.label {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
}

.value-container {
  display: flex;
  align-items: center;
  color: #888888;
  font-size: 30rpx;
  flex: 1;
  justify-content: flex-end;
  margin-left: 20rpx;
}

.info-input {
  text-align: right;
  width: 100%;
  color: #333;
  display: block;
}

.user-info-text {
  max-width: 450rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #888;
}

.value-container::after {
  content: '';
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #c8c8c8;
  border-right: 2rpx solid #c8c8c8;
  transform: rotate(45deg);
  margin-left: 20rpx;
}