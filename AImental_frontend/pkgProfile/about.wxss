page {
  height: 100%;
  background: #fff7ea;
}

.about-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #3f291f;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.custom-nav-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: rgba(255, 251, 245, 0.78);
  backdrop-filter: blur(8px);
}

.custom-nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
}

.nav-left,
.nav-right {
  width: 124rpx;
  height: 100%;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.nav-left {
  justify-content: flex-start;
  padding-left: 34rpx;
}

.nav-right {
  flex-shrink: 0;
}

.nav-back-icon {
  width: 28rpx;
  height: 28rpx;
  border-left: 7rpx solid #43261b;
  border-bottom: 7rpx solid #43261b;
  border-radius: 3rpx;
  transform: rotate(45deg);
}

.nav-center {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #3f291f;
  letter-spacing: 0;
}

.content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 0 56rpx calc(36rpx + env(safe-area-inset-bottom));
}

.hero-space {
  flex: 1;
  min-height: 760rpx;
}

.bottom-panel {
  width: 100%;
  margin-top: auto;
}

.info-card {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 36rpx rgba(168, 111, 52, 0.09);
  overflow: hidden;
}

.info-item {
  min-height: 124rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.info-item + .info-item {
  border-top: 1rpx solid rgba(226, 192, 154, 0.34);
}

.item-left {
  min-width: 0;
  display: flex;
  align-items: center;
}

.item-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-label {
  color: #3f291f;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 0;
}

.item-value {
  flex-shrink: 0;
  color: #37231b;
  font-size: 28rpx;
  line-height: 1.2;
  text-align: right;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contact-value {
  color: #3f291f;
}

.clickable:active {
  background: rgba(255, 249, 243, 0.8);
}

.footer {
  margin-top: 54rpx;
  text-align: center;
  color: #c4ad95;
  font-size: 22rpx;
  line-height: 1.2;
}

@media (max-height: 700px) {
  .hero-space {
    min-height: 650rpx;
  }

  .content {
    padding-left: 44rpx;
    padding-right: 44rpx;
  }

  .info-item {
    min-height: 110rpx;
    padding-top: 24rpx;
    padding-bottom: 24rpx;
  }
}
