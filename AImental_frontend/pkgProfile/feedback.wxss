page {
  height: 100%;
  background: #fff8ee;
}

.feedback-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #3f291f;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.custom-nav-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: rgba(255, 251, 245, 0.78);
  backdrop-filter: blur(8px);
}

.custom-nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
}

.nav-left,
.nav-right {
  width: 124rpx;
  height: 100%;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.nav-left {
  justify-content: flex-start;
  padding-left: 34rpx;
}

.nav-right {
  flex-shrink: 0;
}

.nav-back-icon {
  width: 28rpx;
  height: 28rpx;
  border-left: 7rpx solid #43261b;
  border-bottom: 7rpx solid #43261b;
  border-radius: 3rpx;
  transform: rotate(45deg);
}

.nav-center {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #3f291f;
  letter-spacing: 0;
}

.main-content {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding-left: 72rpx;
  padding-right: 72rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero-spacer {
  height: 186rpx;
}

.feedback-card {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 36rpx rgba(168, 111, 52, 0.09);
  box-sizing: border-box;
}

.type-card {
  min-height: 172rpx;
  padding: 34rpx 36rpx 32rpx;
}

.content-card {
  margin-top: 20rpx;
  padding: 34rpx 36rpx 30rpx;
}

.section-title {
  color: #3f291f;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 0;
}

.type-selector {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
}

.type-option {
  width: 154rpx;
  height: 60rpx;
  border: 2rpx solid rgba(255, 142, 55, 0.38);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #4d3126;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.56);
  transition: all 0.2s ease;
}

.type-option + .type-option {
  margin-left: 18rpx;
}

.type-option.active {
  border-color: transparent;
  color: #ffffff;
  font-weight: 800;
  background: linear-gradient(180deg, #ffa640 0%, #ff7c2d 100%);
  box-shadow: 0 10rpx 20rpx rgba(255, 126, 45, 0.28);
}

.textarea-wrapper {
  position: relative;
  margin-top: 24rpx;
  min-height: 252rpx;
  padding: 24rpx 24rpx 54rpx;
  border: 2rpx solid rgba(230, 195, 160, 0.48);
  border-radius: 22rpx;
  background: rgba(255, 252, 247, 0.82);
  box-sizing: border-box;
}

.content-textarea {
  width: 100%;
  height: 218rpx;
  color: #4b3329;
  font-size: 25rpx;
  line-height: 1.45;
  letter-spacing: 0;
  box-sizing: border-box;
}

.textarea-placeholder {
  color: #9f9994;
}

.char-counter {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  color: #99918d;
  font-size: 24rpx;
  line-height: 1;
}

.submit-btn {
  width: 318rpx;
  height: 72rpx;
  margin: 32rpx auto 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 72rpx;
  font-weight: 900;
  letter-spacing: 0;
  background: linear-gradient(180deg, #ffa542 0%, #ff7429 100%);
  box-shadow: 0 14rpx 24rpx rgba(255, 118, 40, 0.26);
}

.submit-btn::after {
  border: 0;
}

.submit-btn-hover {
  transform: translateY(2rpx);
  box-shadow: 0 8rpx 16rpx rgba(255, 118, 40, 0.22);
}

@media (max-height: 700px) {
  .hero-spacer {
    height: 150rpx;
  }

  .type-card,
  .content-card {
    padding-left: 32rpx;
    padding-right: 32rpx;
  }

  .textarea-wrapper {
    min-height: 222rpx;
  }

  .content-textarea {
    height: 188rpx;
  }

  .submit-btn {
    margin-top: 24rpx;
  }
}
