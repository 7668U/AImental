/* feedback.wxss (修改后) */
.page-container {
  background-color: #f7f7f7;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

/* 1. 自定义导航栏样式 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background-color: #ffffff;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}

/* 增加：返回按钮样式 */
.nav-back-button {
  position: absolute;
  left: 20rpx; /* 距离左侧的边距 */
  bottom: 14rpx; /* 调整垂直位置，使其在标题区域居中 */
  width: 50rpx;
  height: 50rpx;
  padding: 10rpx; /* 增大点击区域 */
}

.nav-title {
  font-size: 17px;
  font-weight: 600;
  color: #000000;
}

/* 主内容区域 */
.main-content {
  padding: 0 30rpx;
  box-sizing: border-box;
}

/* 通用区块样式 */
.feedback-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 18px;
  color: #333;
  margin-bottom: 24rpx;
}

/* 2. 反馈类型选择 */
.type-selector {
  display: flex;
}

.type-option {
  padding: 16rpx 30rpx;
  border: 1px solid #ddd;
  border-radius: 30rpx;
  margin-right: 20rpx;
  font-size: 15px;
  color: #555;
  transition: all 0.2s ease;
}

.type-option.active {
  background-color: #e2963f; /* 你可以换成你的主题色 */
  color: #ffffff;
  border-color: #e2963f;
}

/* 3. 文本域样式 */
.textarea-wrapper {
  position: relative;
  background-color: #f7f8fa;
  border-radius: 10rpx;
  padding: 20rpx;
}

.content-textarea {
  width: 100%;
  /* 修改：增大文本域初始高度 */
  height: 350rpx; 
  font-size: 17px;
  line-height: 1.5;
  color: #333;
}

.char-counter {
  position: absolute;
  bottom: 10rpx;
  right: 20rpx;
  font-size: 17px;
  color: #999;
}

/* 删除：所有图片上传相关样式已被移除 */

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 90rpx;
  background-color: #e2963f; /* 你可以换成你的主题色 */
  color: white;
  font-size: 16px;
  border-radius: 45rpx;
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn:active {
  background-color: #e2963f;
}