page {
  min-height: 100%;
  background: #fff4dd;
  color: #332018;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft Yahei', sans-serif;
}

.report-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  pointer-events: none;
}

.custom-nav-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 10;
  background: rgba(255, 251, 245, 0.9);
  box-shadow: 0 1rpx 0 rgba(228, 198, 151, 0.2);
  backdrop-filter: blur(8px);
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
}

.nav-left,
.nav-right {
  width: 132rpx;
  height: 100%;
  display: flex;
  align-items: center;
}

.nav-left {
  padding-left: 34rpx;
  box-sizing: border-box;
}

.nav-left:active {
  opacity: 0.68;
}

.nav-back-icon {
  width: 28rpx;
  height: 28rpx;
  border-left: 7rpx solid #75462d;
  border-bottom: 7rpx solid #75462d;
  border-radius: 3rpx;
  transform: rotate(45deg);
}

.nav-center {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: center;
}

.nav-title {
  color: #70472f;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 0;
}

.report-scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding-left: 48rpx;
  padding-right: 48rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.report-content {
  padding-top: 44rpx;
  padding-bottom: 80rpx;
}

.report-intro {
  padding: 8rpx 4rpx 34rpx;
}

.report-title,
.report-meta {
  display: block;
}

.report-title {
  max-width: 560rpx;
  color: #332018;
  font-size: 42rpx;
  line-height: 1.28;
  font-weight: 900;
  letter-spacing: 0;
}

.report-meta {
  margin-top: 16rpx;
  color: #8f6d57;
  font-size: 25rpx;
  line-height: 1.4;
}

.report-section {
  margin-top: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(182, 144, 100, 0.2);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 14rpx 34rpx rgba(152, 111, 50, 0.08);
  box-sizing: border-box;
}

.section-heading {
  display: flex;
  align-items: center;
  color: #332018;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 900;
}

.section-dot {
  width: 18rpx;
  height: 18rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.section-dot-orange {
  background: #df7d1c;
}

.section-dot-blue {
  background: #4f88b8;
}

.section-dot-green {
  background: #5c9271;
}

.section-content {
  display: block;
  margin-top: 22rpx;
  color: #65412d;
  font-size: 28rpx;
  line-height: 1.85;
  letter-spacing: 0;
  white-space: pre-wrap;
  text-align: justify;
}

.report-disclaimer {
  display: block;
  margin: 36rpx auto 0;
  max-width: 560rpx;
  color: #9d8580;
  font-size: 23rpx;
  line-height: 1.55;
  text-align: center;
}

.status-state {
  min-height: 520rpx;
  padding: 180rpx 36rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
}

.status-title,
.status-description {
  display: block;
}

.status-title {
  color: #65412d;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 900;
}

.status-description {
  max-width: 500rpx;
  margin-top: 16rpx;
  color: #8f6d57;
  font-size: 25rpx;
  line-height: 1.6;
}

.retry-button {
  min-width: 220rpx;
  height: 76rpx;
  margin-top: 34rpx;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #df7d1c;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
}

.retry-button::after {
  border: 0;
}
