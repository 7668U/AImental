/* pages/profile/history_analysis.wxss */
page {
  background-color: #f7f8fa;
}
.container {
  padding: 30rpx;
}

.page-header {
  margin-bottom: 40rpx;
}
.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #303133;
}

.analysis-card {
  width: 100%;
  margin-bottom: 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.card-title {
  display: flex;
  align-items: center;
  padding: 30rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #303133;
  border-bottom: 1rpx solid #f2f2f2;
}
.card-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}

.card-content {
  padding: 30rpx;
  font-size: 30rpx;
  color: #606266;
  line-height: 1.8;
  text-align: justify;
  white-space: pre-wrap;
}

.record-list-wrapper {
  padding: 0 30rpx;
}

.history-item { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  padding: 30rpx 0; 
  border-bottom: 1rpx solid #f2f2f2; 
}
.history-item:last-child { 
  border-bottom: none; 
}

.item-left { 
  flex-shrink: 0; 
  margin-right: 20rpx; 
}
.item-time { 
  font-size: 28rpx; 
  color: #606266; 
}
.item-score { 
  font-size: 24rpx; 
  color: #909399; 
  margin-top: 8rpx; 
}

.item-right { 
  flex: 1; 
  min-width: 0; 
  text-align: right; 
}

.item-result {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--theme-color);
  word-break: break-all;
  
  /* --- ✅ 核心修改在这里 --- */
  text-align: right; 
  max-width: 20ch; 
}

.chart-container {
  width: 100%;
  height: 400rpx;
  padding: 20rpx 0;
}
#mychart-line {
  width: 100%;
  height: 100%;
}

.footer {
  padding: 20rpx 0 40rpx 0;
}
.disclaimer {
  text-align: center;
  font-size: 24rpx;
  color: #c0c4cc;
  margin-bottom: 40rpx;
}
.confirm-btn {
  background-color: #F7931E;
  color: #ffffff;
  border-radius: 50rpx;
  font-weight: 500;
}
.confirm-btn:active {
  opacity: 0.9;
}