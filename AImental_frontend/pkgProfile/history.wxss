page {
  min-height: 100%;
  background: #fff4dd;
  color: #65412d;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

.history-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}

.page-bg {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  pointer-events: none;
}

.custom-nav-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: rgba(255, 251, 245, 0.82);
  box-shadow: 0 1rpx 0 rgba(228, 198, 151, 0.2);
  backdrop-filter: blur(8px);
}

.custom-nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
}

.nav-left,
.nav-right {
  width: 132rpx;
  height: 100%;
  display: flex;
  align-items: center;
}

.nav-left {
  justify-content: flex-start;
  padding-left: 34rpx;
  box-sizing: border-box;
}

.nav-left:active {
  opacity: 0.68;
}

.nav-back-icon {
  width: 28rpx;
  height: 28rpx;
  border-left: 7rpx solid #75462d;
  border-bottom: 7rpx solid #75462d;
  border-radius: 3rpx;
  transform: rotate(45deg);
}

.nav-center {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.nav-title {
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #70472f;
  letter-spacing: 0;
}

.main-content {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding-left: 48rpx;
  padding-right: 48rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.history-card {
  position: relative;
  margin-top: 110rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 18rpx 42rpx rgba(152, 111, 50, 0.1);
  box-sizing: border-box;
  overflow: hidden;
}

.history-card + .history-card {
  margin-top: 28rpx;
}

.card-header {
  min-height: 112rpx;
  padding: 30rpx 28rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.scale-title {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.scale-title-dot {
  width: 20rpx;
  height: 20rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #f28b2e;
  box-shadow: 0 2rpx 0 rgba(132, 75, 34, 0.18);
  flex-shrink: 0;
}

.scale-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #332018;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 0;
}

.card-actions {
  margin-left: 22rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.expand-trigger {
  width: 48rpx;
  height: 48rpx;
  margin-left: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.expand-trigger:active {
  opacity: 0.72;
}

.test-count-number {
  color: #332018;
  font-size: 30rpx;
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: 0;
  flex-shrink: 0;
}

.header-arrow {
  width: 17rpx;
  height: 17rpx;
  border-left: 6rpx solid #332018;
  border-bottom: 6rpx solid #332018;
  border-radius: 3rpx;
  transform: translateY(4rpx) rotate(135deg);
  transition: transform 0.22s ease;
}

.header-arrow.expanded {
  transform: translateY(-3rpx) rotate(-45deg);
}

.analysis-btn-container {
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
}

.analysis-text,
.analysis-disabled-tip {
  color: #ac9990;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 500;
  white-space: nowrap;
  letter-spacing: 0;
}

.analysis-text {
  color: #df7d1c;
  font-weight: 800;
}

.history-list {
  margin: 0;
  border-top: 1rpx solid transparent;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.28s ease-in-out;
  transform: translateZ(0);
}

.history-list::before {
  content: '';
  display: block;
  margin: 0 28rpx;
  height: 1rpx;
  background: rgba(182, 144, 100, 0.24);
}

.history-list.expanded {
  max-height: 1600rpx;
  transition: max-height 0.34s ease-in;
}

.history-item {
  position: relative;
  overflow: hidden;
  transform: translateZ(0);
  background: rgba(255, 253, 248, 0.58);
}

.history-item + .history-item {
  border-top: 1rpx solid rgba(182, 144, 100, 0.16);
}

.history-item-content {
  position: relative;
  z-index: 2;
  width: 100%;
  min-height: 126rpx;
  padding: 28rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 253, 248, 0.58);
  box-sizing: border-box;
  transition: transform 0.2s ease-out;
}

.history-item-content:active {
  opacity: 0.76;
}

.item-left {
  flex: 1;
  min-width: 0;
  margin-right: 22rpx;
}

.item-time {
  color: #332018;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 0;
}

.item-score {
  margin-top: 14rpx;
  color: #9d8580;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 500;
  letter-spacing: 0;
}

.item-right {
  max-width: 300rpx;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
}

.item-result {
  min-width: 0;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #332018;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 900;
  text-align: right;
  letter-spacing: 0;
}

.delete-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 160rpx;
  z-index: 1;
  background: #ffe4df;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-text {
  color: #cf4f43;
  font-size: 28rpx;
  font-weight: 800;
}

.loading-tip,
.empty-container {
  position: relative;
  z-index: 1;
  padding-top: 220rpx;
  text-align: center;
  color: #9d8580;
}

.empty-icon {
  width: 190rpx;
  height: 190rpx;
  margin-bottom: 22rpx;
}

.empty-text {
  display: block;
  color: #65412d;
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.empty-subtext {
  color: #9d8580;
  font-size: 26rpx;
  line-height: 1.35;
}

@media (max-height: 700px) {
  .history-card {
    margin-top: 70rpx;
  }

  .card-header {
    min-height: 100rpx;
    padding-top: 26rpx;
    padding-bottom: 22rpx;
  }

  .history-item-content {
    min-height: 112rpx;
  }
}
