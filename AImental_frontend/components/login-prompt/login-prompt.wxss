/* components/login-prompt/login-prompt.wxss */
/* (最终版本 - 整体上移) */

.login-prompt-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  /*
   * 核心修改在这里
   * padding 的四个值分别代表: 上 右 下 左。
   * 我们主要增大了第三个值 (下边距)，把内容从底部顶上去。
   * 您可以调整 150rpx 这个值，值越大，整体上移的距离就越多。
   */
  padding: 40rpx 40rpx 150rpx;

  box-sizing: border-box;
}

.login-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 30rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: #888888;
  margin-bottom: 80rpx;
}

.login-btn {
  background-color: #F2994A;
  color: #ffffff;
  border-radius: 50rpx;
  padding: 0 60rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  white-space: nowrap;
  margin: 0;
  border: none;
  line-height: normal;
}

.login-btn::after {
  border: none;
}