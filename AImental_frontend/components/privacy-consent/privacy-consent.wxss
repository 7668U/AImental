.privacy-mask {
  position: fixed;
  z-index: 9999;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 72rpx 54rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(62, 48, 40, 0.5);
}

.privacy-dialog {
  position: relative;
  width: 100%;
  max-height: calc(100vh - 116rpx - env(safe-area-inset-bottom));
  padding: 126rpx 42rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  border-radius: 34rpx;
  box-sizing: border-box;
  background: #fffdf9;
  box-shadow: 0 34rpx 90rpx rgba(55, 38, 28, 0.24);
}

.privacy-close {
  position: absolute;
  z-index: 2;
  top: 24rpx;
  right: 26rpx;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #907e72;
  background: #f7f1eb;
  font-size: 36rpx;
  line-height: 1;
}

.privacy-illustration {
  position: absolute;
  top: -48rpx;
  left: 50%;
  width: 190rpx;
  height: 190rpx;
  transform: translateX(-50%);
}

.privacy-eyebrow {
  color: #c27a3e;
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
  letter-spacing: 1rpx;
}

.privacy-title {
  margin-top: 12rpx;
  color: #3f342d;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
}

.privacy-lead {
  margin: 14rpx auto 0;
  max-width: 500rpx;
  color: #786a61;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.privacy-promises {
  margin-top: 22rpx;
  padding: 4rpx 20rpx;
  border: 1rpx solid #f0e6dc;
  border-radius: 20rpx;
  background: #fffaf5;
}

.privacy-promise {
  min-height: 82rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eee3d9;
}

.privacy-promise:last-child {
  border-bottom: 0;
}

.promise-icon-shell {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff3e4;
  box-shadow: inset 0 0 0 1rpx rgba(255, 170, 82, 0.24);
}

.promise-icon-image {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.promise-copy {
  flex: 1;
  min-width: 0;
}

.promise-title {
  color: #41362f;
  font-size: 24rpx;
  line-height: 1.25;
  font-weight: 800;
}

.promise-desc {
  margin-top: 6rpx;
  color: #8c8078;
  font-size: 19rpx;
  line-height: 1.35;
}

.privacy-agreement {
  margin-top: 22rpx;
  display: flex;
  align-items: flex-start;
  color: #756960;
  font-size: 20rpx;
  line-height: 1.55;
}

.privacy-check {
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
  margin: 1rpx 13rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #d7c9be;
  border-radius: 9rpx;
  box-sizing: border-box;
  color: #fff;
  background: #fff;
  font-size: 20rpx;
  font-weight: 900;
}

.privacy-check.is-checked {
  border-color: #ff8d45;
  background: #ff8d45;
}

.privacy-agreement-copy {
  flex: 1;
}

.privacy-link {
  color: #d56e28;
  font-weight: 800;
}

.privacy-primary {
  width: 100%;
  height: 86rpx;
  margin: 22rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 28rpx;
  box-sizing: border-box;
  color: rgba(255, 255, 255, 0.78);
  background: #d8cec7;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 800;
  text-align: center;
}

.privacy-primary::after {
  border: 0;
}

.privacy-primary.is-enabled {
  color: #fff;
  background: linear-gradient(135deg, #ffad58, #ff7c2c);
  box-shadow: 0 17rpx 32rpx rgba(238, 119, 40, 0.28);
}

.privacy-secondary {
  padding-top: 20rpx;
  color: #9b8e85;
  font-size: 22rpx;
  text-align: center;
}

.privacy-safe-note {
  margin-top: 20rpx;
  color: #ae9f94;
  font-size: 17rpx;
  line-height: 1.5;
  text-align: center;
}

.privacy-detail-layer {
  position: absolute;
  z-index: 3;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(48, 37, 31, 0.38);
}

.privacy-detail {
  width: 100%;
  height: 88vh;
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: 30rpx 30rpx 0 0;
  overflow: hidden;
  box-sizing: border-box;
  background: #fffdf9;
  box-shadow: 0 -20rpx 60rpx rgba(55, 38, 28, 0.2);
}

.detail-header {
  height: 112rpx;
  padding: 20rpx 28rpx 0;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-bottom: 1rpx solid #eee3d9;
}

.detail-back,
.detail-placeholder {
  width: 64rpx;
  flex: 0 0 auto;
}

.detail-back {
  color: #6f6057;
  font-size: 58rpx;
  line-height: 1;
}

.detail-title {
  flex: 1;
  color: #3f342d;
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
}

.detail-scroll {
  height: calc(88vh - 222rpx - env(safe-area-inset-bottom));
  padding: 32rpx 42rpx 50rpx;
  box-sizing: border-box;
}

.detail-meta {
  color: #aa7b56;
  font-size: 20rpx;
}

.detail-summary {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  color: #665950;
  background: #fff4e6;
  font-size: 23rpx;
  line-height: 1.65;
  display: flex;
  align-items: flex-start;
}

.detail-summary-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 18rpx;
  flex: 0 0 auto;
}

.detail-summary-copy {
  min-width: 0;
  flex: 1;
}

.detail-section {
  margin-top: 34rpx;
}

.detail-section-title {
  color: #40352e;
  font-size: 27rpx;
  font-weight: 800;
}

.detail-section-content {
  margin-top: 12rpx;
  color: #74675e;
  font-size: 23rpx;
  line-height: 1.75;
}

.detail-notice {
  margin-top: 36rpx;
  padding: 22rpx 24rpx;
  border-left: 6rpx solid #9bc8b5;
  color: #6d625a;
  background: #eef6f1;
  font-size: 22rpx;
  line-height: 1.65;
}

.detail-footer {
  height: 110rpx;
  padding: 14rpx 42rpx 18rpx;
  box-sizing: border-box;
  border-top: 1rpx solid #eee3d9;
  background: #fffdf9;
}

.detail-confirm {
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #ffad58, #ff7c2c);
  font-size: 27rpx;
  font-weight: 800;
}

@media (max-height: 700px) {
  .privacy-mask {
    align-items: flex-start;
    padding-top: 92rpx;
  }

  .privacy-dialog {
    max-height: calc(100vh - 116rpx);
    padding-top: 112rpx;
    transform: scale(0.92);
    transform-origin: top center;
  }

  .privacy-illustration {
    top: -42rpx;
    width: 170rpx;
    height: 170rpx;
  }
}
