# fhl Images API imagegen settings.
# Copy this file to .env and fill in real values locally.
OPENAI_API_KEY=
OPENAI_BASE_URL=
IMAGE_STUDIO_IMAGE_MODEL=
VITE_IMAGE_STUDIO_BASE_URL=
VITE_IMAGE_STUDIO_IMAGE_MODEL=

# Tencent Cloud COS/CDN asset upload settings.
# Keep real credentials only in local .env, never commit them.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-beijing
COS_BUCKET=feelyourself-assets-1369598469
COS_UPLOAD_ROOT=output/cos-assets
COS_CDN_BASE_URL=https://assets.feelyourself.cn
COS_ASSET_PREFIX=miniprogram/assets/v1

# Backend privacy and encryption settings.
# Generate every key independently. Values shown here are placeholders.
SECRET_KEY=
DATA_ENCRYPTION_KEYS={"v1":""}
ACTIVE_DATA_ENCRYPTION_KEY_VERSION=v1
DATA_BLIND_INDEX_KEY=
PRIVATE_MEDIA_URL_SIGNING_KEY=
PRIVATE_MEDIA_URL_TTL_SECONDS=900
PRIVACY_POLICY_VERSION=2026-07-11
PRIVACY_POLICY_EFFECTIVE_DATE=2026-07-11
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT=

# Development-only VIP payment simulator. Never enable in production.
ENABLE_VIP_MOCK_PAYMENT=false
VIP_COMMUNITY_DAILY_SAFETY_LIMIT=300
VIP_FEATURE_RATE_LIMITS=tree_hole=20/60,community=30/60,mood_analysis=8/60,assessment_analysis=5/60

# Backend LLM security settings. Keep the API key only on the server.
HEPAI_API_KEY=
HEPAI_BASE_URL=https://aiapi.ihep.ac.cn/apiv2
HEPAI_MODEL=hepai/deepseek-v4-pro
LLM_ALLOWED_HOSTS=aiapi.ihep.ac.cn
LLM_ALLOWED_MODELS=hepai/deepseek-v4-pro
LLM_DEFAULT_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_MAX_MESSAGES=120
LLM_MAX_MESSAGE_CHARS=100000
LLM_MAX_TOTAL_MESSAGE_CHARS=250000
LLM_DEFAULT_MAX_TOKENS=1500
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_CONCURRENT_REQUESTS=8
LLM_QUEUE_TIMEOUT_SECONDS=5
LLM_ALLOW_STREAMING=false
