{
  "scale_info": {
    "name": "人性的哲学量表",
    "short_name": "PHN-V1",
    "description": "人性的哲学量表（Philosophies of Human Nature, PHN）由L.S. Wrightsman编制，用于测量个体关于人性的基本信念。它通过一系列成对的核心维度，评估人们在多大程度上认为人性是可信的、理性的、利他的和独立的。",
    "instructions": "这份问卷旨在了解您对人性的看法。对于下面的每一个陈述，请表明您同意或不同意的程度。这里没有正确或错误的答案，重要的是您的真实看法。请根据您的第一印象作答。",
    "category": "专业测试",
    "assessment_type": "multi_subscale_scoring"
  },
  "scoring_rules": {
    "dimensions": [
      "Trustworthiness",
      "Strength of will",
      "Altruism",
      "Independence",
      "Complexity",
      "Variability"
    ],
    "subscale_definitions": {
      "Trustworthiness": {
        "interpretation": "该维度测量您认为人性在多大程度上是可信、诚实和善良的。",
        "high_score_meaning": "高分（正分）表明您倾向于相信他人，认为人性本善，大多数人是诚实可靠的。",
        "low_score_meaning": "低分（负分）表明您对人性持怀疑态度，认为人们本质上是不可信和虚伪的（犬儒主义）。"
      },
      "Strength of will": {
        "interpretation": "该维度测量您认为人们在多大程度上能够控制自己的命运和行为。",
        "high_score_meaning": "高分（正分）表明您相信人有很强的意志力和自控力，能够主宰自己的命运。",
        "low_score_meaning": "低分（负分）表明您认为人的行为和命运更多地受到外部环境和运气的决定。"
      },
      "Altruism": {
        "interpretation": "该维度测量您认为人们的行为在多大程度上是出于无私的、关心他人的动机。",
        "high_score_meaning": "高分（正分）表明您相信人性是利他的，人们乐于助人，并且是出于真诚的同情心。",
        "low_score_meaning": "低分（负分）表明您认为人们的行为主要是自私的，帮助他人也是为了有所回报。"
      },
      "Independence": {
        "interpretation": "该维度测量您认为人们在多大程度上能够独立思考和行动，而不受社会压力的影响。",
        "high_score_meaning": "高分（正分）表明您相信人们能够坚持自己的信念，抵抗同伴压力，具有独立性。",
        "low_score_meaning": "低分（负分）表明您认为大多数人都是遵从者，容易受到他人和群体的影响。"
      },
      "Complexity": {
        "interpretation": "该维度测量您认为人性是复杂的、难以理解的，还是简单的、可预测的。",
        "high_score_meaning": "高分（正分）表明您认为人性非常复杂，充满了隐藏的动机，难以凭第一印象判断。",
        "low_score_meaning": "低分（负分）表明您认为人性相对简单，人们的行为容易理解和预测。"
      },
      "Variability": {
        "interpretation": "该维度测量您认为人与人之间的差异程度。",
        "high_score_meaning": "高分（正分）表明您认为人与人之间存在巨大的个体差异，每个人都是独一无二的。",
        "low_score_meaning": "低分（负分）表明您认为人们在很多方面都是相似的，个体差异不大。"
      }
    }
  },
  "questions": [
    { "order": 1, "text": "大多数学生即使在没把握通过考试的情况下也会诚实地应考。", "subscale": "Trustworthiness", "scoring": "positive" },
    { "order": 2, "text": "如果让学生对自己的学习负全责，他们就会无所作为。", "subscale": "Strength of will", "scoring": "negative" },
    { "order": 3, "text": "大多数人乐于助人。", "subscale": "Altruism", "scoring": "positive" },
    { "order": 4, "text": "大多数人都能在同伴压力下坚持自己的信念。", "subscale": "Independence", "scoring": "positive" },
    { "order": 5, "text": "我发现很难凭第一印象来判断一个人。", "subscale": "Complexity", "scoring": "positive" },
    { "order": 6, "text": "我和其他人的共同点不多。", "subscale": "Variability", "scoring": "positive" },
    { "order": 7, "text": "大多数人基本上是诚实的。", "subscale": "Trustworthiness", "scoring": "positive" },
    { "order": 8, "text": "大多数人都难以抵挡诱惑。", "subscale": "Strength of will", "scoring": "negative" },
    { "order": 9, "text": "大多数人更关心自己的利益，而不是他人的困难。", "subscale": "Altruism", "scoring": "negative" },
    { "order": 10, "text": "如果一个人所属的团体决定做某件事，那么这个人很少会公开表示异议。", "subscale": "Independence", "scoring": "negative" },
    { "order": 11, "text": "通常，一个人的行为方式越了解，就越能预测他将来的行为。", "subscale": "Complexity", "scoring": "negative" },
    { "order": 12, "text": "不同的人之间存在着根本的差异。", "subscale": "Variability", "scoring": "positive" },
    { "order": 13, "text": "大多数人都会信守诺言。", "subscale": "Trustworthiness", "scoring": "positive" },
    { "order": 14, "text": "大多数人都有很强的意志力。", "subscale": "Strength of will", "scoring": "positive" },
    { "order": 15, "text": "大多数人会为了自己的利益而说谎。", "subscale": "Altruism", "scoring": "negative" },
    { "order": 16, "text": "很容易让人们做他们不想做的事情。", "subscale": "Independence", "scoring": "negative" },
    { "order": 17, "text": "通常可以根据人们的外表来判断他们的性格。", "subscale": "Complexity", "scoring": "negative" },
    { "order": 18, "text": "人们在很多方面都是相似的。", "subscale": "Variability", "scoring": "negative" },
    { "order": 19, "text": "大多数父母都值得他们孩子去信任。", "subscale": "Trustworthiness", "scoring": "positive" },
    { "order": 20, "text": "大多数人即使下定决心，也很难坚持下去。", "subscale": "Strength of will", "scoring": "negative" },
    { "order": 21, "text": "大多数人只有在对自己有好处的情况下才会帮助别人。", "subscale": "Altruism", "scoring": "negative" },
    { "order": 22, "text": "在群体中，很少有人能不受群体倾向的影响。", "subscale": "Independence", "scoring": "negative" },
    { "order": 23, "text": "我发现，一个人对另一个人的看法通常是准确的。", "subscale": "Complexity", "scoring": "negative" },
    { "order": 24, "text": "人们的行为方式存在巨大差异。", "subscale": "Variability", "scoring": "positive" },
    { "order": 25, "text": "大多数人都是善良的。", "subscale": "Trustworthiness", "scoring": "positive" },
    { "order": 26, "text": "一般人都能过上自己选择的生活。", "subscale": "Strength of will", "scoring": "positive" },
    { "order": 27, "text": "如果要描述一个人，我会先用“乐于助人”这个词。", "subscale": "Altruism", "scoring": "positive" },
    { "order": 28, "text": "如果一个人在青少年时期被朋友误导，那么他自己也有责任。", "subscale": "Independence", "scoring": "positive" },
    { "order": 29, "text": "人们的内心世界比外在行为要复杂得多。", "subscale": "Complexity", "scoring": "positive" },
    { "order": 30, "text": "人们在个性上差异很大。", "subscale": "Variability", "scoring": "positive" },
    { "order": 31, "text": "大多数人都是值得信任的。", "subscale": "Trustworthiness", "scoring": "positive" },
    { "order": 32, "text": "如果人们真的想改变，他们就能改变。", "subscale": "Strength of will", "scoring": "positive" },
    { "order": 33, "text": "人们帮助别人主要是为了回报。", "subscale": "Altruism", "scoring": "negative" },
    { "order": 34, "text": "人们的多数行为都是为了迎合他人。", "subscale": "Independence", "scoring": "negative" },
    { "order": 35, "text": "很难理解人们为什么会做某些事。", "subscale": "Complexity", "scoring": "positive" },
    { "order": 36, "text": "要理解他人的感受并不难。", "subscale": "Variability", "scoring": "negative" },
    { "order": 37, "text": "大多数人不会故意对别人说谎。", "subscale": "Trustworthiness", "scoring": "positive" },
    { "order": 38, "text": "运气比努力更能决定一个人的未来。", "subscale": "Strength of will", "scoring": "negative" },
    { "order": 39, "text": "大多数人看到别人陷入困境时都会伸出援手。", "subscale": "Altruism", "scoring": "positive" },
    { "order": 40, "text": "大多数人都有自己的主见。", "subscale": "Independence", "scoring": "positive" },
    { "order": 41, "text": "人们可能看起来很复杂，但其实他们都很简单。", "subscale": "Complexity", "scoring": "negative" },
    { "order": 42, "text": "如果你了解一个人，就能预测他会喜欢什么样的人。", "subscale": "Variability", "scoring": "negative" },
    { "order": 43, "text": "如果你不提防着点，人们就会占你的便宜。", "subscale": "Trustworthiness", "scoring": "negative" },
    { "order": 44, "text": "人们声称能掌控自己的命运，这只是自欺欺人。", "subscale": "Strength of will", "scoring": "negative" },
    { "order": 45, "text": "很少有人会无私地帮助别人。", "subscale": "Altruism", "scoring": "negative" },
    { "order": 46, "text": "人们的信念很大程度上取决于他们朋友的信念。", "subscale": "Independence", "scoring": "negative" },
    { "order": 47, "text": "我常常觉得无法真正理解身边的人。", "subscale": "Complexity", "scoring": "positive" },
    { "order": 48, "text": "预测人们的行为比预测天气更容易。", "subscale": "Variability", "scoring": "negative" },
    { "order": 49, "text": "相信别人会给你带来麻烦。", "subscale": "Trustworthiness", "scoring": "negative" },
    { "order": 50, "text": "人们很难掌控自己的命运。", "subscale": "Strength of will", "scoring": "negative" },
    { "order": 51, "text": "“己所不欲，勿施于人”是大多数人都遵循的准则。", "subscale": "Altruism", "scoring": "positive" },
    { "order": 52, "text": "人们的观点很容易被有说服力的论点所改变。", "subscale": "Independence", "scoring": "negative" },
    { "order": 53, "text": "人们的行为背后总有隐藏的原因。", "subscale": "Complexity", "scoring": "positive" },
    { "order": 54, "text": "一旦你了解了一个人的基本性格，就很少会对他感到惊讶。", "subscale": "Variability", "scoring": "negative" },
    { "order": 55, "text": "大多数人都是虚伪的。", "subscale": "Trustworthiness", "scoring": "negative" },
    { "order": 56, "text": "大多数人都是自己命运的主人。", "subscale": "Strength of will", "scoring": "positive" },
    { "order": 57, "text": "大多数人不会为了帮助别人而牺牲自己的便利。", "subscale": "Altruism", "scoring": "negative" },
    { "order": 58, "text": "一个好的领导者能让人们做他们不想做的事。", "subscale": "Independence", "scoring": "negative" },
    { "order": 59, "text": "人们的行为方式很简单，容易理解。", "subscale": "Complexity", "scoring": "negative" },
    { "order": 60, "text": "如果你能真正理解一个人，就不可能同时理解另一个人。", "subscale": "Variability", "scoring": "positive" },
    { "order": 61, "text": "大多数人都是善意的。", "subscale": "Trustworthiness", "scoring": "negative" },
    { "order": 62, "text": "一个人的生活很大程度上是由他所处的环境决定的。", "subscale": "Strength of will", "scoring": "negative" },
    { "order": 63, "text": "大多数人主要是出于善意行事。", "subscale": "Altruism", "scoring": "positive" },
    { "order": 64, "text": "要想“与众不同”是很难的。", "subscale": "Independence", "scoring": "negative" },
    { "order": 65, "text": "我很难描述一个人的性格。", "subscale": "Complexity", "scoring": "positive" },
    { "order": 66, "text": "人与人之间并没有太大的不同。", "subscale": "Variability", "scoring": "negative" },
    { "order": 67, "text": "大多数人都会为了获得优势而欺骗。", "subscale": "Trustworthiness", "scoring": "negative" },
    { "order": 68, "text": "人们可以克服任何障碍，只要他们有足够的意志力。", "subscale": "Strength of will", "scoring": "positive" },
    { "order": 69, "text": "人们的同情心是他们行为的主要驱动力。", "subscale": "Altruism", "scoring": "positive" },
    { "order": 70, "text": "如果一个人与他人的意见不同，他通常会保留自己的看法。", "subscale": "Independence", "scoring": "positive" },
    { "order": 71, "text": "我发现人们的行为是可以预测的。", "subscale": "Complexity", "scoring": "negative" },
    { "order": 72, "text": "一个人的朋友能很好地反映出他的性格。", "subscale": "Variability", "scoring": "negative" },
    { "order": 73, "text": "人们通常不会如实相告。", "subscale": "Trustworthiness", "scoring": "negative" },
    { "order": 74, "text": "人们无法选择自己的生活道路。", "subscale": "Strength of will", "scoring": "negative" },
    { "order": 75, "text": "如果你想让别人帮你做事，就得给他们一些回报。", "subscale": "Altruism", "scoring": "negative" },
    { "order": 76, "text": "人们很难在群体中坚持自己的观点。", "subscale": "Independence", "scoring": "negative" },
    { "order": 77, "text": "有时很难理解为什么好朋友会以某种方式行事。", "subscale": "Complexity", "scoring": "positive" },
    { "order": 78, "text": "要理解别人的想法是很容易的。", "subscale": "Variability", "scoring": "negative" },
    { "order": 79, "text": "最好相信任何人，直到他证明自己不可信。", "subscale": "Trustworthiness", "scoring": "negative" },
    { "order": 80, "text": "人们可以决定自己的命运。", "subscale": "Strength of will", "scoring": "positive" },
    { "order": 81, "text": "人们的善行很少是出于纯粹的善意。", "subscale": "Altruism", "scoring": "negative" },
    { "order": 82, "text": "大多数人都是遵从者。", "subscale": "Independence", "scoring": "negative" },
    { "order": 83, "text": "我很容易就能总结出一个人的性格。", "subscale": "Complexity", "scoring": "negative" },
    { "order": 84, "text": "每个人的行为方式都有很大不同。", "subscale": "Variability", "scoring": "positive" }
  ],
